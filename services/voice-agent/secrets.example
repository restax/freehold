# Secrets injected into the LiveKit Cloud Agent as environment variables.
#
#   cp secrets.example secrets.env   (secrets.env is gitignored)
#   fill in the real values from the repo-root .env
#   lk agent deploy --secrets-file secrets.env
#
# LIVEKIT_URL / API_KEY / API_SECRET are supplied by LiveKit Cloud
# automatically — do not set them here.

# Where the agent reads workspace data. MUST be the public app URL: the agent
# runs in LiveKit's infrastructure, so localhost would reach nothing.
FREEHOLD_APP_URL=https://freeholdtc.dev

# The only vendor key still needed directly: STT/TTS route through LiveKit's
# own hosted inference (see README → Speech-to-text & text-to-speech), so
# Deepgram/ElevenLabs keys are NOT required here.
ANTHROPIC_API_KEY=

# Optional overrides.
ELEVENLABS_VOICE_ID=OYTbf65OHHFELVut7v2H
FREEHOLD_VOICE_MODEL=claude-sonnet-4-6

# Homepage "call the developer" feature (see README → Calling a real phone).
# Leave both blank to keep the feature off — the tool then always declines.
# FOUNDER_CALL_DESTINATION is a bare SIP username (e.g. "yourname"), NOT a
# full "sip:user@host" URI and not a phone number — LiveKit's own hosted
# numbers are inbound-only, and the API rejects a full URI here; the host
# lives on the outbound trunk's --address instead.
FOUNDER_CALL_DESTINATION=
FOUNDER_SIP_TRUNK_ID=
