// Freehold schema — Stage 00.
//
// Auth tables (user, session, account, verification, organization, member,
// invitation) follow Better Auth's expected shape (organization plugin enabled).
// Domain convention: an Organization IS a Freehold tenant — the paying customer
// (broker, title company, or solo TC business). Domain tables carry tenant_id
// and are protected by Postgres row-level security (see the init migration and
// `withTenant` in src/tenant.ts).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Better Auth core ---

model User {
  id                     String                @id
  name                   String
  email                  String                @unique
  emailVerified          Boolean               @default(false)
  /// Unique login handle that doubles as the user's subdomain, so it lives in
  /// the same *.freeholdtc.dev namespace as workspace slugs and reserved
  /// subdomains. Lowercase, URL-safe. displayUsername keeps the as-typed form.
  username               String?               @unique
  displayUsername        String?
  /// The coordinator's own contact number, shown on the signature card of
  /// every email they send and available to templates as {{tc_phone}}. On the
  /// user rather than the membership: it's the person's number, and a
  /// coordinator working two workspaces answers the same phone in both.
  phone                  String?
  image                  String?
  /// Profile photo bytes, stored inline (photos are small and user-global, so
  /// they never route to a tenant's bucket). Served by /api/users/[id]/avatar;
  /// `image` holds that path so anything reading the auth user renders it.
  avatarData             Bytes?                @map("avatar_data")
  avatarType             String?               @map("avatar_type")
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  twoFactorEnabled       Boolean?              @map("two_factor_enabled")
  twoFactors             TwoFactor[]
  sessions               Session[]
  accounts               Account[]
  members                Member[]
  invitations            Invitation[]
  ownedContacts          ContactOwner[]        @relation("ContactOwner")
  assignedTasks          Task[]                @relation("TaskAssignee")
  licenses               UserLicense[]
  transactionAssignments TransactionAssignee[]
  paymentRequests        PaymentRequest[]
  guestEngagements       Engagement[]
  supportTickets         SupportTicket[]
  vendorUsers            VendorUser[]
  clientReviews          ClientReview[]
  nylasGrant             NylasGrant?

  @@map("user")
}

enum VendorCategory {
  TITLE
  INSPECTION
  PHOTOGRAPHY
  SIGNAGE
  LEGAL
  OTHER
}

/// A service business on FreeholdVendors — a title company, inspector,
/// photographer, sign installer, or law office. A vendor is its own root
/// entity, NOT a tenant: it has no Organization, no Member rows, and never
/// touches a workspace's seat or plan limits. It connects to many TC
/// workspaces (see VendorConnection) and receives orders from all of them.
///
/// Deliberately no row-level security: like Organization, a vendor is a top
/// of the ownership tree, scoped by the app through VendorUser membership, not
/// by app.tenant_id (a vendor has no tenant).
model Vendor {
  id                 String             @id @default(uuid())
  name               String
  category           VendorCategory     @default(OTHER)
  email              String             @unique
  phone              String?
  /// Free-text service area ("Chicago metro", "Cook & DuPage counties").
  serviceArea        String?            @map("service_area")
  blurb              String?
  /// Logo as a data URL, same convention as Organization.logo.
  logo               String?
  /// Opt-in to the TC-side vendor directory. Off by default.
  listed             Boolean            @default(false)
  /// URL handle for the public vendor page (/v/<slug>). Null on rows created
  /// before public pages existed; backfilled on the next profile save.
  slug               String?            @unique
  /// Tiered contact/bio fields. Visibility is enforced where each is rendered:
  /// public.* shows on the public vendor page, ads, and directory; client.*
  /// shows to a coordinator's client on an order with this vendor; private.*
  /// is the vendor's own, never displayed. `blurb`/`phone`/`email` above stay
  /// as the pre-tier fields (account email, directory blurb).
  publicBio          String?            @map("public_bio")
  publicPhone        String?            @map("public_phone")
  publicEmail        String?            @map("public_email")
  clientBio          String?            @map("client_bio")
  clientPhone        String?            @map("client_phone")
  clientServiceNotes String?            @map("client_service_notes")
  privateEmail       String?            @map("private_email")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  users              VendorUser[]
  connections        VendorConnection[]
  orders             VendorOrder[]
  ads                VendorAd[]
  coverage           VendorCoverage[]
  documents          VendorDocument[]

  @@index([category])
  @@map("vendor")
}

/// Where a vendor works, one row per area. Kept as rows (not a text field) so
/// "who covers Illinois / Cook County / 60601" is a real query — needed for the
/// coordinator directory filter and the regional ad targeting. No RLS: a
/// vendor-owned root table like vendor itself.
model VendorCoverage {
  id        String   @id @default(uuid())
  vendorId  String   @map("vendor_id")
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  /// "STATE" | "COUNTY" | "ZIP".
  kind      String
  /// The area: a USPS state code ("IL"), a "County, ST" string, or a ZIP.
  value     String
  createdAt DateTime @default(now())

  @@index([vendorId])
  @@index([kind, value])
  @@map("vendor_coverage")
}

/// A document a vendor keeps on their profile (insurance, E&O, W9, resume) to
/// share when an order is placed. Envelope-encrypted through the same putObject
/// path as transaction documents. No RLS — vendor-owned root table.
model VendorDocument {
  id              String   @id @default(uuid())
  vendorId        String   @map("vendor_id")
  vendor          Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  /// What it is: "Insurance", "E&O", "W9", "Resume", or a custom label.
  label           String
  filename        String
  contentType     String   @map("content_type")
  sizeBytes       Int      @map("size_bytes")
  data            Bytes?
  storageKey      String?  @map("storage_key")
  storageProvider String?  @map("storage_provider")
  /// Attach automatically to the transaction when an order is placed. On by
  /// default — that's the whole point of keeping it here.
  shareOnOrder    Boolean  @default(true) @map("share_on_order")
  createdAt       DateTime @default(now())

  @@index([vendorId])
  @@map("vendor_document")
}

/// A paid ad placement a vendor buys — a deliberate revenue line. Shown only
/// where it's clearly labelled Sponsored (the vendor directory and the /vendors
/// marketing page), never on /compare or /recommend, which carry the
/// no-affiliate promise. Moderated: an ad is only ACTIVE (visible) once an
/// operator approves it AND its monthly subscription is paid; a lapsed payment
/// PAUSES it (never deletes). Like Vendor, this is a vendor-owned root table
/// with no tenant, so it has no RLS — the app scopes it (the vendor manages
/// their own, operators moderate, placement reads only ACTIVE).
enum AdStatus {
  PENDING
  ACTIVE
  PAUSED
  REJECTED
}

model VendorAd {
  id                    String    @id @default(uuid())
  vendorId              String    @map("vendor_id")
  vendor                Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  headline              String
  body                  String
  linkUrl               String    @map("link_url")
  status                AdStatus  @default(PENDING)
  /// Operator note on a rejection, shown back to the vendor.
  reviewNote            String?   @map("review_note")
  stripeCustomerId      String?   @map("stripe_customer_id")
  stripeSubscriptionId  String?   @map("stripe_subscription_id")
  /// Current paid-through date from Stripe; the ad is dark past it.
  periodEnd             DateTime? @map("period_end")
  /// End of a no-card free trial (set once when the vendor claims it). While in
  /// the future the ad runs without payment; past it, the nightly cron pauses it
  /// and starts the renewal drip. Null = never took a trial.
  trialEndsAt           DateTime? @map("trial_ends_at")
  /// Renewal-drip state (only meaningful for a trial that never converted).
  renewalToken          String?   @unique @map("renewal_token")
  renewalUnsubscribedAt DateTime? @map("renewal_unsubscribed_at")
  lastRenewalEmailAt    DateTime? @map("last_renewal_email_at")
  renewalEmailsSent     Int       @default(0) @map("renewal_emails_sent")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  states VendorAdState[]

  @@index([status])
  @@index([vendorId])
  @@index([stripeSubscriptionId])
  @@map("vendor_ad")
}

/// A state an ad is targeted to. Up to 4 per ad (enforced in the action); the
/// placement row for a viewer is served by matching their state to these. Root
/// table, no RLS — app-scoped like vendor_ad itself.
model VendorAdState {
  id        String   @id @default(uuid())
  adId      String   @map("ad_id")
  ad        VendorAd @relation(fields: [adId], references: [id], onDelete: Cascade)
  /// Two-letter US state code (see lib/vendor-profile US_STATES).
  state     String
  createdAt DateTime @default(now())

  @@unique([adId, state])
  @@index([state])
  @@map("vendor_ad_state")
}

enum VendorConnectionStatus {
  REQUESTED
  ACTIVE
  DECLINED
  REVOKED
}

enum ConnectionInitiator {
  TENANT
  VENDOR
}

/// The standing relationship between a coordinator's workspace and a vendor —
/// the "accept a friend request" handshake. Either side can start it; the
/// other accepts. Once ACTIVE, orders can flow. Revoking stops new orders but
/// never deletes the history.
///
/// Unlike engagement (both sides are tenants), the vendor side has no tenant,
/// so the two-sided RLS keys off app.tenant_id for the coordinator and
/// app.vendor_id for the vendor. Because only one is ever set in a given
/// transaction, the WITH CHECK also pins each side's inserts to itself.
model VendorConnection {
  id            String                 @id @default(uuid())
  tenantId      String                 @map("tenant_id")
  tenant        Organization           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendorId      String                 @map("vendor_id")
  vendor        Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  status        VendorConnectionStatus @default(REQUESTED)
  requestedBy   ConnectionInitiator    @map("requested_by")
  note          String?
  requestedById String?                @map("requested_by_id")
  respondedAt   DateTime?              @map("responded_at")
  revokedAt     DateTime?              @map("revoked_at")
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([tenantId, vendorId])
  @@index([tenantId])
  @@index([vendorId])
  @@map("vendor_connection")
}

enum VendorOrderStatus {
  DRAFT
  SENT
  ACCEPTED
  SCHEDULED
  COMPLETED
  DECLINED
  CANCELLED
}

enum OrderPlacedBy {
  TC
  CLIENT
}

enum OrderActor {
  TC
  VENDOR
  CLIENT
  SYSTEM
}

/// An order a coordinator (or, later, a client) places with a vendor on a
/// transaction — a title commitment, a home inspection, listing photos. It
/// lives on the file, not in an email thread. `vendorId` is null when the
/// order went out to an as-yet-unregistered vendor by email (Stage 4); once
/// they register it links up.
///
/// Same two-sided RLS as vendor_connection: the coordinator side keys off
/// app.tenant_id, the vendor side off app.vendor_id.
model VendorOrder {
  id               String                @id @default(uuid())
  tenantId         String                @map("tenant_id")
  tenant           Organization          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendorId         String?               @map("vendor_id")
  vendor           Vendor?               @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  transactionId    String                @map("transaction_id")
  transaction      Transaction           @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  connectionId     String?               @map("connection_id")
  /// Free-text order type ("Title commitment", "Home inspection", "Listing photos").
  type             String
  status           VendorOrderStatus     @default(SENT)
  details          String?
  dueDate          DateTime?             @map("due_date") @db.Date
  /// The appointment, once set — the thing TCs re-type today.
  scheduledAt      DateTime?             @map("scheduled_at")
  completedAt      DateTime?             @map("completed_at")
  /// Recorded, never overwritten, when an appointment is missed.
  missedAt         DateTime?             @map("missed_at")
  placedBy         OrderPlacedBy         @default(TC) @map("placed_by")
  /// Set when the order was emailed to an as-yet-unregistered vendor (vendorId
  /// null). Kept so a reply's sender can be checked against it, and so past
  /// orders can be claimed by that address on registration.
  emailTo          String?               @map("email_to")
  /// Who this order is for — the TC's client, or the buyer/seller they
  /// represent on this side ("Jane Doe (Seller)"). Shown to the vendor so
  /// they know who to expect on site; the relationship to the TC's client
  /// is internal bookkeeping the vendor doesn't need explained.
  onBehalfOf       String?               @map("on_behalf_of")
  /// The name/email of whoever placed the order, captured at creation so an
  /// unregistered vendor's page can show a real person without a join back
  /// through Member/User (which the bare-token page never has a session for).
  requestedByName  String?               @map("requested_by_name")
  requestedByEmail String?               @map("requested_by_email")
  /// A callback number for the person placing the order — a vendor on a
  /// jobsite needs someone reachable by phone, not just an email thread.
  requesterPhone   String?               @map("requester_phone")
  /// Who to bill and how to reach them, captured at order time so an
  /// unregistered vendor never has to guess. {name?, email?, phone?}.
  billingContact   Json?                 @map("billing_contact")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  events           VendorOrderEvent[]
  proposals        VendorOrderProposal[]
  messages         VendorOrderMessage[]
  link             VendorOrderLink?
  documents        Document[]            @relation("OrderDocuments")

  @@index([tenantId, transactionId])
  @@index([vendorId])
  @@index([emailTo])
  @@map("vendor_order")
}

/// The audit history of one order. Appended to, never mutated — because the
/// evidence a coordinator most needs is that an appointment was set for
/// Tuesday and missed, which a status column that just flips to COMPLETED
/// would erase. tenant_id + vendor_id are copied from the parent order so the
/// same two-sided RLS lets both sides read the trail.
model VendorOrderEvent {
  id        String      @id @default(uuid())
  tenantId  String      @map("tenant_id")
  vendorId  String?     @map("vendor_id")
  orderId   String      @map("order_id")
  order     VendorOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// "created", "accepted", "declined", "scheduled", "rescheduled", "missed",
  /// "completed", "cancelled", "note".
  kind      String
  detail    String?
  /// The appointment time, for scheduled/rescheduled events.
  at        DateTime?
  actor     OrderActor  @default(TC)
  createdAt DateTime    @default(now())

  @@index([tenantId, orderId])
  @@map("vendor_order_event")
}

/// A signed capability link that lets an emailed, unregistered vendor act on
/// one order without an account — accept, schedule, complete — the portal_link
/// pattern with an expiry and a revoke. Like portal_link and api_key, the token
/// IS the capability, so this table deliberately has NO RLS: it's looked up by
/// bare token before any tenant context exists, then everything downstream runs
/// through withTenant(order.tenantId).
model VendorOrderLink {
  id             String      @id @default(uuid())
  tenantId       String      @map("tenant_id")
  orderId        String      @unique @map("order_id")
  order          VendorOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  token          String      @unique
  /// The address the order was emailed to — the party the link is meant for.
  email          String
  expiresAt      DateTime    @map("expires_at")
  revokedAt      DateTime?   @map("revoked_at")
  lastAccessedAt DateTime?   @map("last_accessed_at")
  createdAt      DateTime    @default(now())

  @@map("vendor_order_link")
}

/// What the AI read an emailed vendor's plain-text reply as proposing.
enum ProposalKind {
  ACCEPT
  DECLINE
  SCHEDULE
  COMPLETE
  NOTE
  UNKNOWN
}

enum ProposalStatus {
  PENDING
  APPLIED
  DISMISSED
}

/// An AI-read proposal derived from an unregistered vendor's email reply. It is
/// never applied automatically: it surfaces on the order for the coordinator to
/// accept in one click — the features page's "nothing the AI reads touches your
/// file until you approve it" promise. Tenant-scoped RLS: only the coordinator
/// reviews proposals, so the vendor side never reads this table.
model VendorOrderProposal {
  id             String         @id @default(uuid())
  tenantId       String         @map("tenant_id")
  orderId        String         @map("order_id")
  order          VendorOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind           ProposalKind   @default(UNKNOWN)
  /// Proposed appointment time, for SCHEDULE proposals.
  at             DateTime?
  /// One-line summary the coordinator sees ("Wants to schedule Tuesday 2pm").
  summary        String
  /// The reply text the proposal was derived from (quoted history stripped).
  sourceText     String         @map("source_text")
  fromAddr       String         @map("from_addr")
  /// True when the sender didn't match the address the order was emailed to.
  senderMismatch Boolean        @default(false) @map("sender_mismatch")
  status         ProposalStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  resolvedAt     DateTime?      @map("resolved_at")

  @@index([tenantId, orderId])
  @@map("vendor_order_proposal")
}

/// One message in an order's conversation. Both sides post here — the
/// coordinator, the vendor (in-app or by email reply), later the client — so a
/// single thread exists regardless of channel. Same two-sided RLS as the order
/// itself: tenant_id for the coordinator, denormalized vendor_id for a
/// registered vendor. An emailed (unregistered) vendor reads and writes through
/// their capability link, which resolves the order and scopes to its tenant.
model VendorOrderMessage {
  id         String      @id @default(uuid())
  tenantId   String      @map("tenant_id")
  vendorId   String?     @map("vendor_id")
  orderId    String      @map("order_id")
  order      VendorOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorKind OrderActor  @map("author_kind")
  authorId   String?     @map("author_id")
  /// Display name captured at send time (TC user, vendor business, or client).
  authorName String?     @map("author_name")
  body       String
  /// True when the message arrived as an email reply rather than typed in-app.
  viaEmail   Boolean     @default(false) @map("via_email")
  createdAt  DateTime    @default(now())

  @@index([tenantId, orderId, createdAt])
  @@map("vendor_order_message")
}

/// Inbound mail that couldn't be threaded — no reply token, or a token that
/// matched nothing. Previously dropped with a 200 and no trace; now captured so
/// a vendor's reply never silently vanishes, with an operator alert. May have no
/// tenant (a stray inbound), so like the other capability/system tables it has
/// NO RLS and is read only in the operator console.
model InboundEmail {
  id              String    @id @default(uuid())
  tenantId        String?   @map("tenant_id")
  fromAddr        String    @map("from_addr")
  toAddr          String    @map("to_addr")
  subject         String
  bodyText        String    @map("body_text")
  token           String?
  /// Why it landed here: "no_token" | "unknown_token".
  reason          String
  attachmentCount Int       @default(0) @map("attachment_count")
  handledAt       DateTime? @map("handled_at")
  createdAt       DateTime  @default(now())

  @@index([createdAt])
  @@map("inbound_email")
}

/// A person who can act for a vendor. Many per vendor (a title company has
/// several escrow officers), which is why this is a join and not a scalar on
/// Vendor — the mistake Engagement.guestUserId would have forced.
model VendorUser {
  id        String   @id @default(uuid())
  vendorId  String   @map("vendor_id")
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "owner" (created it) or "member". Vendor-internal, unrelated to tenant roles.
  role      String   @default("owner")
  createdAt DateTime @default(now())

  @@unique([vendorId, userId])
  @@index([userId])
  @@map("vendor_user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

/// better-auth twoFactor plugin storage (TOTP secret + hashed backup codes).
model TwoFactor {
  id                      String    @id
  userId                  String    @map("user_id")
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret                  String
  backupCodes             String    @map("backup_codes")
  verified                Boolean   @default(false)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until")

  @@index([userId])
  @@map("two_factor")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

/// A TC's own inbox, connected via Nylas so they can send as themselves
/// instead of the workspace's shared Resend address. Person-scoped, not
/// tenant-scoped — like Account/Session, this follows the user across every
/// workspace they belong to rather than requiring a reconnect per workspace.
/// No RLS for the same reason: it has no tenant_id to key off.
///
/// One row per user, upserted on (re)connect — connecting a different
/// account overwrites grantId/email/provider on the same row rather than
/// creating a second one. `status`/`provider` mirror Nylas's own vocabulary
/// directly (`grant_status` values, provider slugs) rather than a closed
/// Prisma enum, so a new provider or status Nylas adds doesn't need a
/// migration here — same reasoning as Email.status above.
model NylasGrant {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantId     String   @unique @map("grant_id")
  email       String
  provider    String
  /// Nylas grant_status: "valid" while the connection works, "invalid" once
  /// the user revokes access at the provider or a token can't be refreshed.
  status      String   @default("valid")
  /// Set when a send fails or the grant flips invalid — surfaced in the
  /// profile UI so the TC knows to reconnect rather than silently failing.
  lastError   String?  @map("last_error")
  connectedAt DateTime @default(now()) @map("connected_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("nylas_grant")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// --- Better Auth organization plugin (Organization = Freehold tenant) ---

/// Cloud plan tier. Self-hosted installs stay on FREE semantics-wise but are
/// never limited — limits are enforced only when FREEHOLD_CLOUD=1.
enum PlanTier {
  FREE
  PRO
  BUSINESS
}

model Organization {
  id                      String                        @id
  name                    String
  slug                    String                        @unique
  logo                    String?
  metadata                String?
  planTier                PlanTier                      @default(FREE) @map("plan_tier")
  seatLimit               Int                           @default(2) @map("seat_limit")
  aiExtractionsUsed       Int                           @default(0) @map("ai_extractions_used")
  /// Voice-search sessions started this billing month. Unlike the lifetime
  /// extraction credits, voice recurs, so the window rolls: once
  /// voiceQuotaResetAt is in the past the counter starts over.
  voiceSessionsUsed       Int                           @default(0) @map("voice_sessions_used")
  voiceQuotaResetAt       DateTime?                     @map("voice_quota_reset_at")
  /// Prepaid AI credits (Cloud Free only). Spending one credit permanently
  /// unlocks pro AI features on a single transaction. Paid tiers ignore this —
  /// their AI is unmetered. New workspaces start with 2; topped up by purchase
  /// or coupon. The balance of record; every change is mirrored to CreditLedger.
  aiCredits               Int                           @default(2) @map("ai_credits")
  /// Operator override for this tenant's contract-extraction model. When set,
  /// heavy or costly workspaces run extraction on a cheaper model instead of
  /// the default. Null = platform default (FREEHOLD_AI_MODEL / Opus).
  aiModelOverride         String?                       @map("ai_model_override")
  /// Admin setting: when true, members only see contacts they own.
  restrictContactsToOwner Boolean                       @default(false) @map("restrict_contacts_to_owner")
  /// Admin setting: when true, any member can create/edit/delete signature
  /// blocks. Off (the default) keeps that to owners/admins only — a
  /// coordinator's title and phone number on outgoing mail isn't something
  /// every new hire should be able to rewrite on day one.
  membersCanEditSignatures Boolean                      @default(false) @map("members_can_edit_signatures")
  emailSignatures         EmailSignature[]
  /// The Handbook: the notes a team keeps about clients, contacts, people and
  /// files. Two switches, not one, because the halves are separable — someone
  /// who wants nothing to do with AI can still keep notes, which is the more
  /// valuable half. Off hides the feature entirely.
  handbookEnabled         Boolean                       @default(true) @map("handbook_enabled")
  /// The AI-written "Today at a glance" paragraph. Off leaves notes, pooling
  /// and grades working exactly as before, with no model call anywhere.
  handbookSummaryEnabled  Boolean                       @default(true) @map("handbook_summary_enabled")
  handbookNotes           HandbookNote[]
  /// Per-tenant Follow Up Boss connection: {enc:{...}, importedAt?, importedCount?}.
  /// API key encrypted with VAULT_MASTER_KEY.
  fubConfig               Json?                         @map("fub_config")
  /// Per-tenant Twenty CRM connection: {url, enc:{...}, importedAt?, importedCount?}.
  twentyConfig            Json?                         @map("twenty_config")
  /// Tenant wording for transaction sides: {buy, sell} — e.g. sell side vs list side.
  sideLabels              Json?                         @map("side_labels")
  /// Tenant overrides for automated email templates: {intro:{subject,body}, postClose:{subject,body}}.
  emailTemplates          Json?                         @map("email_templates")
  /// Workspace email signature + global footer: {signature, footer} —
  /// appended to every outgoing branded email.
  emailSettings           Json?                         @map("email_settings")
  /// Tenant mini-site at <slug>.<root>: {published, tagline, about, phone, email, services, showRegistration}.
  siteConfig              Json?                         @map("site_config")
  /// Look-and-feel choices, all optional with sensible defaults:
  /// {theme, portalFont, priorityColors:{HIGH,CRITICAL}, rowHighlight:{scope,color}}.
  /// theme + portalFont style the client portal; priorityColors + rowHighlight
  /// tint the internal task lists. Null = Freehold defaults (forest/green).
  appearanceConfig        Json?                         @map("appearance_config")
  /// Per-tenant Documenso connection: {url, enc:{ciphertext,iv,tag,wrappedKey,wrapIv,wrapTag,keyVersion}}.
  /// Token encrypted with VAULT_MASTER_KEY; null = use server-wide env default.
  documensoConfig         Json?                         @map("documenso_config")
  /// Per-tenant document storage: {provider:"S3", endpoint, region, bucket,
  /// accessKeyEnc:{...}, secretKeyEnc:{...}}. Keys encrypted with VAULT_MASTER_KEY.
  /// New documents route here; null = platform default (env S3) or Postgres bytes.
  storageConfig           Json?                         @map("storage_config")
  stripeCustomerId        String?                       @map("stripe_customer_id")
  stripeSubscriptionId    String?                       @map("stripe_subscription_id")
  /// Last-known Stripe subscription status (active, trialing, past_due, unpaid, canceled).
  /// Mirrored from webhooks for operator visibility; null = never had a paid sub.
  subscriptionStatus      String?                       @map("subscription_status")
  /// Set when the workspace is locked for a failed renewal. Data is preserved;
  /// the dashboard is gated until payment is updated. Cleared when Stripe reports paid again.
  billingSuspendedAt      DateTime?                     @map("billing_suspended_at")
  /// Complimentary (comped) plan grant, independent of Stripe. When set (and not
  /// past compExpiresAt), it overrides planTier — a full plan with no checkout/charge.
  compTier                PlanTier?                     @map("comp_tier")
  /// When the comp ends; null = no expiry (until an operator revokes it).
  compExpiresAt           DateTime?                     @map("comp_expires_at")
  createdAt               DateTime                      @default(now())
  members                 Member[]
  invitations             Invitation[]
  clients                 Client[]
  contacts                Contact[]
  contactOwners           ContactOwner[]
  transactions            Transaction[]
  parties                 TransactionParty[]
  tasks                   Task[]
  actionPlans             ActionPlan[]
  actionPlanTasks         ActionPlanTask[]
  actionPlanDocuments     ActionPlanDocument[]
  templateGroups          TemplateGroup[]
  attachmentTemplates     AttachmentTemplate[]
  attachmentTemplateItems AttachmentTemplateItem[]
  dateTemplates           DateTemplate[]
  dateTemplateItems       DateTemplateItem[]
  requiredDocuments       TransactionRequiredDocument[]
  complianceChecklists    ComplianceChecklist[]
  complianceItems         ComplianceItem[]
  transactionCompliances  TransactionCompliance[]
  complianceSlots         ComplianceSlot[]
  userLicenses            UserLicense[]
  transactionAssignees    TransactionAssignee[]
  states                  TenantState[]
  paymentRequests         PaymentRequest[]
  paymentRequestItems     PaymentRequestItem[]
  engagementsHired        Engagement[]                  @relation("EngagementHirer")
  engagementsProvided     Engagement[]                  @relation("EngagementVendor")
  supportTickets          SupportTicket[]
  supportTicketReplies    SupportTicketReply[]
  vendorConnections       VendorConnection[]
  vendorOrders            VendorOrder[]
  /// What happens when a file sits in a license-required state with nobody
  /// licensed assigned: "warn" (save it, flag it everywhere) or "block"
  /// (refuse the write). Deliberately a tenant choice — TCs routinely open a
  /// file before deciding who runs it.
  licenseEnforcement      String                        @default("warn") @map("license_enforcement")
  /// Opt-in vendor-directory listing, published to other workspaces and to the
  /// public syndication feed: {listed, blurb, contactEmail, specializations[],
  /// software[], availability, pricingModel, yearsExperience, remote}. States
  /// covered come from TenantState. Null or listed:false = not listed anywhere.
  directoryConfig         Json?                         @map("directory_config")
  /// Per-tenant ERPNext connection: {url, itemCode, keyEnc:{...},
  /// secretEnc:{...}}. API key + secret encrypted with VAULT_MASTER_KEY.
  /// Null = client invoices are kept in Freehold only.
  erpnextConfig           Json?                         @map("erpnext_config")
  /// Workspace billing policy: {mode, depositPercent, lateFee:{...},
  /// defaultFeeCents}. Every key overridable per client (Client.billingConfig).
