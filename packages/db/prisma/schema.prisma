// Freehold schema — Stage 00.
//
// Auth tables (user, session, account, verification, organization, member,
// invitation) follow Better Auth's expected shape (organization plugin enabled).
// Domain convention: an Organization IS a Freehold tenant — the paying customer
// (broker, title company, or solo TC business). Domain tables carry tenant_id
// and are protected by Postgres row-level security (see the init migration and
// `withTenant` in src/tenant.ts).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Better Auth core ---

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]
  ownedContacts Contact[]    @relation("ContactOwner")
  assignedTasks Task[]       @relation("TaskAssignee")

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// --- Better Auth organization plugin (Organization = Freehold tenant) ---

model Organization {
  id              String            @id
  name            String
  slug            String            @unique
  logo            String?
  metadata        String?
  createdAt       DateTime          @default(now())
  members         Member[]
  invitations     Invitation[]
  clients         Client[]
  contacts        Contact[]
  transactions    Transaction[]
  parties         TransactionParty[]
  tasks           Task[]
  actionPlans     ActionPlan[]
  actionPlanTasks ActionPlanTask[]

  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invitation")
}

// --- Freehold domain (row-level security enforced; see init migration) ---

enum ClientType {
  AGENT
  BROKERAGE
  TITLE
  LENDER
  OTHER
}

/// The tenant's customer — the agent, brokerage, title company, or lender they
/// serve. Transactions, vault credentials, portal branding, and invoicing all
/// attach here in later stages.
model Client {
  id           String        @id @default(uuid())
  tenantId     String        @map("tenant_id")
  tenant       Organization  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type         ClientType    @default(AGENT)
  name         String
  email        String?
  phone        String?
  notes        String?
  isSample     Boolean       @default(false)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([tenantId])
  @@map("client")
}

enum TransactionStatus {
  LISTING
  UNDER_CONTRACT
  PENDING
  CLOSED
  CANCELLED
}

enum TransactionSide {
  BUY_SIDE
  SELL_SIDE
  DUAL
}

enum PartyRole {
  BUYER
  SELLER
  BUYER_AGENT
  LISTING_AGENT
  LENDER
  TITLE_COMPANY
  INSPECTOR
  APPRAISER
  ATTORNEY
  OTHER
}

enum TaskStatus {
  OPEN
  DONE
  SKIPPED
}

enum DateAnchor {
  CONTRACT_DATE
  CLOSE_DATE
}

/// CRM record — buyers, sellers, agents, lenders, vendors. Category is free
/// text on purpose (competitors allow custom categories).
model Contact {
  id        String             @id @default(uuid())
  tenantId  String             @map("tenant_id")
  tenant    Organization       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId   String?
  owner     User?              @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  name      String
  email     String?
  phone     String?
  category  String             @default("Other")
  rating    Int?
  touchDate DateTime?          @map("touch_date") @db.Date
  notes     String?
  isSample  Boolean            @default(false)
  parties   TransactionParty[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([tenantId, category])
  @@map("contact")
}

/// The central object: one closing. Belongs to a tenant, optionally to the
/// client (agent/brokerage) the tenant serves it for.
model Transaction {
  id              String             @id @default(uuid())
  tenantId        String             @map("tenant_id")
  tenant          Organization       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId        String?
  client          Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  status          TransactionStatus  @default(UNDER_CONTRACT)
  side            TransactionSide    @default(BUY_SIDE)
  propertyAddress String             @map("property_address")
  city            String?
  state           String?
  zip             String?
  purchasePrice   Int?               @map("purchase_price")
  contractDate    DateTime?          @map("contract_date") @db.Date
  closeDate       DateTime?          @map("close_date") @db.Date
  notes           String?
  customFields    Json?              @map("custom_fields")
  isSample        Boolean            @default(false)
  parties         TransactionParty[]
  tasks           Task[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([tenantId, status])
  @@map("transaction")
}

model TransactionParty {
  id            String       @id @default(uuid())
  tenantId      String       @map("tenant_id")
  tenant        Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  contactId     String
  contact       Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  role          PartyRole
  createdAt     DateTime     @default(now())

  @@unique([transactionId, contactId, role])
  @@index([tenantId])
  @@map("transaction_party")
}

model Task {
  id            String       @id @default(uuid())
  tenantId      String       @map("tenant_id")
  tenant        Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  title         String
  notes         String?
  dueDate       DateTime?    @map("due_date") @db.Date
  status        TaskStatus   @default(OPEN)
  assigneeId    String?
  assignee      User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  sortOrder     Int          @default(0) @map("sort_order")
  isSample      Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([tenantId, status, dueDate])
  @@map("task")
}

/// Reusable checklist template ("Texas buy-side closing, 30 tasks").
model ActionPlan {
  id          String           @id @default(uuid())
  tenantId    String           @map("tenant_id")
  tenant      Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isSample    Boolean          @default(false)
  tasks       ActionPlanTask[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([tenantId])
  @@map("action_plan")
}

model ActionPlanTask {
  id           String       @id @default(uuid())
  tenantId     String       @map("tenant_id")
  tenant       Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actionPlanId String
  actionPlan   ActionPlan   @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  title        String
  anchor       DateAnchor   @default(CLOSE_DATE)
  offsetDays   Int          @default(0) @map("offset_days")
  assigneeRole String?      @map("assignee_role")
  sortOrder    Int          @default(0) @map("sort_order")

  @@index([tenantId])
  @@map("action_plan_task")
}
