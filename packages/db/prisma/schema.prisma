// Freehold schema — Stage 00.
//
// Auth tables (user, session, account, verification, organization, member,
// invitation) follow Better Auth's expected shape (organization plugin enabled).
// Domain convention: an Organization IS a Freehold tenant — the paying customer
// (broker, title company, or solo TC business). Domain tables carry tenant_id
// and are protected by Postgres row-level security (see the init migration and
// `withTenant` in src/tenant.ts).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Better Auth core ---

model User {
  id               String        @id
  name             String
  email            String        @unique
  emailVerified    Boolean       @default(false)
  /// Unique login handle that doubles as the user's subdomain, so it lives in
  /// the same *.freeholdtc.dev namespace as workspace slugs and reserved
  /// subdomains. Lowercase, URL-safe. displayUsername keeps the as-typed form.
  username         String?       @unique
  displayUsername  String?
  image            String?
  /// Profile photo bytes, stored inline (photos are small and user-global, so
  /// they never route to a tenant's bucket). Served by /api/users/[id]/avatar;
  /// `image` holds that path so anything reading the auth user renders it.
  avatarData       Bytes?        @map("avatar_data")
  avatarType       String?       @map("avatar_type")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  twoFactorEnabled Boolean?      @map("two_factor_enabled")
  twoFactors       TwoFactor[]
  sessions         Session[]
  accounts         Account[]
  members          Member[]
  invitations      Invitation[]
  ownedContacts    Contact[]     @relation("ContactOwner")
  assignedTasks    Task[]        @relation("TaskAssignee")
  licenses         UserLicense[]
  transactionAssignments TransactionAssignee[]
  paymentRequests  PaymentRequest[]
  guestEngagements Engagement[]
  supportTickets   SupportTicket[]
  vendorUsers      VendorUser[]

  @@map("user")
}

enum VendorCategory {
  TITLE
  INSPECTION
  PHOTOGRAPHY
  SIGNAGE
  LEGAL
  OTHER
}

/// A service business on FreeholdVendors — a title company, inspector,
/// photographer, sign installer, or law office. A vendor is its own root
/// entity, NOT a tenant: it has no Organization, no Member rows, and never
/// touches a workspace's seat or plan limits. It connects to many TC
/// workspaces (see VendorConnection) and receives orders from all of them.
///
/// Deliberately no row-level security: like Organization, a vendor is a top
/// of the ownership tree, scoped by the app through VendorUser membership, not
/// by app.tenant_id (a vendor has no tenant).
model Vendor {
  id          String         @id @default(uuid())
  name        String
  category    VendorCategory @default(OTHER)
  email       String         @unique
  phone       String?
  /// Free-text service area ("Chicago metro", "Cook & DuPage counties").
  serviceArea String?        @map("service_area")
  blurb       String?
  /// Logo as a data URL, same convention as Organization.logo.
  logo        String?
  /// Opt-in to the TC-side vendor directory. Off by default.
  listed      Boolean        @default(false)
  /// URL handle for the public vendor page (/v/<slug>). Null on rows created
  /// before public pages existed; backfilled on the next profile save.
  slug        String?        @unique
  /// Tiered contact/bio fields. Visibility is enforced where each is rendered:
  /// public.* shows on the public vendor page, ads, and directory; client.*
  /// shows to a coordinator's client on an order with this vendor; private.*
  /// is the vendor's own, never displayed. `blurb`/`phone`/`email` above stay
  /// as the pre-tier fields (account email, directory blurb).
  publicBio          String? @map("public_bio")
  publicPhone        String? @map("public_phone")
  publicEmail        String? @map("public_email")
  clientBio          String? @map("client_bio")
  clientPhone        String? @map("client_phone")
  clientServiceNotes String? @map("client_service_notes")
  privateEmail       String? @map("private_email")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  users       VendorUser[]
  connections VendorConnection[]
  orders      VendorOrder[]
  ads         VendorAd[]
  coverage    VendorCoverage[]
  documents   VendorDocument[]

  @@index([category])
  @@map("vendor")
}

/// Where a vendor works, one row per area. Kept as rows (not a text field) so
/// "who covers Illinois / Cook County / 60601" is a real query — needed for the
/// coordinator directory filter and the regional ad targeting. No RLS: a
/// vendor-owned root table like vendor itself.
model VendorCoverage {
  id        String   @id @default(uuid())
  vendorId  String   @map("vendor_id")
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  /// "STATE" | "COUNTY" | "ZIP".
  kind      String
  /// The area: a USPS state code ("IL"), a "County, ST" string, or a ZIP.
  value     String
  createdAt DateTime @default(now())

  @@index([vendorId])
  @@index([kind, value])
  @@map("vendor_coverage")
}

/// A document a vendor keeps on their profile (insurance, E&O, W9, resume) to
/// share when an order is placed. Envelope-encrypted through the same putObject
/// path as transaction documents. No RLS — vendor-owned root table.
model VendorDocument {
  id              String   @id @default(uuid())
  vendorId        String   @map("vendor_id")
  vendor          Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  /// What it is: "Insurance", "E&O", "W9", "Resume", or a custom label.
  label           String
  filename        String
  contentType     String   @map("content_type")
  sizeBytes       Int      @map("size_bytes")
  data            Bytes?
  storageKey      String?  @map("storage_key")
  storageProvider String?  @map("storage_provider")
  /// Attach automatically to the transaction when an order is placed. On by
  /// default — that's the whole point of keeping it here.
  shareOnOrder    Boolean  @default(true) @map("share_on_order")
  createdAt       DateTime @default(now())

  @@index([vendorId])
  @@map("vendor_document")
}

/// A paid ad placement a vendor buys — a deliberate revenue line. Shown only
/// where it's clearly labelled Sponsored (the vendor directory and the /vendors
/// marketing page), never on /compare or /recommend, which carry the
/// no-affiliate promise. Moderated: an ad is only ACTIVE (visible) once an
/// operator approves it AND its monthly subscription is paid; a lapsed payment
/// PAUSES it (never deletes). Like Vendor, this is a vendor-owned root table
/// with no tenant, so it has no RLS — the app scopes it (the vendor manages
/// their own, operators moderate, placement reads only ACTIVE).
enum AdStatus {
  PENDING
  ACTIVE
  PAUSED
  REJECTED
}

model VendorAd {
  id                   String    @id @default(uuid())
  vendorId             String    @map("vendor_id")
  vendor               Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  headline             String
  body                 String
  linkUrl              String    @map("link_url")
  status               AdStatus  @default(PENDING)
  /// Operator note on a rejection, shown back to the vendor.
  reviewNote           String?   @map("review_note")
  stripeCustomerId     String?   @map("stripe_customer_id")
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  /// Current paid-through date from Stripe; the ad is dark past it.
  periodEnd            DateTime? @map("period_end")
  /// End of a no-card free trial (set once when the vendor claims it). While in
  /// the future the ad runs without payment; past it, the nightly cron pauses it
  /// and starts the renewal drip. Null = never took a trial.
  trialEndsAt          DateTime? @map("trial_ends_at")
  /// Renewal-drip state (only meaningful for a trial that never converted).
  renewalToken          String?   @unique @map("renewal_token")
  renewalUnsubscribedAt DateTime? @map("renewal_unsubscribed_at")
  lastRenewalEmailAt    DateTime? @map("last_renewal_email_at")
  renewalEmailsSent     Int       @default(0) @map("renewal_emails_sent")
  createdAt            DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  states VendorAdState[]

  @@index([status])
  @@index([vendorId])
  @@index([stripeSubscriptionId])
  @@map("vendor_ad")
}

/// A state an ad is targeted to. Up to 4 per ad (enforced in the action); the
/// placement row for a viewer is served by matching their state to these. Root
/// table, no RLS — app-scoped like vendor_ad itself.
model VendorAdState {
  id      String   @id @default(uuid())
  adId    String   @map("ad_id")
  ad      VendorAd @relation(fields: [adId], references: [id], onDelete: Cascade)
  /// Two-letter US state code (see lib/vendor-profile US_STATES).
  state   String
  createdAt DateTime @default(now())

  @@unique([adId, state])
  @@index([state])
  @@map("vendor_ad_state")
}

enum VendorConnectionStatus {
  REQUESTED
  ACTIVE
  DECLINED
  REVOKED
}

enum ConnectionInitiator {
  TENANT
  VENDOR
}

/// The standing relationship between a coordinator's workspace and a vendor —
/// the "accept a friend request" handshake. Either side can start it; the
/// other accepts. Once ACTIVE, orders can flow. Revoking stops new orders but
/// never deletes the history.
///
/// Unlike engagement (both sides are tenants), the vendor side has no tenant,
/// so the two-sided RLS keys off app.tenant_id for the coordinator and
/// app.vendor_id for the vendor. Because only one is ever set in a given
/// transaction, the WITH CHECK also pins each side's inserts to itself.
model VendorConnection {
  id          String                 @id @default(uuid())
  tenantId    String                 @map("tenant_id")
  tenant      Organization           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendorId    String                 @map("vendor_id")
  vendor      Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  status      VendorConnectionStatus @default(REQUESTED)
  requestedBy ConnectionInitiator    @map("requested_by")
  note        String?
  requestedById String?              @map("requested_by_id")
  respondedAt DateTime?              @map("responded_at")
  revokedAt   DateTime?              @map("revoked_at")
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([tenantId, vendorId])
  @@index([tenantId])
  @@index([vendorId])
  @@map("vendor_connection")
}

enum VendorOrderStatus {
  DRAFT
  SENT
  ACCEPTED
  SCHEDULED
  COMPLETED
  DECLINED
  CANCELLED
}

enum OrderPlacedBy {
  TC
  CLIENT
}

enum OrderActor {
  TC
  VENDOR
  CLIENT
  SYSTEM
}

/// An order a coordinator (or, later, a client) places with a vendor on a
/// transaction — a title commitment, a home inspection, listing photos. It
/// lives on the file, not in an email thread. `vendorId` is null when the
/// order went out to an as-yet-unregistered vendor by email (Stage 4); once
/// they register it links up.
///
/// Same two-sided RLS as vendor_connection: the coordinator side keys off
/// app.tenant_id, the vendor side off app.vendor_id.
model VendorOrder {
  id            String            @id @default(uuid())
  tenantId      String            @map("tenant_id")
  tenant        Organization      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendorId      String?           @map("vendor_id")
  vendor        Vendor?           @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  transactionId String            @map("transaction_id")
  transaction   Transaction       @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  connectionId  String?           @map("connection_id")
  /// Free-text order type ("Title commitment", "Home inspection", "Listing photos").
  type          String
  status        VendorOrderStatus @default(SENT)
  details       String?
  dueDate       DateTime?         @map("due_date") @db.Date
  /// The appointment, once set — the thing TCs re-type today.
  scheduledAt   DateTime?         @map("scheduled_at")
  completedAt   DateTime?         @map("completed_at")
  /// Recorded, never overwritten, when an appointment is missed.
  missedAt      DateTime?         @map("missed_at")
  placedBy      OrderPlacedBy     @default(TC) @map("placed_by")
  /// Set when the order was emailed to an as-yet-unregistered vendor (vendorId
  /// null). Kept so a reply's sender can be checked against it, and so past
  /// orders can be claimed by that address on registration.
  emailTo       String?           @map("email_to")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  events        VendorOrderEvent[]
  proposals     VendorOrderProposal[]
  messages      VendorOrderMessage[]
  link          VendorOrderLink?
  documents     Document[]        @relation("OrderDocuments")

  @@index([tenantId, transactionId])
  @@index([vendorId])
  @@index([emailTo])
  @@map("vendor_order")
}

/// The audit history of one order. Appended to, never mutated — because the
/// evidence a coordinator most needs is that an appointment was set for
/// Tuesday and missed, which a status column that just flips to COMPLETED
/// would erase. tenant_id + vendor_id are copied from the parent order so the
/// same two-sided RLS lets both sides read the trail.
model VendorOrderEvent {
  id        String      @id @default(uuid())
  tenantId  String      @map("tenant_id")
  vendorId  String?     @map("vendor_id")
  orderId   String      @map("order_id")
  order     VendorOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// "created", "accepted", "declined", "scheduled", "rescheduled", "missed",
  /// "completed", "cancelled", "note".
  kind      String
  detail    String?
  /// The appointment time, for scheduled/rescheduled events.
  at        DateTime?
  actor     OrderActor  @default(TC)
  createdAt DateTime    @default(now())

  @@index([tenantId, orderId])
  @@map("vendor_order_event")
}

/// A signed capability link that lets an emailed, unregistered vendor act on
/// one order without an account — accept, schedule, complete — the portal_link
/// pattern with an expiry and a revoke. Like portal_link and api_key, the token
/// IS the capability, so this table deliberately has NO RLS: it's looked up by
/// bare token before any tenant context exists, then everything downstream runs
/// through withTenant(order.tenantId).
model VendorOrderLink {
  id             String      @id @default(uuid())
  tenantId       String      @map("tenant_id")
  orderId        String      @unique @map("order_id")
  order          VendorOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  token          String      @unique
  /// The address the order was emailed to — the party the link is meant for.
  email          String
  expiresAt      DateTime    @map("expires_at")
  revokedAt      DateTime?   @map("revoked_at")
  lastAccessedAt DateTime?   @map("last_accessed_at")
  createdAt      DateTime    @default(now())

  @@map("vendor_order_link")
}

/// What the AI read an emailed vendor's plain-text reply as proposing.
enum ProposalKind {
  ACCEPT
  DECLINE
  SCHEDULE
  COMPLETE
  NOTE
  UNKNOWN
}

enum ProposalStatus {
  PENDING
  APPLIED
  DISMISSED
}

/// An AI-read proposal derived from an unregistered vendor's email reply. It is
/// never applied automatically: it surfaces on the order for the coordinator to
/// accept in one click — the features page's "nothing the AI reads touches your
/// file until you approve it" promise. Tenant-scoped RLS: only the coordinator
/// reviews proposals, so the vendor side never reads this table.
model VendorOrderProposal {
  id         String         @id @default(uuid())
  tenantId   String         @map("tenant_id")
  orderId    String         @map("order_id")
  order      VendorOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind       ProposalKind   @default(UNKNOWN)
  /// Proposed appointment time, for SCHEDULE proposals.
  at         DateTime?
  /// One-line summary the coordinator sees ("Wants to schedule Tuesday 2pm").
  summary    String
  /// The reply text the proposal was derived from (quoted history stripped).
  sourceText String         @map("source_text")
  fromAddr   String         @map("from_addr")
  /// True when the sender didn't match the address the order was emailed to.
  senderMismatch Boolean    @default(false) @map("sender_mismatch")
  status     ProposalStatus @default(PENDING)
  createdAt  DateTime       @default(now())
  resolvedAt DateTime?      @map("resolved_at")

  @@index([tenantId, orderId])
  @@map("vendor_order_proposal")
}

/// One message in an order's conversation. Both sides post here — the
/// coordinator, the vendor (in-app or by email reply), later the client — so a
/// single thread exists regardless of channel. Same two-sided RLS as the order
/// itself: tenant_id for the coordinator, denormalized vendor_id for a
/// registered vendor. An emailed (unregistered) vendor reads and writes through
/// their capability link, which resolves the order and scopes to its tenant.
model VendorOrderMessage {
  id         String      @id @default(uuid())
  tenantId   String      @map("tenant_id")
  vendorId   String?     @map("vendor_id")
  orderId    String      @map("order_id")
  order      VendorOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorKind OrderActor  @map("author_kind")
  authorId   String?     @map("author_id")
  /// Display name captured at send time (TC user, vendor business, or client).
  authorName String?     @map("author_name")
  body       String
  /// True when the message arrived as an email reply rather than typed in-app.
  viaEmail   Boolean     @default(false) @map("via_email")
  createdAt  DateTime    @default(now())

  @@index([tenantId, orderId, createdAt])
  @@map("vendor_order_message")
}

/// Inbound mail that couldn't be threaded — no reply token, or a token that
/// matched nothing. Previously dropped with a 200 and no trace; now captured so
/// a vendor's reply never silently vanishes, with an operator alert. May have no
/// tenant (a stray inbound), so like the other capability/system tables it has
/// NO RLS and is read only in the operator console.
model InboundEmail {
  id              String    @id @default(uuid())
  tenantId        String?   @map("tenant_id")
  fromAddr        String    @map("from_addr")
  toAddr          String    @map("to_addr")
  subject         String
  bodyText        String    @map("body_text")
  token           String?
  /// Why it landed here: "no_token" | "unknown_token".
  reason          String
  attachmentCount Int       @default(0) @map("attachment_count")
  handledAt       DateTime? @map("handled_at")
  createdAt       DateTime  @default(now())

  @@index([createdAt])
  @@map("inbound_email")
}

/// A person who can act for a vendor. Many per vendor (a title company has
/// several escrow officers), which is why this is a join and not a scalar on
/// Vendor — the mistake Engagement.guestUserId would have forced.
model VendorUser {
  id        String   @id @default(uuid())
  vendorId  String   @map("vendor_id")
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "owner" (created it) or "member". Vendor-internal, unrelated to tenant roles.
  role      String   @default("owner")
  createdAt DateTime @default(now())

  @@unique([vendorId, userId])
  @@index([userId])
  @@map("vendor_user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

/// better-auth twoFactor plugin storage (TOTP secret + hashed backup codes).
model TwoFactor {
  id                      String    @id
  userId                  String    @map("user_id")
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret                  String
  backupCodes             String    @map("backup_codes")
  verified                Boolean   @default(false)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until")

  @@index([userId])
  @@map("two_factor")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// --- Better Auth organization plugin (Organization = Freehold tenant) ---

/// Cloud plan tier. Self-hosted installs stay on FREE semantics-wise but are
/// never limited — limits are enforced only when FREEHOLD_CLOUD=1.
enum PlanTier {
  FREE
  PRO
  BUSINESS
}

model Organization {
  id                      String                  @id
  name                    String
  slug                    String                  @unique
  logo                    String?
  metadata                String?
  planTier                PlanTier                @default(FREE) @map("plan_tier")
  seatLimit               Int                     @default(2) @map("seat_limit")
  aiExtractionsUsed       Int                     @default(0) @map("ai_extractions_used")
  /// Voice-search sessions started this billing month. Unlike the lifetime
  /// extraction credits, voice recurs, so the window rolls: once
  /// voiceQuotaResetAt is in the past the counter starts over.
  voiceSessionsUsed       Int                     @default(0) @map("voice_sessions_used")
  voiceQuotaResetAt       DateTime?               @map("voice_quota_reset_at")
  /// Prepaid AI credits (Cloud Free only). Spending one credit permanently
  /// unlocks pro AI features on a single transaction. Paid tiers ignore this —
  /// their AI is unmetered. New workspaces start with 2; topped up by purchase
  /// or coupon. The balance of record; every change is mirrored to CreditLedger.
  aiCredits               Int                     @default(2) @map("ai_credits")
  /// Operator override for this tenant's contract-extraction model. When set,
  /// heavy or costly workspaces run extraction on a cheaper model instead of
  /// the default. Null = platform default (FREEHOLD_AI_MODEL / Opus).
  aiModelOverride         String?                 @map("ai_model_override")
  /// Admin setting: when true, members only see contacts they own.
  restrictContactsToOwner Boolean                 @default(false) @map("restrict_contacts_to_owner")
  /// Per-tenant Follow Up Boss connection: {enc:{...}, importedAt?, importedCount?}.
  /// API key encrypted with VAULT_MASTER_KEY.
  fubConfig               Json?                   @map("fub_config")
  /// Per-tenant Twenty CRM connection: {url, enc:{...}, importedAt?, importedCount?}.
  twentyConfig            Json?                   @map("twenty_config")
  /// Tenant wording for transaction sides: {buy, sell} — e.g. sell side vs list side.
  sideLabels              Json?                   @map("side_labels")
  /// Tenant overrides for automated email templates: {intro:{subject,body}, postClose:{subject,body}}.
  emailTemplates          Json?                   @map("email_templates")
  /// Workspace email signature + global footer: {signature, footer} —
  /// appended to every outgoing branded email.
  emailSettings           Json?                   @map("email_settings")
  /// Tenant mini-site at <slug>.<root>: {published, tagline, about, phone, email, services, showRegistration}.
  siteConfig              Json?                   @map("site_config")
  /// Look-and-feel choices, all optional with sensible defaults:
  /// {theme, portalFont, priorityColors:{HIGH,CRITICAL}, rowHighlight:{scope,color}}.
  /// theme + portalFont style the client portal; priorityColors + rowHighlight
  /// tint the internal task lists. Null = Freehold defaults (forest/green).
  appearanceConfig        Json?                   @map("appearance_config")
  /// Per-tenant Documenso connection: {url, enc:{ciphertext,iv,tag,wrappedKey,wrapIv,wrapTag,keyVersion}}.
  /// Token encrypted with VAULT_MASTER_KEY; null = use server-wide env default.
  documensoConfig         Json?                   @map("documenso_config")
  /// Per-tenant document storage: {provider:"S3", endpoint, region, bucket,
  /// accessKeyEnc:{...}, secretKeyEnc:{...}}. Keys encrypted with VAULT_MASTER_KEY.
  /// New documents route here; null = platform default (env S3) or Postgres bytes.
  storageConfig           Json?                   @map("storage_config")
  stripeCustomerId        String?                 @map("stripe_customer_id")
  stripeSubscriptionId    String?                 @map("stripe_subscription_id")
  /// Last-known Stripe subscription status (active, trialing, past_due, unpaid, canceled).
  /// Mirrored from webhooks for operator visibility; null = never had a paid sub.
  subscriptionStatus      String?                 @map("subscription_status")
  /// Set when the workspace is locked for a failed renewal. Data is preserved;
  /// the dashboard is gated until payment is updated. Cleared when Stripe reports paid again.
  billingSuspendedAt      DateTime?               @map("billing_suspended_at")
  /// Complimentary (comped) plan grant, independent of Stripe. When set (and not
  /// past compExpiresAt), it overrides planTier — a full plan with no checkout/charge.
  compTier                PlanTier?               @map("comp_tier")
  /// When the comp ends; null = no expiry (until an operator revokes it).
  compExpiresAt           DateTime?               @map("comp_expires_at")
  createdAt               DateTime                @default(now())
  members                 Member[]
  invitations             Invitation[]
  clients                 Client[]
  contacts                Contact[]
  transactions            Transaction[]
  parties                 TransactionParty[]
  tasks                   Task[]
  actionPlans             ActionPlan[]
  actionPlanTasks         ActionPlanTask[]
  actionPlanDocuments     ActionPlanDocument[]
  requiredDocuments       TransactionRequiredDocument[]
  complianceChecklists    ComplianceChecklist[]
  complianceItems         ComplianceItem[]
  transactionCompliances  TransactionCompliance[]
  complianceSlots         ComplianceSlot[]
  userLicenses            UserLicense[]
  transactionAssignees    TransactionAssignee[]
  states                  TenantState[]
  paymentRequests         PaymentRequest[]
  paymentRequestItems     PaymentRequestItem[]
  engagementsHired        Engagement[]            @relation("EngagementHirer")
  engagementsProvided     Engagement[]            @relation("EngagementVendor")
  supportTickets          SupportTicket[]
  supportTicketReplies    SupportTicketReply[]
  vendorConnections       VendorConnection[]
  vendorOrders            VendorOrder[]
  /// What happens when a file sits in a license-required state with nobody
  /// licensed assigned: "warn" (save it, flag it everywhere) or "block"
  /// (refuse the write). Deliberately a tenant choice — TCs routinely open a
  /// file before deciding who runs it.
  licenseEnforcement      String                  @default("warn") @map("license_enforcement")
  /// Opt-in vendor-directory listing, published to other workspaces and to the
  /// public syndication feed: {listed, blurb, contactEmail, specializations[],
  /// software[], availability, pricingModel, yearsExperience, remote}. States
  /// covered come from TenantState. Null or listed:false = not listed anywhere.
  directoryConfig         Json?                   @map("directory_config")
  /// Per-tenant ERPNext connection: {url, itemCode, keyEnc:{...},
  /// secretEnc:{...}}. API key + secret encrypted with VAULT_MASTER_KEY.
  /// Null = client invoices are kept in Freehold only.
  erpnextConfig           Json?                   @map("erpnext_config")
  /// Workspace billing policy: {mode, depositPercent, lateFee:{...},
  /// defaultFeeCents}. Every key overridable per client (Client.billingConfig).
  /// Parsed/validated by lib/billing-policy.ts; unset keys fall back there.
  billingDefaults         Json?                   @map("billing_defaults")
  documents               Document[]
  extractions             ContractExtraction[]
  extractionFields        ExtractionField[]
  templates               DocTemplate[]
  envelopes               SignatureEnvelope[]
  portalLinks             PortalLink[]
  vaultCredentials        VaultCredential[]
  vaultAccessLogs         VaultAccessLog[]
  auditLogs               AuditLog[]
  transactionActivity     TransactionActivity[]
  contactNotes            ContactNote[]
  clientNotes             ClientNote[]
  clientAgents            ClientAgent[]
  emailTemplatesLib       EmailTemplate[]
  intakeSubmissions       IntakeSubmission[]
  emails                  Email[]
  apiKeys                 ApiKey[]
  invoices                Invoice[]
  invoiceLines            InvoiceLine[]
  invoicePayments         InvoicePayment[]
  clientCreditEntries     ClientCreditEntry[]
  webhookEndpoints        WebhookEndpoint[]

  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  /// Compliance review authority, assigned from the Team page. null = default
  /// by role (owner/admin hold top authority, member submits only); 0 =
  /// submitter only even for an admin; 1..N = approves at levels up to N.
  complianceTier Int?         @map("compliance_tier")
  /// Billing authority, assigned from the Team page. null = default by role
  /// (owner/admin see and manage everything incl. team comp; member sees
  /// nothing). "view" reads invoices and revenue; "manage" also records
  /// money; "full" additionally sees team payout/comp data. Resolved by
  /// lib/billing-access.ts.
  billingRole    String?      @map("billing_role")
  /// Capability token for this person's subscribe-once personal calendar feed
  /// in this workspace (a user in two tenants gets a separate feed per one,
  /// same as everything else here — roles and assignments don't cross tenants).
  /// Generated lazily on first request for the link; null until then.
  calendarToken  String?      @unique @map("calendar_token")
  /// When this person last looked at the Support page in this workspace. Any
  /// operator/Slack reply newer than this counts as unread, driving the
  /// sidebar's "new message" badge. Null = never opened it.
  supportSeenAt  DateTime?    @map("support_seen_at")
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invitation")
}

// --- Freehold domain (row-level security enforced; see init migration) ---

enum ClientType {
  AGENT
  BROKERAGE
  TITLE
  LENDER
  OTHER
}

/// The tenant's customer — the agent, brokerage, title company, or lender they
/// serve. Transactions, vault credentials, portal branding, and invoicing all
/// attach here in later stages.
model Client {
  id                    String               @id @default(uuid())
  tenantId              String               @map("tenant_id")
  tenant                Organization         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type                  ClientType           @default(AGENT)
  name                  String
  email                 String?
  phone                 String?
  notes                 String?
  /// Per-client e-signature provider; null = tenant default (FREEHOLD_ESIGN_DEFAULT env, else MANUAL).
  esignProvider         EsignProvider?       @map("esign_provider")
  /// Per-client automated-email switches: {intro?: boolean, postClose?: boolean}; missing = on.
  emailPrefs            Json?                @map("email_prefs")
  /// This agent's own SkySlope API credentials, so their transactions can be
  /// read on their behalf: {accessKeyEnc:{...}, secretEnc:{...}, label?,
  /// connectedAt, verifiedAt?}. Envelope-encrypted with VAULT_MASTER_KEY.
  /// One per client because SkySlope issues AccessKey/Secret per user, not
  /// per brokerage. Null = not connected.
  skyslopeConfig        Json?                @map("skyslope_config")
  /// Per-client staleness thresholds, overriding the workspace defaults:
  /// {staleDays?, criticalWindowDays?, criticalStaleDays?}. Some clients want
  /// to hear about a quiet file sooner than others. Unset keys fall back to
  /// the defaults in lib/transaction-alerts.ts.
  alertConfig           Json?                @map("alert_config")
  /// What this client is normally charged per file; auto-fills each new
  /// transaction's expectedFeeCents. Null = the workspace default fee.
  defaultFeeCents       Int?                 @map("default_fee_cents")
  /// Per-client billing-policy overrides ({mode, lateFee, ...}); unset keys
  /// fall back to Organization.billingDefaults via lib/billing-policy.ts.
  billingConfig         Json?                @map("billing_config")
  /// Compliance: every transaction for this client follows the assigned
  /// checklist. Switch complianceEnabled off to exempt the client entirely
  /// (leaving no checklist assigned is also inert).
  complianceEnabled     Boolean              @default(true) @map("compliance_enabled")
  complianceChecklistId String?              @map("compliance_checklist_id")
  complianceChecklist   ComplianceChecklist? @relation(fields: [complianceChecklistId], references: [id], onDelete: SetNull)
  isSample              Boolean              @default(false)
  transactions          Transaction[]
  credentials           VaultCredential[]
  portalLinks           PortalLink[]
  clientNotes           ClientNote[]
  agents                ClientAgent[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  invoices              Invoice[]
  creditEntries         ClientCreditEntry[]

  @@index([tenantId])
  @@map("client")
}

enum TransactionStatus {
  LISTING
  UNDER_CONTRACT
  PENDING
  CLOSED
  CANCELLED
}

enum TransactionSide {
  BUY_SIDE
  SELL_SIDE
  DUAL
}

enum PartyRole {
  BUYER
  SELLER
  BUYER_AGENT
  LISTING_AGENT
  LENDER
  TITLE_COMPANY
  INSPECTOR
  APPRAISER
  ATTORNEY
  OTHER
}

enum TaskStatus {
  OPEN
  DONE
  SKIPPED
}

enum DateAnchor {
  CONTRACT_DATE
  CLOSE_DATE
}

enum TaskPriority {
  NORMAL
  HIGH
  CRITICAL
}

/// CRM record — buyers, sellers, agents, lenders, vendors. Category is free
/// text on purpose (competitors allow custom categories).
/// Dual-person CRM record: one entry holds two related people (a couple, a
/// client + assistant) so mailings and document merges address both at once.
/// `name` stays the denormalized display name ("Jordan & Casey Bell") used by
/// pickers and party lists; structured person fields live alongside it, and
/// the secondary person + overflow phones/emails live in JSON.
/// A buyer or seller intake form submitted through a client portal.
/// Uploaded files become Document rows on the transaction; `data` holds the
/// answered fields keyed by field id.
model IntakeSubmission {
  id            String       @id @default(uuid())
  tenantId      String       @map("tenant_id")
  tenant        Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId String       @map("transaction_id")
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  portalLinkId  String?      @map("portal_link_id")
  /// BUY_SIDE | SELL_SIDE
  side          String
  data          Json
  documentIds   String[]     @default([]) @map("document_ids")
  createdAt     DateTime     @default(now())

  @@index([tenantId, transactionId])
  @@map("intake_submission")
}

/// Which agents (contacts) work under a managed client (team/brokerage).
/// Portal access is granted per agent from the client page; agents without
/// a portal simply have no portal_link row.
model ClientAgent {
  id        String       @id @default(uuid())
  tenantId  String       @map("tenant_id")
  tenant    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId  String       @map("client_id")
  client    Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId String       @map("contact_id")
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([clientId, contactId])
  @@index([tenantId])
  @@map("client_agent")
}

model Contact {
  id             String             @id @default(uuid())
  tenantId       String             @map("tenant_id")
  tenant         Organization       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId        String?
  owner          User?              @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  name           String
  email          String?
  phone          String?
  category       String             @default("Other")
  rating         Int?
  touchDate      DateTime?          @map("touch_date") @db.Date
  notes          String?
  // --- dual-person CRM fields ---
  personTitle    String?            @map("person_title")
  firstName      String?            @map("first_name")
  middleName     String?            @map("middle_name")
  lastName       String?            @map("last_name")
  jobTitle       String?            @map("job_title")
  company        String?
  website        String?
  workPhone      String?            @map("work_phone")
  fax            String?
  /// Secondary person (spouse/assistant): {title,first,middle,last,jobTitle,cell,workPhone,email}
  secondary      Json?
  /// Overflow contact points: {phones: string[], emails: string[]}
  extraContacts  Json?              @map("extra_contacts")
  categories     String[]           @default([])
  /// Relationship grade A-D; drives the auto-prospecting cadence.
  grade          String?
  /// When this contact is next due in the prospecting queue.
  nextTouchAt    DateTime?          @map("next_touch_at") @db.Date
  homeAddress    Json?              @map("home_address")
  workAddress    Json?              @map("work_address")
  referredById   String?            @map("referred_by_id")
  referredBy     Contact?           @relation("ContactReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals      Contact[]          @relation("ContactReferrals")
  referralSource String?            @map("referral_source")
  referralDate   DateTime?          @map("referral_date") @db.Date
  /// BUYER | SELLER | NONE
  leadType       String?            @map("lead_type")
  /// Buyer: {cultivating,location,range,income}; Seller: {cultivating,address,listPrice,netProceeds}
  leadDetails    Json?              @map("lead_details")
  /// {birthday:{m,d,y?}, birthdayAlt, weddingAnniversary, purchaseAnniversary}
  touchDates     Json?              @map("touch_dates")
  photoUrl       String?            @map("photo_url")
  /// {facebook, instagram, linkedin, x, youtube, other}
  socialLinks    Json?              @map("social_links")
  isSample       Boolean            @default(false)
  parties        TransactionParty[]
  contactNotes   ContactNote[]
  emails         Email[]
  tasks          Task[]
  credentials    VaultCredential[]
  agentOf        ClientAgent[]
  portalLinks    PortalLink[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([tenantId, category])
  @@index([tenantId, nextTouchAt])
  @@map("contact")
}

/// Transactional email with reply capture. Outbound goes through Resend from
/// the tenant's identity on the shared mail domain; each message carries a
/// per-thread reply token, and inbound replies post back via webhook and
/// attach here. This IS the mailbox — storage is rows + document attachments.
enum EmailDirection {
  OUTBOUND
  INBOUND
}

/// Reply-token → tenant mapping for the inbound webhook. Deliberately has NO
/// row-level security (same reasoning as portal_link): the webhook arrives
/// with no tenant context and the unguessable token IS the capability; the
/// email bodies themselves stay in the RLS-protected email table.
model EmailThread {
  token         String   @id
  tenantId      String   @map("tenant_id")
  transactionId String?  @map("transaction_id")
  contactId     String?  @map("contact_id")
  /// Set when the thread is a vendor order emailed to an unregistered vendor;
  /// their reply routes to the AI-proposal path instead of plain thread capture.
  orderId       String?  @map("order_id")
  providerId    String?  @map("provider_id")
  createdAt     DateTime @default(now())

  @@index([providerId])
  @@map("email_thread")
}

model Email {
  id            String         @id @default(uuid())
  tenantId      String         @map("tenant_id")
  tenant        Organization   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId String?
  transaction   Transaction?   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  contactId     String?        @map("contact_id")
  contact       Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  direction     EmailDirection
  fromAddr      String         @map("from_addr")
  toAddr        String         @map("to_addr")
  subject       String
  bodyText      String         @map("body_text")
  /// Reply capture token; inbound mail to reply+<token>@ matches the thread.
  replyToken    String?        @map("reply_token")
  providerId    String?        @map("provider_id")
  status        String         @default("SENT")
  createdAt     DateTime       @default(now())

  @@index([tenantId, transactionId, createdAt])
  @@index([replyToken])
  @@map("email")
}

/// Notes a TC keeps about a client (the backend client page).
model ClientNote {
  id        String       @id @default(uuid())
  tenantId  String       @map("tenant_id")
  tenant    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId  String       @map("client_id")
  client    Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId  String?      @map("author_id")
  body      String
  createdAt DateTime     @default(now())

  @@index([tenantId, clientId, createdAt])
  @@map("client_note")
}

/// Timestamped CRM notes on a contact (the Notes tab + quick-add).
model ContactNote {
  id        String       @id @default(uuid())
  tenantId  String       @map("tenant_id")
  tenant    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId String       @map("contact_id")
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  authorId  String?      @map("author_id")
  body      String
  createdAt DateTime     @default(now())

  @@index([tenantId, contactId, createdAt])
  @@map("contact_note")
}

/// The central object: one closing. Belongs to a tenant, optionally to the
/// client (agent/brokerage) the tenant serves it for.
model Transaction {
  id                String                  @id @default(uuid())
  tenantId          String                  @map("tenant_id")
  tenant            Organization            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId          String?
  client            Client?                 @relation(fields: [clientId], references: [id], onDelete: SetNull)
  status            TransactionStatus       @default(UNDER_CONTRACT)
  side              TransactionSide         @default(BUY_SIDE)
  propertyAddress   String                  @map("property_address")
  city              String?
  state             String?
  zip               String?
  purchasePrice     Int?                    @map("purchase_price")
  listPrice         Int?                    @map("list_price")
  listDate          DateTime?               @map("list_date") @db.Date
  onMarketDate      DateTime?               @map("on_market_date") @db.Date
  expireDate        DateTime?               @map("expire_date") @db.Date
  mlsId             String?                 @map("mls_id")
  /// The co-agent is a Client (managed agent); workspace users are assigned
  /// through TransactionAssignee rows.
  coAgentClientId   String?                 @map("co_agent_client_id")
  assignees         TransactionAssignee[]
  /// Commission breakdown: {listPct, buyPct, note} — gross computes from price.
  payout            Json?
  emails            Email[]
  /// Contract-governed date changes awaiting an executed amendment:
  /// {closeDate?: "YYYY-MM-DD", contractDate?: "YYYY-MM-DD"}
  proposedDates     Json?                   @map("proposed_dates")
  contractDate      DateTime?               @map("contract_date") @db.Date
  closeDate         DateTime?               @map("close_date") @db.Date
  /// Critical dates, in escalation priority order: closing (above), then
  /// mortgage commitment, then the inspection deadline. Inside the alert
  /// window before any of these, a file is called stale far sooner — see
  /// lib/transaction-alerts.ts. Kept as first-class columns (not tasks) so
  /// the alert query never depends on task titles matching a phrase.
  mortgageCommitmentDate DateTime?          @map("mortgage_commitment_date") @db.Date
  inspectionDeadlineDate DateTime?          @map("inspection_deadline_date") @db.Date
  /// What the tenant expects to charge for this file — the anchor the trust
  /// surface compares actual billing against. Auto-filled from the client's
  /// default fee (else the workspace default) when the file is created;
  /// editable per file. 0 = deliberately no charge; null = never set.
  expectedFeeCents  Int?                    @map("expected_fee_cents")
  notes             String?
  customFields      Json?                   @map("custom_fields")
  /// Parties pulled from the contract (buyer, seller, attorneys, title, agents)
  /// as a permanent, locked panel — an ordered array of { role, value }. Kept
  /// out of customFields so they can't be casually deleted, and distinct from
  /// the CRM-linked `parties` relation (this is text, no Contact rows).
  contractParties   Json?                   @map("contract_parties")
  /// Per-transaction pro-AI unlock. A Free workspace spends one credit to turn
  /// this on for a single transaction; once on it stays on (contract
  /// extraction, AI classify, in-transaction dictation). Paid tiers are pro
  /// implicitly and never set this.
  proFeaturesEnabled Boolean                @default(false) @map("pro_features_enabled")
  proEnabledAt      DateTime?               @map("pro_enabled_at")
  proEnabledBy      String?                 @map("pro_enabled_by")
  isSample          Boolean                 @default(false)
  parties           TransactionParty[]
  requiredDocuments TransactionRequiredDocument[]
  tasks             Task[]
  documents         Document[]
  extractions       ContractExtraction[]
  envelopes         SignatureEnvelope[]
  portalLinks       PortalLink[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  invoices          Invoice[]
  invoiceLines      InvoiceLine[]
  intakeSubmissions IntakeSubmission[]
  compliance        TransactionCompliance[]
  vendorOrders      VendorOrder[]
  activity          TransactionActivity[]

  @@index([tenantId, status])
  @@map("transaction")
}

// --- Stage 04: client portals + credential vault ---

/// Shareable read-only portal access to one transaction. The random token IS
/// the capability — portal pages are unauthenticated by design (TCs text
/// these links to buyers/sellers).
///
/// ⚠️ Deliberately NOT covered by row-level security: the public portal route
/// must resolve a bare token with no tenant context. The table carries only
/// the token, display toggles, and foreign keys; all transaction data is then
/// fetched through withTenant() using the link's own tenant id.
/// Who a portal link serves. CLIENT = buyer/seller simplified view of one
/// transaction; AGENT = the managed-agent portal, scoped to a Client record
/// and covering all of that client's transactions.
enum PortalAudience {
  CLIENT
  AGENT
}

model PortalLink {
  id             String         @id @default(uuid())
  tenantId       String         @map("tenant_id")
  tenant         Organization   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  audience       PortalAudience @default(CLIENT)
  transactionId  String?
  transaction    Transaction?   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  clientId       String?        @map("client_id")
  client         Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId      String?        @map("contact_id")
  contact        Contact?       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  token          String         @unique
  label          String
  showTasks      Boolean        @default(true) @map("show_tasks")
  showDocuments  Boolean        @default(false) @map("show_documents")
  showParties    Boolean        @default(true) @map("show_parties")
  showIntake     Boolean        @default(true) @map("show_intake")
  /// Opt-in: let this client order the workspace's connected vendors from the
  /// portal, and see those orders' status and appointments. Off by default.
  showVendorOrders Boolean      @default(false) @map("show_vendor_orders")
  revokedAt      DateTime?      @map("revoked_at")
  lastAccessedAt DateTime?      @map("last_accessed_at")
  createdAt      DateTime       @default(now())

  @@index([tenantId])
  @@index([transactionId])
  @@map("portal_link")
}

/**
 * Public API keys. Like portal_link, this table deliberately has NO RLS
 * policy: the key hash IS the capability, and the API must look it up
 * before any tenant context exists. Only the SHA-256 hash is stored.
 */
model ApiKey {
  id         String       @id @default(uuid())
  tenantId   String       @map("tenant_id")
  tenant     Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  prefix     String
  hash       String       @unique
  createdAt  DateTime     @default(now())
  lastUsedAt DateTime?    @map("last_used_at")
  revokedAt  DateTime?    @map("revoked_at")

  @@index([tenantId])
  @@map("api_key")
}

/// Global platform configuration, editable from /admin — a single row (there's
/// exactly one Freehold), self-created on first read. No tenant, no RLS: this
/// is operator-only, the same root-table shape as Vendor and ApiKey.
///
/// The founderCall* fields back the homepage voice demo's "call the developer"
/// feature: a kill switch, the cooldown between calls, and the last-call
/// timestamp that cooldown is measured against. founderLastCallAt is claimed
/// with a single conditional UPDATE (see platform-settings.ts) so two visitors
/// racing for the same slot can't both win it.
model PlatformSetting {
  id                         String    @id @default("singleton")
  founderCallsAvailable      Boolean   @default(false) @map("founder_calls_available")
  founderCallCooldownMinutes Int       @default(15) @map("founder_call_cooldown_minutes")
  founderCallSellingPoints   String?   @map("founder_call_selling_points")
  founderLastCallAt          DateTime? @map("founder_last_call_at")
  /// STT/TTS provider+model routed through LiveKit's own hosted inference
  /// (billed per-minute through LiveKit, no vendor key needed) — e.g.
  /// "deepgram/nova-3", "elevenlabs/eleven_turbo_v2_5". Read by the agent on
  /// every session via the same /api/voice/data brief it already fetches, so
  /// a change here takes effect on the very next call, no redeploy. The LLM
  /// stays a fixed direct Anthropic call (Claude isn't in LiveKit's
  /// inference catalog) — not editable here on purpose.
  voiceSttModel              String    @default("deepgram/nova-3") @map("voice_stt_model")
  voiceTtsModel              String    @default("elevenlabs/eleven_turbo_v2_5") @map("voice_tts_model")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  @@map("platform_setting")
}

model WebhookEndpoint {
  id        String       @id @default(uuid())
  tenantId  String       @map("tenant_id")
  tenant    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url       String
  secret    String
  events    String[]
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())

  @@index([tenantId])
  @@map("webhook_endpoint")
}

enum InvoiceStatus {
  /// Being assembled (by hand or by scheduled billing); has no number hold on
  /// the client's attention yet — not sent, not owed, not counted outstanding.
  DRAFT
  SENT
  PAID
  VOID
}

/**
 * Client invoicing: the tenant bills their client through Stripe.
 */
/// A tenant billing their client. Payment-method-agnostic by design: clients
/// pay by check, Zelle, wire, or out of closing proceeds, so Freehold's job is
/// the document, the record, and the follow-up — never the payment rail. No
/// processor is involved; "paid" is whatever the tenant says it is.
model Invoice {
  id            String        @id @default(uuid())
  tenantId      String        @map("tenant_id")
  tenant        Organization  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId      String?
  client        Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  transactionId String?
  transaction   Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  /// Per-tenant sequence, rendered as INV-0001.
  number        Int
  /// Where this invoice actually lives: "freehold" (we are the record) or
  /// "erpnext" (created in the tenant's ERP; status mirrored from there).
  provider      String        @default("freehold")
  /// The Sales Invoice name in their ERPNext, e.g. ACC-SINV-2026-00007.
  externalId    String?       @map("external_id")
  description   String
  /// Denormalized total: always sum(lines.amountCents), recomputed by the one
  /// writer in lib/actions whenever lines change. Kept as a column so list
  /// queries, reports, and the ERPNext mirror never join lines for a total.
  amountCents   Int           @map("amount_cents")
  /// How it's to be paid — "Due at closing", "Net 30", or free text.
  paymentTerms  String?       @map("payment_terms")
  dueDate       DateTime?     @map("due_date") @db.Date
  /// SENT means outstanding; issuing and emailing are separate facts.
  status        InvoiceStatus @default(SENT)
  /// When the invoice email actually went out.
  sentAt        DateTime?     @map("sent_at")
  /// How it was settled — "check #1042 at closing".
  paidNote      String?       @map("paid_note")
  /// The nag: an open task that closes only when the invoice is resolved.
  followUpTaskId String?      @map("follow_up_task_id")
  followUpTask   Task?        @relation(fields: [followUpTaskId], references: [id], onDelete: SetNull)
  lines         InvoiceLine[]
  payments      InvoicePayment[]
  /// Client-credit entries applied against this invoice (kind "applied").
  creditEntries ClientCreditEntry[]
  createdAt     DateTime      @default(now())
  paidAt        DateTime?     @map("paid_at")

  @@unique([tenantId, number])
  @@index([tenantId])
  @@map("invoice")
}

/// One charge on an invoice: the base fee, an up-charge for extra work, a
/// late fee, a deposit toward a file, a discount (negative). Consolidated
/// weekly/monthly invoices carry one line per file, so transactionId lives
/// here as well as on the invoice — the invoice-level link means "this whole
/// invoice is about that file"; the line-level link says which file each
/// charge belongs to, which is what per-file revenue reporting reads.
model InvoiceLine {
  id            String       @id @default(uuid())
  tenantId      String       @map("tenant_id")
  tenant        Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId     String       @map("invoice_id")
  invoice       Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  transactionId String?      @map("transaction_id")
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  /// "service" | "upcharge" | "late_fee" | "deposit" | "adjustment" — a plain
  /// string (like EmailTemplate.category) so new kinds never need a migration.
  kind          String       @default("service")
  description   String
  /// Signed: discounts and credits on an invoice are negative lines.
  amountCents   Int          @map("amount_cents")
  sortOrder     Int          @default(0) @map("sort_order")
  createdAt     DateTime     @default(now())

  @@index([tenantId, invoiceId])
  @@index([tenantId, transactionId])
  @@map("invoice_line")
}

/// Money held on a client's account rather than against a specific invoice —
/// retainers and pre-payments from long-standing clients. Append-only:
/// balance = sum(amountCents), corrections are new entries, never edits.
/// Applying credit to an invoice writes an "applied" entry here (negative)
/// and a paired InvoicePayment (source "credit") in the same transaction, so
/// both sides of the movement are on the books.
model ClientCreditEntry {
  id             String       @id @default(uuid())
  tenantId       String       @map("tenant_id")
  tenant         Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId       String       @map("client_id")
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Signed: deposits positive; "applied" / "refund" negative.
  amountCents    Int          @map("amount_cents")
  /// "deposit" | "applied" | "refund" | "adjustment".
  kind           String
  method         String?
  reference      String?
  note           String?
  /// For "applied" entries: the invoice the credit went to.
  invoiceId      String?      @map("invoice_id")
  invoice        Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payment        InvoicePayment?
  /// Denormalized (auth-table boundary — same reasoning as TransactionActivity).
  recordedByName String?      @map("recorded_by_name")
  receivedAt     DateTime     @default(now()) @map("received_at")
  createdAt      DateTime     @default(now())

  @@index([tenantId, clientId])
  @@map("client_credit_entry")
}

/// The incoming-money ledger for an invoice. Append-only: a bounced check is
/// a reversal entry (negative amount pointing at the original), never an
/// edit or delete — the books always show what happened, in order. Partial
/// payments are just entries smaller than the balance. ERPNext-provider
/// invoices don't use this ledger; their ERP is the record and Freehold only
/// mirrors the status.
model InvoicePayment {
  id             String       @id @default(uuid())
  tenantId       String       @map("tenant_id")
  tenant         Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId      String       @map("invoice_id")
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// Signed: payments positive, reversals negative.
  amountCents    Int          @map("amount_cents")
  /// "Check", "Wire", "Zelle", "Closing proceeds", … free text.
  method         String?
  /// Check number, wire memo — whatever identifies it at the bank.
  reference      String?
  note           String?
  /// "direct" | "credit" (paid from the client's on-account balance).
  source         String       @default("direct")
  creditEntryId  String?      @unique @map("credit_entry_id")
  creditEntry    ClientCreditEntry? @relation(fields: [creditEntryId], references: [id], onDelete: SetNull)
  /// A reversal points at the entry it reverses.
  reversesId     String?      @map("reverses_id")
  reverses       InvoicePayment?  @relation("PaymentReversal", fields: [reversesId], references: [id], onDelete: SetNull)
  reversedBy     InvoicePayment[] @relation("PaymentReversal")
  recordedByName String?      @map("recorded_by_name")
  /// When the money actually arrived (editable), vs createdAt (when recorded).
  receivedAt     DateTime     @default(now()) @map("received_at")
  createdAt      DateTime     @default(now())

  @@index([tenantId, invoiceId])
  @@map("invoice_payment")
}

enum VaultAction {
  CREATED
  UPDATED
  REVEALED
  DELETED
}

/// Envelope-encrypted third-party credential (MLS, lender portals, e-sign accounts)
/// stored on a client's behalf. The secret never exists in plaintext at rest:
/// AES-256-GCM under a per-credential data key, itself wrapped by
/// VAULT_MASTER_KEY (see packages/vault). Reveals are audited — Freehold
/// stores and audits credentials; it never logs into anything automatically.
model VaultCredential {
  id         String           @id @default(uuid())
  tenantId   String           @map("tenant_id")
  tenant     Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId   String?
  client     Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  contactId  String?          @map("contact_id")
  contact    Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  system     String
  username   String
  url        String?
  notes      String?
  ciphertext String
  iv         String
  tag        String
  wrappedKey String           @map("wrapped_key")
  wrapIv     String           @map("wrap_iv")
  wrapTag    String           @map("wrap_tag")
  keyVersion Int              @default(1) @map("key_version")
  accessLogs VaultAccessLog[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([tenantId])
  @@map("vault_credential")
}

/// "This file is being worked" — one row per meaningful action a user takes
/// on a transaction (task completed, document uploaded, email sent, dates
/// changed). Deliberately separate from AuditLog: that table is the low-volume
/// compliance record of sensitive events and is read unfiltered by the
/// Settings audit view, so routine work would drown it. This one is
/// high-volume, transaction-scoped, and indexed for the hot "when was this
/// last touched, by whom" lookup that drives every staleness alert.
///
/// actorName is denormalized on purpose: `user` is a Better Auth table
/// outside tenant RLS, so a briefing or dashboard row must never need to join
/// across that boundary just to print who did something.
model TransactionActivity {
  id            String       @id @default(uuid())
  tenantId      String       @map("tenant_id")
  tenant        Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId String       @map("transaction_id")
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  actorId       String?      @map("actor_id")
  actorName     String       @map("actor_name")
  /// Stable machine key (task.completed, document.uploaded, …) for grouping.
  action        String
  /// Human sentence shown in the UI, the briefing email, and the PDF.
  summary       String
  createdAt     DateTime     @default(now())

  @@index([tenantId, transactionId, createdAt])
  @@map("transaction_activity")
}

model AuditLog {
  id          String       @id @default(uuid())
  tenantId    String       @map("tenant_id")
  tenant      Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId     String?      @map("actor_id")
  actorEmail  String?      @map("actor_email")
  action      String
  subjectType String?      @map("subject_type")
  subjectId   String?      @map("subject_id")
  summary     String
  createdAt   DateTime     @default(now())

  @@index([tenantId, createdAt])
  @@map("audit_log")
}

model VaultAccessLog {
  id           String           @id @default(uuid())
  tenantId     String           @map("tenant_id")
  tenant       Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  credentialId String?
  credential   VaultCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  userId       String
  action       VaultAction
  detail       String?
  createdAt    DateTime         @default(now())

  @@index([tenantId, createdAt])
  @@map("vault_access_log")
}

model TransactionParty {
  id            String       @id @default(uuid())
  tenantId      String       @map("tenant_id")
  tenant        Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  contactId     String
  contact       Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  role          PartyRole
  createdAt     DateTime     @default(now())

  @@unique([transactionId, contactId, role])
  @@index([tenantId])
  @@map("transaction_party")
}

model Task {
  id              String       @id @default(uuid())
  tenantId        String       @map("tenant_id")
  tenant          Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId   String?
  transaction     Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  title           String
  notes           String?
  dueDate         DateTime?    @map("due_date") @db.Date
  status          TaskStatus   @default(OPEN)
  priority        TaskPriority @default(NORMAL)
  /// Provenance for domino recomputation: tasks instantiated from an action
  /// plan keep their anchor + offset so a confirmed date change re-dates them.
  anchor          DateAnchor?
  offsetDays      Int?         @map("offset_days")
  /// Manually re-dated tasks opt out of recomputation.
  dueDateEdited   Boolean      @default(false) @map("due_date_edited")
  /// Set when this task exists to get a date amendment executed ("closeDate"/"contractDate").
  proposedFor     String?      @map("proposed_for")
  /// Carried from the action-plan template task: default email template.
  emailTemplateId String?      @map("email_template_id")
  autoSendEmail   Boolean      @default(false) @map("auto_send_email")
  completedAt     DateTime?    @map("completed_at")
  contactId       String?      @map("contact_id")
  contact         Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  /// Per-audience portal visibility, toggled from the transaction screen.
  visibleToAgent  Boolean      @default(true) @map("visible_to_agent")
  visibleToClient Boolean      @default(true) @map("visible_to_client")
  assigneeId      String?
  assignee        User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  sortOrder       Int          @default(0) @map("sort_order")
  isSample        Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  invoiceFollowUps Invoice[]

  @@index([tenantId, status, dueDate])
  @@map("task")
}

/// Reusable checklist template ("Texas buy-side closing, 30 tasks").
model ActionPlan {
  id          String           @id @default(uuid())
  tenantId    String           @map("tenant_id")
  tenant      Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isSample    Boolean          @default(false)
  tasks       ActionPlanTask[]
  documents   ActionPlanDocument[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([tenantId])
  @@map("action_plan")
}

/// A document a plan expects on the file — the checklist template. Applying the
/// plan seeds one TransactionRequiredDocument per row alongside the tasks.
model ActionPlanDocument {
  id           String     @id @default(uuid())
  tenantId     String     @map("tenant_id")
  tenant       Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actionPlanId String     @map("action_plan_id")
  actionPlan   ActionPlan @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  label        String
  sortOrder    Int        @default(0) @map("sort_order")

  @@index([tenantId])
  @@map("action_plan_document")
}

model ActionPlanTask {
  id              String       @id @default(uuid())
  tenantId        String       @map("tenant_id")
  tenant          Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actionPlanId    String
  actionPlan      ActionPlan   @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  title           String
  anchor          DateAnchor   @default(CLOSE_DATE)
  offsetDays      Int          @default(0) @map("offset_days")
  assigneeRole    String?      @map("assignee_role")
  /// Default email template: instantiated tasks open compose with it ready.
  emailTemplateId String?      @map("email_template_id")
  /// Auto-send the template to the client when the task is completed.
  autoSendEmail   Boolean      @default(false) @map("auto_send_email")
  priority        TaskPriority @default(NORMAL)
  /// Days before the due date to remind the assignee; null disables the reminder.
  reminderDays    Int?         @map("reminder_days")
  sortOrder       Int          @default(0) @map("sort_order")

  @@index([tenantId])
  @@map("action_plan_task")
}

/// A named set of documents a transaction must carry to pass compliance
/// (standard compliance checklist). Distinct from ActionPlan, which produces
/// dated *tasks*; this defines required *documents*. Assigned per Client, so
/// every file for that client inherits the same rules.
model ComplianceChecklist {
  id          String                  @id @default(uuid())
  tenantId    String                  @map("tenant_id")
  tenant      Organization            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// How many levels of reviewer sign-off each document needs (1 = a single
  /// reviewer approves; 2+ = it climbs the ladder).
  approvalLevels Int                  @default(1) @map("approval_levels")
  isSample    Boolean                 @default(false)
  items       ComplianceItem[]
  clients     Client[]
  instances   TransactionCompliance[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([tenantId])
  @@map("compliance_checklist")
}

/// Overall state of one compliance round on a transaction.
enum ComplianceStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
}

/// State of a single required document within a compliance round.
enum ComplianceSlotStatus {
  MISSING
  ATTACHED
  SUBMITTED
  APPROVED
  RETURNED
}

/// A checklist instantiated onto one transaction — a snapshot taken when it was
/// applied, so later edits to the template never rewrite a file already under
/// review. A transaction can carry several rounds; the newest is current, which
/// is how a file gets a fresh checklist version part-way through.
model TransactionCompliance {
  id            String               @id @default(uuid())
  tenantId      String               @map("tenant_id")
  tenant        Organization         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId String               @map("transaction_id")
  transaction   Transaction          @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  /// Source template; null if the checklist was later deleted.
  checklistId   String?              @map("checklist_id")
  checklist     ComplianceChecklist? @relation(fields: [checklistId], references: [id], onDelete: SetNull)
  /// Snapshot of the checklist name at instantiation.
  checklistName String               @map("checklist_name")
  /// Snapshot of the checklist's approval-levels setting at instantiation.
  approvalLevels Int                 @default(1) @map("approval_levels")
  version       Int                  @default(1)
  isCurrent     Boolean              @default(true) @map("is_current")
  status        ComplianceStatus     @default(DRAFT)
  submittedAt   DateTime?            @map("submitted_at")
  submittedById String?              @map("submitted_by_id")
  reviewedAt    DateTime?            @map("reviewed_at")
  reviewedById  String?              @map("reviewed_by_id")
  slots         ComplianceSlot[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([tenantId])
  @@index([transactionId])
  @@map("transaction_compliance")
}

/// One required document within a compliance round: which file satisfies it and
/// where it stands in review.
model ComplianceSlot {
  id           String                @id @default(uuid())
  tenantId     String                @map("tenant_id")
  tenant       Organization          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  complianceId String                @map("compliance_id")
  compliance   TransactionCompliance @relation(fields: [complianceId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  required     Boolean               @default(true)
  sortOrder    Int                   @default(0) @map("sort_order")
  /// The document satisfying this slot; cleared if that document is deleted.
  documentId   String?               @map("document_id")
  document     Document?             @relation(fields: [documentId], references: [id], onDelete: SetNull)
  status       ComplianceSlotStatus  @default(MISSING)
  /// Highest review level that has signed off so far. APPROVED only once it
  /// reaches the round's approvalLevels; reset by a return or a file swap.
  approvedTier Int                   @default(0) @map("approved_tier")
  /// Why a reviewer sent it back.
  reviewNote   String?               @map("review_note")
  reviewedAt   DateTime?             @map("reviewed_at")
  reviewedById String?               @map("reviewed_by_id")
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([tenantId])
  @@index([complianceId])
  @@map("compliance_slot")
}

/// Lifecycle of one workspace covering files for another.
enum EngagementStatus {
  REQUESTED
  ACTIVE
  DECLINED
  ENDED
}

/// One workspace contracting another to cover files — vacation, overflow, a
/// specialty they don't handle. Found through the directory.
///
/// The vendor's chosen person joins the hiring workspace as a `guest` Member:
/// a real, revocable membership that sees only the transactions they are
/// assigned to. Nothing is copied between workspaces and no data is synced —
/// the file never leaves the workspace that owns it.
model Engagement {
  id             String           @id @default(uuid())
  /// The workspace that needs the coverage and owns the files.
  tenantId       String           @map("tenant_id")
  tenant         Organization     @relation("EngagementHirer", fields: [tenantId], references: [id], onDelete: Cascade)
  /// The workspace providing it.
  vendorTenantId String           @map("vendor_tenant_id")
  vendorTenant   Organization     @relation("EngagementVendor", fields: [vendorTenantId], references: [id], onDelete: Cascade)
  status         EngagementStatus @default(REQUESTED)
  /// What the hiring workspace is asking for.
  note           String?
  /// The vendor user given guest access, chosen when they accept.
  guestUserId    String?          @map("guest_user_id")
  guestUser      User?            @relation(fields: [guestUserId], references: [id], onDelete: SetNull)
  requestedById  String?          @map("requested_by_id")
  respondedAt    DateTime?        @map("responded_at")
  endedAt        DateTime?        @map("ended_at")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([tenantId])
  @@index([vendorTenantId])
  @@map("engagement")
}

/// Where a user's pay request stands. Freehold tracks what is owed and
/// produces the statement; the money itself moves however the business
/// already pays people.
enum PaymentRequestStatus {
  REQUESTED
  PAID
}

/// A user asking to be paid for work already assigned to them. The tenant
/// sets a fee per assignment; the user submits the ones that are due (company
/// policy decides whether that's at order time or at closing — Freehold
/// doesn't impose either). The itemized request is the statement.
model PaymentRequest {
  id          String               @id @default(uuid())
  tenantId    String               @map("tenant_id")
  tenant      Organization         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String               @map("user_id")
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      PaymentRequestStatus @default(REQUESTED)
  /// What the requester wants the payer to know.
  note        String?
  requestedAt DateTime             @default(now()) @map("requested_at")
  paidAt      DateTime?            @map("paid_at")
  paidById    String?              @map("paid_by_id")
  /// How it was settled — "check #1042", "ACH 7/22".
  paidNote    String?              @map("paid_note")
  items       PaymentRequestItem[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([tenantId])
  @@index([tenantId, userId])
  @@map("payment_request")
}

/// One transaction on a pay request. Address and fee are snapshotted so a
/// statement still reads correctly after the assignment is removed or its fee
/// changes. The unique assignee_id is what stops the same work being billed
/// twice — enforced by the database, not by a check that could be raced.
model PaymentRequestItem {
  id            String               @id @default(uuid())
  tenantId      String               @map("tenant_id")
  tenant        Organization         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestId     String               @map("request_id")
  request       PaymentRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  assigneeId    String?              @unique @map("assignee_id")
  assignee      TransactionAssignee? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  /// Snapshot, for linking back when the assignment still exists.
  transactionId String?              @map("transaction_id")
  address       String
  feeCents      Int                  @map("fee_cents")
  createdAt     DateTime             @default(now())

  @@index([tenantId])
  @@index([requestId])
  @@map("payment_request_item")
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

/// A trouble ticket filed from inside the dashboard — the sidebar widget on
/// every tenant page (not the portal sites) captures the page it was opened
/// from, so an operator knows what the person was looking at without asking.
model SupportTicket {
  id        String               @id @default(uuid())
  tenantId  String               @map("tenant_id")
  tenant    Organization         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String               @map("user_id")
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Auto-derived from the body (first ~60 chars) — the form is one textarea,
  /// on purpose, so filing a ticket is never more than "type and send".
  subject   String
  body      String
  /// Raw pathname the widget was opened from, e.g. /dashboard/transactions/abc123.
  pagePath  String?              @map("page_path")
  status    TicketStatus         @default(OPEN)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  replies   SupportTicketReply[]
  slackLink SlackTicketLink?

  @@index([tenantId, status])
  @@map("support_ticket")
}

/// One message in a ticket's thread — from the tenant who filed it, another
/// member of their workspace, or the operator. Operator replies aren't tied to
/// a User row in the tenant (an operator isn't necessarily a Member of every
/// workspace they support), so the author is recorded as plain text.
model SupportTicketReply {
  id           String        @id @default(uuid())
  tenantId     String        @map("tenant_id")
  tenant       Organization  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketId     String        @map("ticket_id")
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  body         String
  fromOperator Boolean       @default(false) @map("from_operator")
  authorEmail  String        @map("author_email")
  createdAt    DateTime      @default(now())

  @@index([tenantId, ticketId])
  @@map("support_ticket_reply")
}

/// Links a ticket to the Slack thread its alert was posted into, so a
/// threaded reply in Slack can find its way back to the right ticket without
/// any tenant context — the inbound Slack webhook has none, only a channel +
/// thread timestamp. No RLS: a bare lookup by (slackChannel, slackThreadTs)
/// resolves the tenant, then every downstream read/write goes through
/// withTenant, the same "resolve the capability first" discipline
/// vendor_order_link and portal_link already use. Optional — a ticket only
/// gets one when SLACK_BOT_TOKEN + SLACK_ADMIN_CHANNEL are configured.
model SlackTicketLink {
  id            String        @id @default(uuid())
  tenantId      String        @map("tenant_id")
  ticketId      String        @unique @map("ticket_id")
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  slackChannel  String        @map("slack_channel")
  slackThreadTs String        @map("slack_thread_ts")
  createdAt     DateTime      @default(now())

  @@unique([slackChannel, slackThreadTs])
  @@map("slack_ticket_link")
}

/// A state the workspace operates in, and whether it requires a licensed
/// coordinator on every file. Freehold ships no built-in list of which states
/// require licensing — that's a legal judgment each business makes for itself.
/// Also the coverage list a tenant advertises in the vendor directory.
model TenantState {
  id              String       @id @default(uuid())
  tenantId        String       @map("tenant_id")
  tenant          Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Two-letter state code, uppercased.
  state           String
  licenseRequired Boolean      @default(false) @map("license_required")
  createdAt       DateTime     @default(now())

  @@unique([tenantId, state])
  @@index([tenantId])
  @@map("tenant_state")
}

/// A workspace user working a transaction. Any number per file, each with a
/// free-text role ("Lead TC", "Support") and — later — the fee the tenant
/// pays them for it. Replaced the old fixed tc1/tc2 slots.
model TransactionAssignee {
  id            String       @id @default(uuid())
  tenantId      String       @map("tenant_id")
  tenant        Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId String       @map("transaction_id")
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  userId        String       @map("user_id")
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleLabel     String?      @map("role_label")
  /// What the tenant pays this user for this file, in cents. Admin-set; the
  /// user submits it through a PaymentRequest when it's due.
  feeCents      Int?         @map("fee_cents")
  /// Set once this assignment has been put on a pay request.
  paymentItem   PaymentRequestItem?
  createdAt     DateTime     @default(now())

  @@unique([transactionId, userId])
  @@index([tenantId])
  @@index([tenantId, userId])
  @@map("transaction_assignee")
}

/// A professional license a workspace user holds — some states require
/// licensed transaction coordinators. One row per state (a user licensed in
/// several states has several rows), stored per tenant: each workspace keeps
/// its own records for its own people. Always "license" in code and UI —
/// "credential" is the Vault's word for stored passwords.
model UserLicense {
  id              String       @id @default(uuid())
  tenantId        String       @map("tenant_id")
  tenant          Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId          String       @map("user_id")
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Two-letter state code, uppercased.
  state           String
  licenseNumber   String?      @map("license_number")
  /// What kind of license — "Salesperson", "Broker", "TC certification".
  label           String?
  /// Blank = no expiry on record. An expired license never satisfies a
  /// licensed-state check.
  expiresAt       DateTime?    @map("expires_at") @db.Date
  /// Uploaded copy of the license, via the storage abstraction (same fields
  /// as Document: inline bytes for DB, key for S3/tenant buckets).
  filename        String?
  contentType     String?      @map("content_type")
  sizeBytes       Int?         @map("size_bytes")
  data            Bytes?
  storageKey      String?      @map("storage_key")
  storageProvider String?      @map("storage_provider")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([tenantId])
  @@index([tenantId, userId])
  @@map("user_license")
}

/// One required document on a compliance checklist.
model ComplianceItem {
  id          String              @id @default(uuid())
  tenantId    String              @map("tenant_id")
  tenant      Organization        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  checklistId String              @map("checklist_id")
  checklist   ComplianceChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// Optional items are tracked but never block a file from passing.
  required    Boolean             @default(true)
  sortOrder   Int                 @default(0) @map("sort_order")
  createdAt   DateTime            @default(now())

  @@index([tenantId])
  @@index([checklistId])
  @@map("compliance_item")
}

// --- Stage 02: documents + AI contract extraction ---

enum ExtractionStatus {
  RUNNING
  READY
  APPLIED
  FAILED
}

enum FieldConfidence {
  HIGH
  MEDIUM
  LOW
}

enum FieldTarget {
  TRANSACTION_FIELD
  TASK
  CUSTOM_FIELD
  PARTY
}

enum FieldValueType {
  TEXT
  DATE
  MONEY
}

/// Uploaded or generated file attached to a transaction. Bytes live either in
/// object storage (`storageKey`, when STORAGE_ENDPOINT is configured) or
/// inline in Postgres (`data`, the zero-config default). Exactly one of the
/// two is set. Capped at upload time (10 MB).
model Document {
  id              String               @id @default(uuid())
  tenantId        String               @map("tenant_id")
  tenant          Organization         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId   String
  transaction     Transaction          @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  filename        String
  contentType     String               @map("content_type")
  sizeBytes       Int                  @map("size_bytes")
  data            Bytes?
  storageKey      String?              @map("storage_key")
  /// Which driver holds the bytes: DB | S3 (platform) | TENANT_S3. Null on rows
  /// predating per-tenant storage — reads infer from data/storageKey then.
  storageProvider String?              @map("storage_provider")
  visibleToAgent  Boolean              @default(true) @map("visible_to_agent")
  visibleToClient Boolean              @default(true) @map("visible_to_client")
  /// Versioning: replacing a file keeps the old one as a prior version. The new
  /// row is current (isCurrent), version+1, and replacesId points at the file it
  /// superseded. Lists show only current rows; the chain is the version history.
  version         Int                  @default(1)
  isCurrent       Boolean              @default(true) @map("is_current")
  replacesId      String?              @map("replaces_id")
  /// Set when the file came from a vendor — an inbound email attachment on an
  /// order (Stage 4) or a vendor upload (Stage 5). Kept internal by default
  /// (visibleToClient false); only the TC can promote it to the client.
  sourceOrderId   String?              @map("source_order_id")
  sourceOrder     VendorOrder?         @relation("OrderDocuments", fields: [sourceOrderId], references: [id], onDelete: SetNull)
  extractions     ContractExtraction[]
  envelopes       SignatureEnvelope[]
  complianceSlots ComplianceSlot[]
  requiredSlots   TransactionRequiredDocument[]
  createdAt       DateTime             @default(now())

  @@index([tenantId])
  @@index([transactionId])
  @@index([replacesId])
  @@index([sourceOrderId])
  @@map("document")
}

/// A slot on a transaction's required-documents checklist: an expected document
/// (seeded from an applied plan, or added by hand) that is satisfied when a
/// Document is linked to it. documentId null = still missing. Deleting the
/// linked document just reopens the slot (SetNull), never the checklist item.
model TransactionRequiredDocument {
  id            String       @id @default(uuid())
  tenantId      String       @map("tenant_id")
  tenant        Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId String       @map("transaction_id")
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  label         String
  documentId    String?      @map("document_id")
  document      Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  sortOrder     Int          @default(0) @map("sort_order")
  createdAt     DateTime     @default(now())

  @@index([tenantId])
  @@index([transactionId])
  @@map("transaction_required_document")
}

/// One AI extraction run over a document. Nothing an extraction finds touches
/// the transaction until a human applies it field-by-field.
model ContractExtraction {
  id            String            @id @default(uuid())
  tenantId      String            @map("tenant_id")
  tenant        Organization      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentId    String
  document      Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction       @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  status        ExtractionStatus  @default(RUNNING)
  model         String
  error         String?
  fields        ExtractionField[]
  createdAt     DateTime          @default(now())

  @@index([tenantId])
  @@index([transactionId])
  @@map("contract_extraction")
}

// --- Stage 03: document templates + e-signature envelopes ---

enum EsignProvider {
  MANUAL
  DOCUMENSO
  DOCUSIGN
}

enum EnvelopeStatus {
  DRAFT
  SENT
  COMPLETED
  DECLINED
  ERROR
}

/// Reusable merge-field document template. Body is plain text with
/// {{merge.fields}}; rendering produces a PDF attached to a transaction.
/// Reusable outbound email templates with merge fields, selectable from
/// any transaction's compose (and from task rows). Distinct from the two
/// automated lifecycle templates on the organization row.
model EmailTemplate {
  id          String       @id @default(uuid())
  tenantId    String       @map("tenant_id")
  tenant      Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  subject     String
  body        String
  /// STATUS | INTRO | PORTAL | MILESTONE | LISTING | POST_CLOSE | OTHER
  category    String       @default("OTHER")
  /// Comma-separated keywords matched against task titles to suggest this
  /// template when emailing from a task (e.g. "inspection" or "earnest,emd").
  taskMatch   String?      @map("task_match")
  /// Comma-separated keywords: transaction documents whose filename matches
  /// get pre-checked as attachments when this template is selected.
  attachMatch String?      @map("attach_match")
  /// Times this template has been used to send an email.
  usageCount  Int          @default(0) @map("usage_count")
  isSample    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([tenantId])
  @@map("email_template")
}

/// Operator analytics: every Checkout session we start, completed or not.
/// Platform-level table (no RLS) — read only from the /admin panel.
model CheckoutAttempt {
  id          String    @id // Stripe checkout session id
  tenantId    String    @map("tenant_id")
  email       String
  tier        String
  createdAt   DateTime  @default(now())
  completedAt DateTime? @map("completed_at")
  expiredAt   DateTime? @map("expired_at")
  recoveryUrl String?   @map("recovery_url")

  @@index([createdAt])
  @@map("checkout_attempt")
}

/// Redeemable complimentary-plan code. Platform-level (no RLS): operators mint
/// codes in /admin, tenants redeem them on the billing page for a full plan with
/// no Stripe checkout or charge. Redemption sets org.compTier + compExpiresAt.
model CompCode {
  id             String    @id @default(uuid())
  code           String    @unique
  /// The plan this code grants (PRO or BUSINESS).
  tier           PlanTier
  /// How long the comp lasts once redeemed, in months; null = no expiry.
  durationMonths Int?      @map("duration_months")
  /// Redemption deadline for the code itself; null = never expires.
  expiresAt      DateTime? @map("expires_at")
  maxRedemptions Int       @default(1) @map("max_redemptions")
  timesRedeemed  Int       @default(0) @map("times_redeemed")
  note           String?
  createdAt      DateTime  @default(now())

  @@map("comp_code")
}

// --- AI credits: prepaid pro-AI unlocks for the Free tier ---

/// Reason a workspace's AI-credit balance changed. Audit only — the balance of
/// record lives on organization.aiCredits.
enum CreditLedgerReason {
  PURCHASE
  COUPON
  SPEND
  REFUND
  ADMIN
}

/// Append-only audit of AI-credit movements. Platform table (no RLS): operators
/// review it in /admin, tenants see their own via explicit tenantId filters;
/// rows are written only by server actions that stamp the authenticated tenant.
model CreditLedger {
  id            String             @id @default(uuid())
  tenantId      String             @map("tenant_id")
  /// Positive = granted/purchased, negative = spent.
  delta         Int
  reason        CreditLedgerReason
  /// Balance immediately after this movement, for reconciliation.
  balanceAfter  Int                @map("balance_after")
  /// The transaction a SPEND unlocked, when applicable.
  transactionId String?            @map("transaction_id")
  note          String?
  createdAt     DateTime           @default(now())

  @@index([tenantId, createdAt])
  @@map("credit_ledger")
}

/// Per-call AI token usage, so operators can see how much each plan/tenant
/// consumes and move heavy tenants to cheaper models. Platform table (no RLS):
/// admin aggregates cross-tenant; rows written by server-side AI calls that
/// stamp the tenant. Best-effort — a logging failure never blocks the AI call.
model AiUsageEvent {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  /// "extract" | "classify" | "dictation" | ...
  feature       String
  model         String
  inputTokens   Int      @default(0) @map("input_tokens")
  outputTokens  Int      @default(0) @map("output_tokens")
  transactionId String?  @map("transaction_id")
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([createdAt])
  @@map("ai_usage_event")
}

/// Redeemable code granting free AI credits. Platform table (no RLS), same
/// shape as CompCode: operators mint in /admin, tenants redeem on billing.
model CreditCoupon {
  id             String                   @id @default(uuid())
  code           String                   @unique
  /// Credits granted per redemption.
  credits        Int
  expiresAt      DateTime?                @map("expires_at")
  maxRedemptions Int                      @default(1) @map("max_redemptions")
  timesRedeemed  Int                      @default(0) @map("times_redeemed")
  note           String?
  createdAt      DateTime                 @default(now())
  redemptions    CreditCouponRedemption[]

  @@map("credit_coupon")
}

/// One row per (coupon, tenant) so a workspace can't redeem the same code
/// twice. Platform table (no RLS); written by the tenant redeem action.
model CreditCouponRedemption {
  id        String       @id @default(uuid())
  couponId  String       @map("coupon_id")
  coupon    CreditCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  tenantId  String       @map("tenant_id")
  createdAt DateTime     @default(now())

  @@unique([couponId, tenantId])
  @@map("credit_coupon_redemption")
}

/// Scheduled/queued outgoing email. NO RLS on purpose: the hourly cron
/// flushes due rows across tenants (CRON_SECRET-guarded route); rows are
/// created only by tenant-scoped actions that stamp tenantId themselves.
model EmailOutbox {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  transactionId String?   @map("transaction_id")
  toAddr        String    @map("to_addr")
  subject       String
  body          String
  sendAt        DateTime  @map("send_at")
  sentAt        DateTime? @map("sent_at")
  canceledAt    DateTime? @map("canceled_at")
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now())

  @@index([sendAt, sentAt])
  @@map("email_outbox")
}

model DocTemplate {
  id          String       @id @default(uuid())
  tenantId    String       @map("tenant_id")
  tenant      Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  body        String
  isSample    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([tenantId])
  @@map("doc_template")
}

/// One signature request for a document, through whichever provider the
/// client (or tenant default) uses. Provider adapters live in
/// packages/integrations; MANUAL tracks signatures collected outside any
/// e-sign service (wet ink, provider portals we don't yet integrate).
model SignatureEnvelope {
  id            String         @id @default(uuid())
  tenantId      String         @map("tenant_id")
  tenant        Organization   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentId    String
  document      Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  provider      EsignProvider
  externalId    String?        @map("external_id")
  status        EnvelopeStatus @default(DRAFT)
  signers       Json
  error         String?
  sentAt        DateTime?      @map("sent_at")
  completedAt   DateTime?      @map("completed_at")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tenantId])
  @@index([transactionId])
  @@map("signature_envelope")
}

/// A single extracted value with its provenance: page number, verbatim quote,
/// and the model's confidence. `target` says where applying it lands —
/// a transaction column, a dated task, or a custom field.
model ExtractionField {
  id           String             @id @default(uuid())
  tenantId     String             @map("tenant_id")
  tenant       Organization       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  extractionId String
  extraction   ContractExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  key          String
  label        String
  value        String
  valueType    FieldValueType     @default(TEXT) @map("value_type")
  page         Int?
  quote        String?
  confidence   FieldConfidence    @default(MEDIUM)
  target       FieldTarget        @default(CUSTOM_FIELD)
  applied      Boolean            @default(false)
  sortOrder    Int                @default(0) @map("sort_order")

  @@index([tenantId])
  @@index([extractionId])
  @@map("extraction_field")
}
