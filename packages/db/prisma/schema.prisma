// Freehold schema — Stage 00.
//
// Auth tables (user, session, account, verification, organization, member,
// invitation) follow Better Auth's expected shape (organization plugin enabled).
// Domain convention: an Organization IS a Freehold tenant — the paying customer
// (broker, title company, or solo TC business). Domain tables carry tenant_id
// and are protected by Postgres row-level security (see the init migration and
// `withTenant` in src/tenant.ts).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Better Auth core ---

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]
  ownedContacts Contact[]    @relation("ContactOwner")
  assignedTasks Task[]       @relation("TaskAssignee")

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// --- Better Auth organization plugin (Organization = Freehold tenant) ---

/// Cloud plan tier. Self-hosted installs stay on FREE semantics-wise but are
/// never limited — limits are enforced only when FREEHOLD_CLOUD=1.
enum PlanTier {
  FREE
  PRO
  BUSINESS
}

model Organization {
  id                      String               @id
  name                    String
  slug                    String               @unique
  logo                    String?
  metadata                String?
  planTier                PlanTier             @default(FREE) @map("plan_tier")
  seatLimit               Int                  @default(2) @map("seat_limit")
  aiExtractionsUsed       Int                  @default(0) @map("ai_extractions_used")
  /// Admin setting: when true, members only see contacts they own.
  restrictContactsToOwner Boolean              @default(false) @map("restrict_contacts_to_owner")
  /// Per-tenant Follow Up Boss connection: {enc:{...}, importedAt?, importedCount?}.
  /// API key encrypted with VAULT_MASTER_KEY.
  fubConfig               Json?                @map("fub_config")
  /// Per-tenant Twenty CRM connection: {url, enc:{...}, importedAt?, importedCount?}.
  twentyConfig            Json?                @map("twenty_config")
  /// Tenant mini-site at <slug>.<root>: {published, tagline, about, phone, email, services, showRegistration}.
  siteConfig              Json?                @map("site_config")
  /// Per-tenant Documenso connection: {url, enc:{ciphertext,iv,tag,wrappedKey,wrapIv,wrapTag,keyVersion}}.
  /// Token encrypted with VAULT_MASTER_KEY; null = use server-wide env default.
  documensoConfig         Json?                @map("documenso_config")
  stripeCustomerId        String?              @map("stripe_customer_id")
  stripeSubscriptionId    String?              @map("stripe_subscription_id")
  createdAt               DateTime             @default(now())
  members                 Member[]
  invitations             Invitation[]
  clients                 Client[]
  contacts                Contact[]
  transactions            Transaction[]
  parties                 TransactionParty[]
  tasks                   Task[]
  actionPlans             ActionPlan[]
  actionPlanTasks         ActionPlanTask[]
  documents               Document[]
  extractions             ContractExtraction[]
  extractionFields        ExtractionField[]
  templates               DocTemplate[]
  envelopes               SignatureEnvelope[]
  portalLinks             PortalLink[]
  vaultCredentials        VaultCredential[]
  vaultAccessLogs         VaultAccessLog[]
  auditLogs               AuditLog[]
  contactNotes            ContactNote[]
  clientNotes             ClientNote[]
  clientAgents            ClientAgent[]
  emails                  Email[]
  apiKeys                 ApiKey[]
  invoices                Invoice[]
  webhookEndpoints        WebhookEndpoint[]

  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invitation")
}

// --- Freehold domain (row-level security enforced; see init migration) ---

enum ClientType {
  AGENT
  BROKERAGE
  TITLE
  LENDER
  OTHER
}

/// The tenant's customer — the agent, brokerage, title company, or lender they
/// serve. Transactions, vault credentials, portal branding, and invoicing all
/// attach here in later stages.
model Client {
  id            String            @id @default(uuid())
  tenantId      String            @map("tenant_id")
  tenant        Organization      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type          ClientType        @default(AGENT)
  name          String
  email         String?
  phone         String?
  notes         String?
  /// Per-client e-signature provider; null = tenant default (FREEHOLD_ESIGN_DEFAULT env, else MANUAL).
  esignProvider EsignProvider?    @map("esign_provider")
  isSample      Boolean           @default(false)
  transactions  Transaction[]
  credentials   VaultCredential[]
  portalLinks   PortalLink[]
  clientNotes   ClientNote[]
  agents        ClientAgent[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  invoices      Invoice[]

  @@index([tenantId])
  @@map("client")
}

enum TransactionStatus {
  LISTING
  UNDER_CONTRACT
  PENDING
  CLOSED
  CANCELLED
}

enum TransactionSide {
  BUY_SIDE
  SELL_SIDE
  DUAL
}

enum PartyRole {
  BUYER
  SELLER
  BUYER_AGENT
  LISTING_AGENT
  LENDER
  TITLE_COMPANY
  INSPECTOR
  APPRAISER
  ATTORNEY
  OTHER
}

enum TaskStatus {
  OPEN
  DONE
  SKIPPED
}

enum DateAnchor {
  CONTRACT_DATE
  CLOSE_DATE
}

enum TaskPriority {
  NORMAL
  HIGH
  CRITICAL
}

/// CRM record — buyers, sellers, agents, lenders, vendors. Category is free
/// text on purpose (competitors allow custom categories).
/// Dual-person CRM record: one entry holds two related people (a couple, a
/// client + assistant) so mailings and document merges address both at once.
/// `name` stays the denormalized display name ("Jordan & Casey Bell") used by
/// pickers and party lists; structured person fields live alongside it, and
/// the secondary person + overflow phones/emails live in JSON.
/// Which agents (contacts) work under a managed client (team/brokerage).
/// Portal access is granted per agent from the client page; agents without
/// a portal simply have no portal_link row.
model ClientAgent {
  id        String       @id @default(uuid())
  tenantId  String       @map("tenant_id")
  tenant    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId  String       @map("client_id")
  client    Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId String       @map("contact_id")
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([clientId, contactId])
  @@index([tenantId])
  @@map("client_agent")
}

model Contact {
  id             String             @id @default(uuid())
  tenantId       String             @map("tenant_id")
  tenant         Organization       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId        String?
  owner          User?              @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  name           String
  email          String?
  phone          String?
  category       String             @default("Other")
  rating         Int?
  touchDate      DateTime?          @map("touch_date") @db.Date
  notes          String?
  // --- dual-person CRM fields ---
  personTitle    String?            @map("person_title")
  firstName      String?            @map("first_name")
  middleName     String?            @map("middle_name")
  lastName       String?            @map("last_name")
  jobTitle       String?            @map("job_title")
  company        String?
  website        String?
  workPhone      String?            @map("work_phone")
  fax            String?
  /// Secondary person (spouse/assistant): {title,first,middle,last,jobTitle,cell,workPhone,email}
  secondary      Json?
  /// Overflow contact points: {phones: string[], emails: string[]}
  extraContacts  Json?              @map("extra_contacts")
  categories     String[]           @default([])
  /// Relationship grade A-D; drives the auto-prospecting cadence.
  grade          String?
  /// When this contact is next due in the prospecting queue.
  nextTouchAt    DateTime?          @map("next_touch_at") @db.Date
  homeAddress    Json?              @map("home_address")
  workAddress    Json?              @map("work_address")
  referredById   String?            @map("referred_by_id")
  referredBy     Contact?           @relation("ContactReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals      Contact[]          @relation("ContactReferrals")
  referralSource String?            @map("referral_source")
  referralDate   DateTime?          @map("referral_date") @db.Date
  /// BUYER | SELLER | NONE
  leadType       String?            @map("lead_type")
  /// Buyer: {cultivating,location,range,income}; Seller: {cultivating,address,listPrice,netProceeds}
  leadDetails    Json?              @map("lead_details")
  /// {birthday:{m,d,y?}, birthdayAlt, weddingAnniversary, purchaseAnniversary}
  touchDates     Json?              @map("touch_dates")
  photoUrl       String?            @map("photo_url")
  /// {facebook, instagram, linkedin, x, youtube, other}
  socialLinks    Json?              @map("social_links")
  isSample       Boolean            @default(false)
  parties        TransactionParty[]
  contactNotes   ContactNote[]
  emails         Email[]
  tasks          Task[]
  credentials    VaultCredential[]
  agentOf        ClientAgent[]
  portalLinks    PortalLink[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([tenantId, category])
  @@index([tenantId, nextTouchAt])
  @@map("contact")
}

/// Transactional email with reply capture. Outbound goes through Resend from
/// the tenant's identity on the shared mail domain; each message carries a
/// per-thread reply token, and inbound replies post back via webhook and
/// attach here. This IS the mailbox — storage is rows + document attachments.
enum EmailDirection {
  OUTBOUND
  INBOUND
}

/// Reply-token → tenant mapping for the inbound webhook. Deliberately has NO
/// row-level security (same reasoning as portal_link): the webhook arrives
/// with no tenant context and the unguessable token IS the capability; the
/// email bodies themselves stay in the RLS-protected email table.
model EmailThread {
  token         String   @id
  tenantId      String   @map("tenant_id")
  transactionId String?  @map("transaction_id")
  contactId     String?  @map("contact_id")
  providerId    String?  @map("provider_id")
  createdAt     DateTime @default(now())

  @@index([providerId])
  @@map("email_thread")
}

model Email {
  id            String         @id @default(uuid())
  tenantId      String         @map("tenant_id")
  tenant        Organization   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId String?
  transaction   Transaction?   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  contactId     String?        @map("contact_id")
  contact       Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  direction     EmailDirection
  fromAddr      String         @map("from_addr")
  toAddr        String         @map("to_addr")
  subject       String
  bodyText      String         @map("body_text")
  /// Reply capture token; inbound mail to reply+<token>@ matches the thread.
  replyToken    String?        @map("reply_token")
  providerId    String?        @map("provider_id")
  status        String         @default("SENT")
  createdAt     DateTime       @default(now())

  @@index([tenantId, transactionId, createdAt])
  @@index([replyToken])
  @@map("email")
}

/// Notes a TC keeps about a client (the backend client page).
model ClientNote {
  id        String       @id @default(uuid())
  tenantId  String       @map("tenant_id")
  tenant    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId  String       @map("client_id")
  client    Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId  String?      @map("author_id")
  body      String
  createdAt DateTime     @default(now())

  @@index([tenantId, clientId, createdAt])
  @@map("client_note")
}

/// Timestamped CRM notes on a contact (the Notes tab + quick-add).
model ContactNote {
  id        String       @id @default(uuid())
  tenantId  String       @map("tenant_id")
  tenant    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId String       @map("contact_id")
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  authorId  String?      @map("author_id")
  body      String
  createdAt DateTime     @default(now())

  @@index([tenantId, contactId, createdAt])
  @@map("contact_note")
}

/// The central object: one closing. Belongs to a tenant, optionally to the
/// client (agent/brokerage) the tenant serves it for.
model Transaction {
  id              String               @id @default(uuid())
  tenantId        String               @map("tenant_id")
  tenant          Organization         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId        String?
  client          Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  status          TransactionStatus    @default(UNDER_CONTRACT)
  side            TransactionSide      @default(BUY_SIDE)
  propertyAddress String               @map("property_address")
  city            String?
  state           String?
  zip             String?
  purchasePrice   Int?                 @map("purchase_price")
  listPrice       Int?                 @map("list_price")
  listDate        DateTime?            @map("list_date") @db.Date
  onMarketDate    DateTime?            @map("on_market_date") @db.Date
  expireDate      DateTime?            @map("expire_date") @db.Date
  mlsId           String?              @map("mls_id")
  /// Assignment roles: co-agent is a Client (managed agent); TCs are workspace users.
  coAgentClientId String?              @map("co_agent_client_id")
  tc1UserId       String?              @map("tc1_user_id")
  tc2UserId       String?              @map("tc2_user_id")
  /// Commission breakdown: {listPct, buyPct, note} — gross computes from price.
  payout          Json?
  emails          Email[]
  /// Contract-governed date changes awaiting an executed amendment:
  /// {closeDate?: "YYYY-MM-DD", contractDate?: "YYYY-MM-DD"}
  proposedDates   Json?                @map("proposed_dates")
  contractDate    DateTime?            @map("contract_date") @db.Date
  closeDate       DateTime?            @map("close_date") @db.Date
  notes           String?
  customFields    Json?                @map("custom_fields")
  isSample        Boolean              @default(false)
  parties         TransactionParty[]
  tasks           Task[]
  documents       Document[]
  extractions     ContractExtraction[]
  envelopes       SignatureEnvelope[]
  portalLinks     PortalLink[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  invoices        Invoice[]

  @@index([tenantId, status])
  @@map("transaction")
}

// --- Stage 04: client portals + credential vault ---

/// Shareable read-only portal access to one transaction. The random token IS
/// the capability — portal pages are unauthenticated by design (TCs text
/// these links to buyers/sellers).
///
/// ⚠️ Deliberately NOT covered by row-level security: the public portal route
/// must resolve a bare token with no tenant context. The table carries only
/// the token, display toggles, and foreign keys; all transaction data is then
/// fetched through withTenant() using the link's own tenant id.
/// Who a portal link serves. CLIENT = buyer/seller simplified view of one
/// transaction; AGENT = the managed-agent portal, scoped to a Client record
/// and covering all of that client's transactions.
enum PortalAudience {
  CLIENT
  AGENT
}

model PortalLink {
  id             String         @id @default(uuid())
  tenantId       String         @map("tenant_id")
  tenant         Organization   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  audience       PortalAudience @default(CLIENT)
  transactionId  String?
  transaction    Transaction?   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  clientId       String?        @map("client_id")
  client         Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId      String?        @map("contact_id")
  contact        Contact?       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  token          String         @unique
  label          String
  showTasks      Boolean        @default(true) @map("show_tasks")
  showDocuments  Boolean        @default(false) @map("show_documents")
  showParties    Boolean        @default(true) @map("show_parties")
  revokedAt      DateTime?      @map("revoked_at")
  lastAccessedAt DateTime?      @map("last_accessed_at")
  createdAt      DateTime       @default(now())

  @@index([tenantId])
  @@index([transactionId])
  @@map("portal_link")
}

/**
 * Public API keys. Like portal_link, this table deliberately has NO RLS
 * policy: the key hash IS the capability, and the API must look it up
 * before any tenant context exists. Only the SHA-256 hash is stored.
 */
model ApiKey {
  id         String       @id @default(uuid())
  tenantId   String       @map("tenant_id")
  tenant     Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  prefix     String
  hash       String       @unique
  createdAt  DateTime     @default(now())
  lastUsedAt DateTime?    @map("last_used_at")
  revokedAt  DateTime?    @map("revoked_at")

  @@index([tenantId])
  @@map("api_key")
}

model WebhookEndpoint {
  id        String       @id @default(uuid())
  tenantId  String       @map("tenant_id")
  tenant    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url       String
  secret    String
  events    String[]
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())

  @@index([tenantId])
  @@map("webhook_endpoint")
}

enum InvoiceStatus {
  SENT
  PAID
  VOID
}

/**
 * Client invoicing: the tenant bills their client through Stripe.
 */
model Invoice {
  id              String        @id @default(uuid())
  tenantId        String        @map("tenant_id")
  tenant          Organization  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId        String?
  client          Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  transactionId   String?
  transaction     Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  description     String
  amountCents     Int           @map("amount_cents")
  status          InvoiceStatus @default(SENT)
  stripeInvoiceId String?       @unique @map("stripe_invoice_id")
  hostedUrl       String?       @map("hosted_url")
  createdAt       DateTime      @default(now())
  paidAt          DateTime?     @map("paid_at")

  @@index([tenantId])
  @@map("invoice")
}

enum VaultAction {
  CREATED
  UPDATED
  REVEALED
  DELETED
}

/// Envelope-encrypted third-party credential (MLS, lender portals, e-sign accounts)
/// stored on a client's behalf. The secret never exists in plaintext at rest:
/// AES-256-GCM under a per-credential data key, itself wrapped by
/// VAULT_MASTER_KEY (see packages/vault). Reveals are audited — Freehold
/// stores and audits credentials; it never logs into anything automatically.
model VaultCredential {
  id         String           @id @default(uuid())
  tenantId   String           @map("tenant_id")
  tenant     Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId   String?
  client     Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  contactId  String?          @map("contact_id")
  contact    Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  system     String
  username   String
  url        String?
  notes      String?
  ciphertext String
  iv         String
  tag        String
  wrappedKey String           @map("wrapped_key")
  wrapIv     String           @map("wrap_iv")
  wrapTag    String           @map("wrap_tag")
  keyVersion Int              @default(1) @map("key_version")
  accessLogs VaultAccessLog[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([tenantId])
  @@map("vault_credential")
}

model AuditLog {
  id          String       @id @default(uuid())
  tenantId    String       @map("tenant_id")
  tenant      Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId     String?      @map("actor_id")
  actorEmail  String?      @map("actor_email")
  action      String
  subjectType String?      @map("subject_type")
  subjectId   String?      @map("subject_id")
  summary     String
  createdAt   DateTime     @default(now())

  @@index([tenantId, createdAt])
  @@map("audit_log")
}

model VaultAccessLog {
  id           String           @id @default(uuid())
  tenantId     String           @map("tenant_id")
  tenant       Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  credentialId String?
  credential   VaultCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  userId       String
  action       VaultAction
  detail       String?
  createdAt    DateTime         @default(now())

  @@index([tenantId, createdAt])
  @@map("vault_access_log")
}

model TransactionParty {
  id            String       @id @default(uuid())
  tenantId      String       @map("tenant_id")
  tenant        Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  contactId     String
  contact       Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  role          PartyRole
  createdAt     DateTime     @default(now())

  @@unique([transactionId, contactId, role])
  @@index([tenantId])
  @@map("transaction_party")
}

model Task {
  id              String       @id @default(uuid())
  tenantId        String       @map("tenant_id")
  tenant          Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId   String?
  transaction     Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  title           String
  notes           String?
  dueDate         DateTime?    @map("due_date") @db.Date
  status          TaskStatus   @default(OPEN)
  priority        TaskPriority @default(NORMAL)
  /// Provenance for domino recomputation: tasks instantiated from an action
  /// plan keep their anchor + offset so a confirmed date change re-dates them.
  anchor          DateAnchor?
  offsetDays      Int?         @map("offset_days")
  /// Manually re-dated tasks opt out of recomputation.
  dueDateEdited   Boolean      @default(false) @map("due_date_edited")
  /// Set when this task exists to get a date amendment executed ("closeDate"/"contractDate").
  proposedFor     String?      @map("proposed_for")
  completedAt     DateTime?    @map("completed_at")
  contactId       String?      @map("contact_id")
  contact         Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  /// Per-audience portal visibility, toggled from the transaction screen.
  visibleToAgent  Boolean      @default(true) @map("visible_to_agent")
  visibleToClient Boolean      @default(true) @map("visible_to_client")
  assigneeId      String?
  assignee        User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  sortOrder       Int          @default(0) @map("sort_order")
  isSample        Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([tenantId, status, dueDate])
  @@map("task")
}

/// Reusable checklist template ("Texas buy-side closing, 30 tasks").
model ActionPlan {
  id          String           @id @default(uuid())
  tenantId    String           @map("tenant_id")
  tenant      Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isSample    Boolean          @default(false)
  tasks       ActionPlanTask[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([tenantId])
  @@map("action_plan")
}

model ActionPlanTask {
  id           String       @id @default(uuid())
  tenantId     String       @map("tenant_id")
  tenant       Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actionPlanId String
  actionPlan   ActionPlan   @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  title        String
  anchor       DateAnchor   @default(CLOSE_DATE)
  offsetDays   Int          @default(0) @map("offset_days")
  assigneeRole String?      @map("assignee_role")
  sortOrder    Int          @default(0) @map("sort_order")

  @@index([tenantId])
  @@map("action_plan_task")
}

// --- Stage 02: documents + AI contract extraction ---

enum ExtractionStatus {
  RUNNING
  READY
  APPLIED
  FAILED
}

enum FieldConfidence {
  HIGH
  MEDIUM
  LOW
}

enum FieldTarget {
  TRANSACTION_FIELD
  TASK
  CUSTOM_FIELD
}

enum FieldValueType {
  TEXT
  DATE
  MONEY
}

/// Uploaded or generated file attached to a transaction. Bytes live either in
/// object storage (`storageKey`, when STORAGE_ENDPOINT is configured) or
/// inline in Postgres (`data`, the zero-config default). Exactly one of the
/// two is set. Capped at upload time (10 MB).
model Document {
  id              String               @id @default(uuid())
  tenantId        String               @map("tenant_id")
  tenant          Organization         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId   String
  transaction     Transaction          @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  filename        String
  contentType     String               @map("content_type")
  sizeBytes       Int                  @map("size_bytes")
  data            Bytes?
  storageKey      String?              @map("storage_key")
  visibleToAgent  Boolean              @default(true) @map("visible_to_agent")
  visibleToClient Boolean              @default(true) @map("visible_to_client")
  extractions     ContractExtraction[]
  envelopes       SignatureEnvelope[]
  createdAt       DateTime             @default(now())

  @@index([tenantId])
  @@index([transactionId])
  @@map("document")
}

/// One AI extraction run over a document. Nothing an extraction finds touches
/// the transaction until a human applies it field-by-field.
model ContractExtraction {
  id            String            @id @default(uuid())
  tenantId      String            @map("tenant_id")
  tenant        Organization      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentId    String
  document      Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction       @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  status        ExtractionStatus  @default(RUNNING)
  model         String
  error         String?
  fields        ExtractionField[]
  createdAt     DateTime          @default(now())

  @@index([tenantId])
  @@index([transactionId])
  @@map("contract_extraction")
}

// --- Stage 03: document templates + e-signature envelopes ---

enum EsignProvider {
  MANUAL
  DOCUMENSO
  DOCUSIGN
}

enum EnvelopeStatus {
  DRAFT
  SENT
  COMPLETED
  DECLINED
  ERROR
}

/// Reusable merge-field document template. Body is plain text with
/// {{merge.fields}}; rendering produces a PDF attached to a transaction.
model DocTemplate {
  id          String       @id @default(uuid())
  tenantId    String       @map("tenant_id")
  tenant      Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  body        String
  isSample    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([tenantId])
  @@map("doc_template")
}

/// One signature request for a document, through whichever provider the
/// client (or tenant default) uses. Provider adapters live in
/// packages/integrations; MANUAL tracks signatures collected outside any
/// e-sign service (wet ink, provider portals we don't yet integrate).
model SignatureEnvelope {
  id            String         @id @default(uuid())
  tenantId      String         @map("tenant_id")
  tenant        Organization   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentId    String
  document      Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  provider      EsignProvider
  externalId    String?        @map("external_id")
  status        EnvelopeStatus @default(DRAFT)
  signers       Json
  error         String?
  sentAt        DateTime?      @map("sent_at")
  completedAt   DateTime?      @map("completed_at")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tenantId])
  @@index([transactionId])
  @@map("signature_envelope")
}

/// A single extracted value with its provenance: page number, verbatim quote,
/// and the model's confidence. `target` says where applying it lands —
/// a transaction column, a dated task, or a custom field.
model ExtractionField {
  id           String             @id @default(uuid())
  tenantId     String             @map("tenant_id")
  tenant       Organization       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  extractionId String
  extraction   ContractExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  key          String
  label        String
  value        String
  valueType    FieldValueType     @default(TEXT) @map("value_type")
  page         Int?
  quote        String?
  confidence   FieldConfidence    @default(MEDIUM)
  target       FieldTarget        @default(CUSTOM_FIELD)
  applied      Boolean            @default(false)
  sortOrder    Int                @default(0) @map("sort_order")

  @@index([tenantId])
  @@index([extractionId])
  @@map("extraction_field")
}
