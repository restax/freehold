}

model Member {
  id                String       @id
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role              String       @default("member")
  /// Compliance review authority, assigned from the Team page. null = default
  /// by role (owner/admin hold top authority, member submits only); 0 =
  /// submitter only even for an admin; 1..N = approves at levels up to N.
  complianceTier    Int?         @map("compliance_tier")
  /// Billing authority, assigned from the Team page. null = default by role
  /// (owner/admin see and manage everything incl. team comp; member sees
  /// nothing). "view" reads invoices and revenue; "manage" also records
  /// money; "full" additionally sees team payout/comp data. Resolved by
  /// lib/billing-access.ts.
  billingRole       String?      @map("billing_role")
  /// Capability token for this person's subscribe-once personal calendar feed
  /// in this workspace (a user in two tenants gets a separate feed per one,
  /// same as everything else here — roles and assignments don't cross tenants).
  /// Generated lazily on first request for the link; null until then.
  calendarToken     String?      @unique @map("calendar_token")
  /// When this person last looked at the Support page in this workspace. Any
  /// operator/Slack reply newer than this counts as unread, driving the
  /// sidebar's "new message" badge. Null = never opened it.
  supportSeenAt     DateTime?    @map("support_seen_at")
  /// Per-person table preferences in this workspace, e.g.
  /// {transactionColumns: ["address","status",...]} — the chosen columns in
  /// display order. Per member rather than per user because someone who
  /// coordinates for two workspaces wants different columns in each, the
  /// same way roles and assignments don't cross tenants. Unset = the
  /// defaults in lib/transaction-columns.ts.
  tablePrefs        Json?        @map("table_prefs")
  /// Cached "Today at a glance" text, and when it was written. Per member
  /// rather than per user: it describes this workspace's work, and someone
  /// coordinating for two tenants needs a separate one in each. Rewritten
  /// lazily when the Today screen is opened and this is over an hour old,
  /// which is what makes "once an hour while signed in" true without a cron.
  handbookSummary   String?      @map("handbook_summary")
  handbookSummaryAt DateTime?    @map("handbook_summary_at")
  createdAt         DateTime     @default(now())

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invitation")
}

// --- Freehold domain (row-level security enforced; see init migration) ---

enum ClientType {
  AGENT
  BROKERAGE
  /// A team inside a brokerage — behaves exactly like BROKERAGE (office info,
  /// billing contact, roster of agents); it exists so the list can say "Team".
  TEAM
  TITLE
  LENDER
  OTHER
}

/// The tenant's customer — the agent, brokerage, title company, or lender they
/// serve. Transactions, vault credentials, portal branding, and invoicing all
/// attach here in later stages.
model Client {
  id                    String               @id @default(uuid())
  tenantId              String               @map("tenant_id")
  tenant                Organization         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type                  ClientType           @default(AGENT)
  name                  String
  email                 String?
  phone                 String?
  /// Office / mailing address, free text — suite lines and all.
  address               String?
  /// Who pays the bills at a brokerage or team: {name?, email?, phone?}.
  /// When the email is set, invoice emails go there instead of Client.email
  /// (lib/client-profile.ts resolves the recipient).
  billingContact        Json?                @map("billing_contact")
  /// For AGENT clients: the brokerage they hang their license with — plain
  /// reference info ({name?, phone?, address?}), not a relation, because the
  /// agent's broker usually isn't a client of this workspace.
  brokerageInfo         Json?                @map("brokerage_info")
  notes                 String?
  /// Per-client e-signature provider; null = tenant default (FREEHOLD_ESIGN_DEFAULT env, else MANUAL).
  esignProvider         EsignProvider?       @map("esign_provider")
  /// Per-client automated-email switches: {intro?: boolean, postClose?: boolean}; missing = on.
  emailPrefs            Json?                @map("email_prefs")
  /// This agent's own SkySlope API credentials, so their transactions can be
  /// read on their behalf: {accessKeyEnc:{...}, secretEnc:{...}, label?,
  /// connectedAt, verifiedAt?}. Envelope-encrypted with VAULT_MASTER_KEY.
  /// One per client because SkySlope issues AccessKey/Secret per user, not
  /// per brokerage. Null = not connected.
  skyslopeConfig        Json?                @map("skyslope_config")
  /// Per-client staleness thresholds, overriding the workspace defaults:
  /// {staleDays?, criticalWindowDays?, criticalStaleDays?}. Some clients want
  /// to hear about a quiet file sooner than others. Unset keys fall back to
  /// the defaults in lib/transaction-alerts.ts.
  alertConfig           Json?                @map("alert_config")
  /// What this client is normally charged per file; auto-fills each new
  /// transaction's expectedFeeCents. Null = the workspace default fee.
  defaultFeeCents       Int?                 @map("default_fee_cents")
  /// Per-client billing-policy overrides ({mode, lateFee, ...}); unset keys
  /// fall back to Organization.billingDefaults via lib/billing-policy.ts.
  billingConfig         Json?                @map("billing_config")
  /// Read contracts that arrive through an intake form with AI, for this
  /// client only. Off by default and deliberately per-client: a stranger's
  /// upload is not something to spend a workspace's AI on by default, and
  /// some clients don't want their contracts machine-read at all. Pro
  /// feature — lib/intake-ai.ts is the gate.
  intakeAiExtraction    Boolean              @default(false) @map("intake_ai_extraction")
  /// Compliance: every transaction for this client follows the assigned
  /// checklist. Switch complianceEnabled off to exempt the client entirely
  /// (leaving no checklist assigned is also inert).
  complianceEnabled     Boolean              @default(true) @map("compliance_enabled")
  complianceChecklistId String?              @map("compliance_checklist_id")
  complianceChecklist   ComplianceChecklist? @relation(fields: [complianceChecklistId], references: [id], onDelete: SetNull)
  isSample              Boolean              @default(false)
  transactions          Transaction[]
  credentials           VaultCredential[]
  portalLinks           PortalLink[]
  clientNotes           ClientNote[]
  agents                ClientAgent[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  invoices              Invoice[]
  creditEntries         ClientCreditEntry[]
  forms                 Form[]
  formSubmissions       FormSubmission[]
  formAccessLinks       FormAccessLink[]
  reviews               ClientReview[]
  /// Working-relationship grade, set by hand from the client page. Columns
  /// rather than a HandbookNote because there is exactly one per client and
  /// it drives a badge, but it is the same feature to a user.
  handbookGrade         HandbookGrade?       @map("handbook_grade")
  /// Why the grade is what it is. The grade alone ages badly: "F" two years
  /// on tells a new coordinator nothing; "blamed us for a deal falling
  /// through, do not accept work" tells them everything.
  handbookGradeNote     String?              @map("handbook_grade_note")

  @@index([tenantId])
  @@map("client")
}

/// The listing lifecycle, in the order a file moves through it. Everything
/// before CLOSED/CANCELLED is "open" — see OPEN_STATUSES in
/// lib/transaction-views.ts, which is the single definition of that split.
enum TransactionStatus {
  DRAFT
  COMING_SOON
  ACTIVE
  TMP_OFF_MARKET
  UNDER_CONTRACT
  PENDING
  CLOSED
  CANCELLED
}

enum TransactionSide {
  BUY_SIDE
  SELL_SIDE
  DUAL
}

enum PartyRole {
  BUYER
  SELLER
  BUYER_AGENT
  LISTING_AGENT
  LENDER
  TITLE_COMPANY
  INSPECTOR
  APPRAISER
  ATTORNEY
  OTHER
}

enum TaskStatus {
  OPEN
  DONE
  SKIPPED
  /// On hold — deliberately parked, distinct from a plain open item still
  /// waiting its turn. Excluded from "open" counts the same as SKIPPED.
  HOLD
}

/// What a template task (or the task it produced) is dated from. The two
/// original anchors were the only *governed* dates — the ones an amendment
/// can move — everything after is a plain transaction date column, the
/// template's own start day, or another task's completion.
enum DateAnchor {
  CONTRACT_DATE
  CLOSE_DATE
  LIST_DATE
  EXPIRE_DATE
  MORTGAGE_COMMITMENT_DATE
  INSPECTION_DEADLINE_DATE
  EARNEST_MONEY_DUE_DATE
  /// The day the template itself was applied to the transaction.
  TEMPLATE_START
  /// Dated off another task template entry's completion — see `dependsOnId`.
  DEPENDENCY
}

enum TaskPriority {
  NORMAL
  HIGH
  CRITICAL
}

/// What a template task actually is, beyond a checkbox.
enum TaskKind {
  TODO
  EMAIL
  CALL
}

/// The formal slots a task template (or live task) can be assigned to.
/// Resolved per-transaction: TC1/TC2 look up whichever TransactionAssignee
/// holds that slot on the file; AGENT has no user account to assign to (the
/// primary agent is a Contact, not a workspace User) and is shown as a label
/// only. An unfilled slot leaves the task/entry unassigned but still labeled.
enum AssigneeRole {
  TC1
  TC2
  AGENT
}

/// The two formal coordinator seats on a transaction. At most one
/// TransactionAssignee per seat per file (@@unique below) — a third or
/// fourth person on the file just has no slot and isn't a template target.
enum AssigneeSlot {
  TC1
  TC2
}

/// Which of the five Templates-hub tabs a group belongs to.
enum TemplateGroupKind {
  TASK
  EMAIL
  ATTACHMENT
  DATE
  DOC
}

/// CRM record — buyers, sellers, agents, lenders, vendors. Category is free
/// text on purpose (competitors allow custom categories).
/// Dual-person CRM record: one entry holds two related people (a couple, a
/// client + assistant) so mailings and document merges address both at once.
/// `name` stays the denormalized display name ("Jordan & Casey Bell") used by
/// pickers and party lists; structured person fields live alongside it, and
/// the secondary person + overflow phones/emails live in JSON.
/// A buyer or seller intake form submitted through a client portal.
/// Uploaded files become Document rows on the transaction; `data` holds the
/// answered fields keyed by field id.
///
/// Historical only — the hardcoded intake form that wrote these rows was
/// retired once designed forms (Form/FormSubmission) covered the same job.
/// Existing rows still render on the transaction page; nothing writes new
/// ones.
model IntakeSubmission {
  id            String       @id @default(uuid())
  tenantId      String       @map("tenant_id")
  tenant        Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId String       @map("transaction_id")
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  portalLinkId  String?      @map("portal_link_id")
  /// BUY_SIDE | SELL_SIDE
  side          String
  data          Json
  documentIds   String[]     @default([]) @map("document_ids")
  createdAt     DateTime     @default(now())

  @@index([tenantId, transactionId])
  @@map("intake_submission")
}

/// A TC-designed intake form. The layout is a JSON document (rows of one or
/// two cells; a cell holds a field, a divider, or a text block) authored in
/// the drag-and-drop designer and rendered server-side as a plain form.
///
/// Two axes decide who sees a form:
///   * placement — showPublic puts it on the tenant's public site, showPortal
///     puts it in client portals; neither = internal only.
///   * clientId — null is the shared version everyone gets; set makes it that
///     client's private variant, which wins over the shared one for them.
/// The unique on (tenantId, kind, clientId) keeps private-variant resolution
/// deterministic while leaving shared forms (clientId NULL, and NULLs don't
/// collide in Postgres unique indexes) free to be many.
model Form {
  id          String           @id @default(uuid())
  tenantId    String           @map("tenant_id")
  tenant      Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// "client_intake" | "transaction_intake" — a plain string (the
  /// InvoiceLine.kind precedent) so a new kind never needs a migration.
  kind        String
  /// TC-facing name, shown in the forms list and menus.
  name        String
  /// URL segment for the public form: /t/<org>/f/<slug>.
  slug        String
  /// Shown to the person filling it in.
  title       String
  description String?
  /// The row/cell document. Parsed tolerantly by lib/form-schema.ts — a
  /// malformed layout reads as empty rather than throwing on a public page.
  layout      Json
  /// "draft" | "published". Only published forms render anywhere.
  status      String           @default("draft")
  showPublic  Boolean          @default(false) @map("show_public")
  showPortal  Boolean          @default(false) @map("show_portal")
  /// Null = the shared version; set = this client's private variant.
  clientId    String?          @map("client_id")
  client      Client?          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  submissions FormSubmission[]
  accessLinks FormAccessLink[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([tenantId, slug])
  @@unique([tenantId, kind, clientId])
  @@index([tenantId])
  @@map("form")
}

/// One filled-in form. The layout it was filled against is snapshotted here,
/// so editing (or deleting) the form later never changes what a past
/// submission means — the queue and the converter always read the snapshot,
/// never the live form.
model FormSubmission {
  id                     String               @id @default(uuid())
  tenantId               String               @map("tenant_id")
  tenant                 Organization         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Nulled if the form is deleted; submissions are business records and
  /// outlive their form. formName/formKind are denormalized for that case.
  formId                 String?              @map("form_id")
  form                   Form?                @relation(fields: [formId], references: [id], onDelete: SetNull)
  formName               String               @map("form_name")
  formKind               String               @map("form_kind")
  /// The layout as filled — see the model comment.
  schemaSnapshot         Json                 @map("schema_snapshot")
  /// Answers, keyed by field key.
  data                   Json
  /// Denormalized for the review queue, so listing never parses `data`.
  submitterName          String?              @map("submitter_name")
  submitterEmail         String?              @map("submitter_email")
  submitterPhone         String?              @map("submitter_phone")
  /// Set when submitted through an identified (magic-link) session.
  clientId               String?              @map("client_id")
  client                 Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// "new" | "converted" | "dismissed" — public submissions are reviewed
  /// before anything enters the live pipeline.
  status                 String               @default("new")
  /// What the review produced, once converted.
  convertedClientId      String?              @map("converted_client_id")
  convertedTransactionId String?              @map("converted_transaction_id")
  /// Documents created from this submission's files at conversion time.
  /// Empty until someone converts it — see FormSubmissionFile.
  documentIds            String[]             @default([]) @map("document_ids")
  files                  FormSubmissionFile[]
  /// Salted hash of the submitter's IP, per tenant, used only to rate-limit
  /// public submissions. Hashed rather than stored raw: it is abuse-control
  /// data, not something the workspace ever needs to read back.
  ipHash                 String?              @map("ip_hash")
  reviewedAt             DateTime?            @map("reviewed_at")
  reviewedByName         String?              @map("reviewed_by_name")
  createdAt              DateTime             @default(now())

  @@index([tenantId, status])
  @@index([tenantId, formId])
  @@index([tenantId, ipHash, createdAt])
  @@map("form_submission")
}

/// A scoped capability to fill in ONE form as ONE known client, emailed to
/// someone who proved they own that client's address.
///
/// Deliberately not a sign-in. It grants no session, no dashboard, no
/// portal, and no read access to anything — only "open this form with your
/// details filled in". Two-factor auth on the real account is therefore
/// untouched by this, which is the whole point: new business shouldn't
/// require an authenticator app, and a forwarded link must not become an
/// account takeover. The worst a leaked link can do is queue a submission
/// a person still has to review.
///
/// Unlike PortalLink (which has no expiry at all), these die on their own.
model FormAccessLink {
  id             String       @id @default(uuid())
  tenantId       String       @map("tenant_id")
  tenant         Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  formId         String       @map("form_id")
  form           Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
  clientId       String       @map("client_id")
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// The address the link was sent to — the thing that was proven.
  email          String
  token          String       @unique
  expiresAt      DateTime     @map("expires_at")
  revokedAt      DateTime?    @map("revoked_at")
  lastAccessedAt DateTime?    @map("last_accessed_at")
  usedAt         DateTime?    @map("used_at")
  createdAt      DateTime     @default(now())

  @@index([tenantId, formId])
  @@map("form_access_link")
}

/// A closing's follow-up: the one time a TC gets to ask how it went.
///
/// One row per file per ask, created by the nightly job a few days after
/// close and carrying its own capability token — the client answers without
/// an account, the way portal and form links already work. The response
/// fields stay null until they actually answer, so a row is both "we asked"
/// and "here is what they said", and the row itself is the record that
/// stops the same file being asked twice.
///
/// The coordinator's name is copied in, not just referenced: people leave a
/// workspace, and a review of "Dana" should still read as a review of Dana
/// a year later. The user link is kept as well, so the dashboard can still
/// group by person while they're around.
///
/// No RLS — same as portal_link, unlike form_access_link. This is looked up
/// by its bare token before the tenant is known (like a portal link);
/// form_access_link is always resolved after the org is known from a URL
/// slug. The token (24 random bytes) is the authorization; every read or
/// write after the lookup still goes through withTenant(review.tenantId).
model ClientReview {
  id                String       @id @default(uuid())
  tenantId          String       @map("tenant_id")
  tenant            Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId     String       @unique @map("transaction_id")
  transaction       Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  clientId          String       @map("client_id")
  client            Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// The coordinator this file was assigned to when the ask went out.
  coordinatorId     String?      @map("coordinator_id")
  coordinator       User?        @relation(fields: [coordinatorId], references: [id], onDelete: SetNull)
  coordinatorName   String?      @map("coordinator_name")
  /// The address it was sent to — what the answer is attributable to.
  email             String
  token             String       @unique
  expiresAt         DateTime     @map("expires_at")
  revokedAt         DateTime?    @map("revoked_at")
  sentAt            DateTime?    @map("sent_at")
  /// 1-5. Null until they answer; the coordinator score is optional even
  /// then, because a client who never dealt with a named person shouldn't
  /// be made to invent an opinion about one.
  businessRating    Int?         @map("business_rating")
  coordinatorRating Int?         @map("coordinator_rating")
  comment           String?
  /// Explicit consent to quote them. Off unless they tick it — a private
  /// answer stays private, and this is the only thing that could ever make
  /// one public.
  publishAllowed    Boolean      @default(false) @map("publish_allowed")
  answeredAt        DateTime?    @map("answered_at")
  createdAt         DateTime     @default(now())

  @@index([tenantId, answeredAt])
  @@index([tenantId, coordinatorId])
  @@map("client_review")
}

/// One row per "is this email one of yours?" check on a public form.
///
/// The public form tells a visitor whether their address is already a
/// client — good for the returning client, but it also means the endpoint
/// could be used to probe who a TC's clients are. This table is what makes
/// the answer rate-limitable: attempts are counted whatever the outcome,
/// so a script gets cut off long before it can enumerate a client list.
/// Holds no address, only the salted per-tenant hash of the source.
model FormLookupAttempt {
  id        String       @id @default(uuid())
  tenantId  String       @map("tenant_id")
  tenant    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ipHash    String       @map("ip_hash")
  createdAt DateTime     @default(now())

  @@index([tenantId, ipHash, createdAt])
  @@map("form_lookup_attempt")
}

/// A file uploaded with a submission. Deliberately NOT a Document: a
/// Document belongs to a transaction and shows up in the workspace's
/// document library, and nothing a stranger uploads should land there
/// before a person has looked at it. These become Documents on the new
/// transaction at conversion time, and die with the submission otherwise.
model FormSubmissionFile {
  id              String         @id @default(uuid())
  tenantId        String         @map("tenant_id")
  tenant          Organization   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submissionId    String         @map("submission_id")
  submission      FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  /// The answer key of the file field this arrived on.
  fieldKey        String         @map("field_key")
  filename        String
  contentType     String         @map("content_type")
  sizeBytes       Int            @map("size_bytes")
  data            Bytes?
  storageKey      String?        @map("storage_key")
  storageProvider String?        @map("storage_provider")
  createdAt       DateTime       @default(now())

  @@index([tenantId, submissionId])
  @@map("form_submission_file")
}

/// Which agents (contacts) work under a managed client (team/brokerage).
/// Portal access is granted per agent from the client page; agents without
/// a portal simply have no portal_link row.
model ClientAgent {
  id        String       @id @default(uuid())
  tenantId  String       @map("tenant_id")
  tenant    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId  String       @map("client_id")
  client    Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId String       @map("contact_id")
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([clientId, contactId])
  @@index([tenantId])
  @@map("client_agent")
}

model Contact {
  id                 String             @id @default(uuid())
  tenantId           String             @map("tenant_id")
  tenant             Organization       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Many-to-many: a contact can be covered by more than one coordinator, and
  /// pretending otherwise made one of them wrong every time somebody shared a
  /// brokerage or went on holiday.
  owners             ContactOwner[]
  name               String
  email              String?
  phone              String?
  category           String             @default("Other")
  rating             Int?
  touchDate          DateTime?          @map("touch_date") @db.Date
  notes              String?
  // --- dual-person CRM fields ---
  personTitle        String?            @map("person_title")
  firstName          String?            @map("first_name")
  middleName         String?            @map("middle_name")
  lastName           String?            @map("last_name")
  jobTitle           String?            @map("job_title")
  company            String?
  /// An agent's team is a different thing from their brokerage, and a
  /// mail-merge addresses one or the other.
  teamName           String?            @map("team_name")
  website            String?
  workPhone          String?            @map("work_phone")
  fax                String?
  /// Secondary person (spouse/assistant): {title,first,middle,last,jobTitle,cell,workPhone,email}
  secondary          Json?
  /// Overflow contact points: {phones: string[], emails: string[]}
  extraContacts      Json?              @map("extra_contacts")
  categories         String[]           @default([])
  /// Relationship grade A-D; drives the auto-prospecting cadence.
  grade              String?
  /// When this contact is next due in the prospecting queue.
  nextTouchAt        DateTime?          @map("next_touch_at") @db.Date
  homeAddress        Json?              @map("home_address")
  workAddress        Json?              @map("work_address")
  referredById       String?            @map("referred_by_id")
  referredBy         Contact?           @relation("ContactReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals          Contact[]          @relation("ContactReferrals")
  /// Licence numbers a coordinator copies off a contract constantly.
  brokerageLicense   String?            @map("brokerage_license")
  salespersonLicense String?            @map("salesperson_license")
  /// Which address post actually goes to: "home" or "work". Storing both
  /// and guessing is how a mailer reaches an office that closed.
  mailingAddress     String             @default("work") @map("mailing_address")
  /// The second person's name and email, lowercased, so looking them up is an
  /// indexed match rather than a scan through a JSON blob. Maintained by
  /// parseContactForm — the only thing that writes `secondary`.
  secondarySearch    String?            @map("secondary_search")
  referralSource     String?            @map("referral_source")
  referralDate       DateTime?          @map("referral_date") @db.Date
  /// BUYER | SELLER | NONE
  leadType           String?            @map("lead_type")
  /// Buyer: {cultivating,location,range,income}; Seller: {cultivating,address,listPrice,netProceeds}
  leadDetails        Json?              @map("lead_details")
  /// {birthday:{m,d,y?}, birthdayAlt, weddingAnniversary, purchaseAnniversary}
  touchDates         Json?              @map("touch_dates")
  photoUrl           String?            @map("photo_url")
  /// {facebook, instagram, linkedin, x, youtube, other}
  socialLinks        Json?              @map("social_links")
  isSample           Boolean            @default(false)
  parties            TransactionParty[]
  /// Files where this contact is our side's agent (see Transaction).
  primaryAgentFor    Transaction[]      @relation("TxnPrimaryAgent")
  coAgentFor         Transaction[]      @relation("TxnCoAgent")
  contactNotes       ContactNote[]
  emails             Email[]
  tasks              Task[]
  credentials        VaultCredential[]
  agentOf            ClientAgent[]
  portalLinks        PortalLink[]
  /// Working-relationship grade — the vendor who never turns up, the
  /// attorney who always does. Distinct from `grade` directly above, which is
  /// the A–D prospecting cadence driving how often to make contact. Two
  /// different questions: "how often should I call them" versus "do we want
  /// to work with them at all", and a contact can be both worth chasing and
  /// painful to deal with.
  handbookGrade      HandbookGrade?     @map("handbook_grade")
  handbookGradeNote  String?            @map("handbook_grade_note")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([tenantId, category])
  @@index([tenantId, nextTouchAt])
  @@map("contact")
}

/// Transactional email with reply capture. Outbound goes through Resend from
/// the tenant's identity on the shared mail domain; each message carries a
/// per-thread reply token, and inbound replies post back via webhook and
/// attach here. This IS the mailbox — storage is rows + document attachments.
enum EmailDirection {
  OUTBOUND
  INBOUND
}

/// Reply-token → tenant mapping for the inbound webhook. Deliberately has NO
/// row-level security (same reasoning as portal_link): the webhook arrives
/// with no tenant context and the unguessable token IS the capability; the
/// email bodies themselves stay in the RLS-protected email table.
model EmailThread {
  token         String   @id
  tenantId      String   @map("tenant_id")
  transactionId String?  @map("transaction_id")
  contactId     String?  @map("contact_id")
  /// Set when the thread is a vendor order emailed to an unregistered vendor;
  /// their reply routes to the AI-proposal path instead of plain thread capture.
  orderId       String?  @map("order_id")
  providerId    String?  @map("provider_id")
  createdAt     DateTime @default(now())

  @@index([providerId])
  @@map("email_thread")
}

/// EmailThread's counterpart for the send-as-self path: the Nylas webhook
/// arrives with a message id and a thread id, nothing else, and Email is
/// RLS-protected — a query against it with no `app.tenant_id` set (the
/// webhook has no tenant context yet) matches nothing under the app role,
/// not "everything," so this lookup cannot go through Email directly.
/// One row per Nylas send, deliberately with no RLS, same reasoning as
/// EmailThread above.
model NylasSend {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  transactionId String?  @map("transaction_id")
  contactId     String?  @map("contact_id")
  /// The Nylas message id — resolves "is this webhook notifying on a message
  /// we just sent" without re-recording our own outbound content as a reply.
  providerId    String   @unique @map("provider_id")
  /// The Nylas thread id — resolves "which file does a reply on this
  /// conversation belong to."
  nylasThreadId String   @map("nylas_thread_id")
  createdAt     DateTime @default(now())

  @@index([nylasThreadId])
  @@map("nylas_send")
}

model Email {
  id              String         @id @default(uuid())
  tenantId        String         @map("tenant_id")
  tenant          Organization   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId   String?
  transaction     Transaction?   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  contactId       String?        @map("contact_id")
  contact         Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  direction       EmailDirection
  fromAddr        String         @map("from_addr")
  toAddr          String         @map("to_addr")
  subject         String
  bodyText        String         @map("body_text")
  /// Reply capture token; inbound mail to reply+<token>@ matches the thread.
  /// Null on mail sent from a coordinator's own mailbox — that path doesn't
  /// rewrite Reply-To (the whole point is that the recipient replies to a
  /// real person), so replies come back through the Nylas ids below instead.
  replyToken      String?        @map("reply_token")
  providerId      String?        @map("provider_id")
  /// Set when this went out through a coordinator's connected mailbox rather
  /// than the workspace's shared address. The thread id is what an inbound
  /// reply carries, so it's the hook that puts that reply on this file.
  nylasThreadId   String?        @map("nylas_thread_id")
  nylasSentBy     String?        @map("nylas_sent_by")
  /// Set only while status is SCHEDULED on the Nylas path: the schedule Nylas
  /// is holding hasn't produced a real message/thread id yet, so this is the
  /// only handle this row has until send completes. Matched by cancelScheduled
  /// (flips to CANCELLED) and the send-completion webhook (flips to SENT,
  /// fills in providerId/nylasThreadId, and clears this).
  nylasScheduleId String?        @map("nylas_schedule_id")
  status          String         @default("SENT")
  createdAt       DateTime       @default(now())

  @@index([tenantId, transactionId, createdAt])
  @@index([replyToken])
  @@index([nylasThreadId])
  @@index([nylasScheduleId])
  @@map("email")
}

/// Notes a TC keeps about a client (the backend client page).
model ClientNote {
  id        String       @id @default(uuid())
  tenantId  String       @map("tenant_id")
  tenant    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId  String       @map("client_id")
  client    Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId  String?      @map("author_id")
  body      String
  createdAt DateTime     @default(now())

  @@index([tenantId, clientId, createdAt])
  @@map("client_note")
}

/// Timestamped CRM notes on a contact (the Notes tab + quick-add).
/// Who covers a contact. Many-to-many so shared and stand-in coverage is
/// representable; deleting either side removes the link, never the record.
model ContactOwner {
  id        String       @id @default(uuid())
  tenantId  String       @map("tenant_id")
  tenant    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId String       @map("contact_id")
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userId    String       @map("user_id")
  user      User         @relation("ContactOwner", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([contactId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("contact_owner")
}

model ContactNote {
  id        String       @id @default(uuid())
  tenantId  String       @map("tenant_id")
  tenant    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId String       @map("contact_id")
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  authorId  String?      @map("author_id")
  body      String
  createdAt DateTime     @default(now())

  @@index([tenantId, contactId, createdAt])
  @@map("contact_note")
}

/// The central object: one closing. Belongs to a tenant, optionally to the
/// client (agent/brokerage) the tenant serves it for.
model Transaction {
  id                     String                        @id @default(uuid())
  tenantId               String                        @map("tenant_id")
  tenant                 Organization                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId               String?
  client                 Client?                       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  status                 TransactionStatus             @default(UNDER_CONTRACT)
  side                   TransactionSide               @default(BUY_SIDE)
  propertyAddress        String                        @map("property_address")
  city                   String?
  state                  String?
  zip                    String?
  purchasePrice          Int?                          @map("purchase_price")
  listPrice              Int?                          @map("list_price")
  listDate               DateTime?                     @map("list_date") @db.Date
  onMarketDate           DateTime?                     @map("on_market_date") @db.Date
  expireDate             DateTime?                     @map("expire_date") @db.Date
  mlsId                  String?                       @map("mls_id")
  /// Our own side's agents on this file, as CRM contacts. Distinct from
  /// `parties` (which records both sides as read off the contract) and from
  /// `client` (who hired us — for a brokerage client the primary agent is one
  /// of their roster). Workspace users are assigned through
  /// TransactionAssignee rows, not here.
  primaryAgentContactId  String?                       @map("primary_agent_contact_id")
  primaryAgentContact    Contact?                      @relation("TxnPrimaryAgent", fields: [primaryAgentContactId], references: [id], onDelete: SetNull)
  coAgentContactId       String?                       @map("co_agent_contact_id")
  coAgentContact         Contact?                      @relation("TxnCoAgent", fields: [coAgentContactId], references: [id], onDelete: SetNull)
  /// What our client earns on this file, as a percentage of the contract
  /// price. One number, not a per-side split: the side is explicit on the
  /// file, so a second percentage only ever described the other party.
  commissionPct          Float?                        @map("commission_pct")
  /// Typed, not computed. A contract rarely states the gross, and the actual
  /// figure only exists once the broker pays the agent — the gap between the
  /// two is the thing worth chasing.
  estimatedGrossCents    Int?                          @map("estimated_gross_cents")
  actualGrossCents       Int?                          @map("actual_gross_cents")
  commissionNote         String?                       @map("commission_note")
  assignees              TransactionAssignee[]
  review                 ClientReview?
  emails                 Email[]
  /// Contract-governed date changes awaiting an executed amendment:
  /// {closeDate?: "YYYY-MM-DD", contractDate?: "YYYY-MM-DD"}
  proposedDates          Json?                         @map("proposed_dates")
  contractDate           DateTime?                     @map("contract_date") @db.Date
  closeDate              DateTime?                     @map("close_date") @db.Date
  /// Critical dates, in escalation priority order: closing (above), then
  /// mortgage commitment, then the inspection deadline. Inside the alert
  /// window before any of these, a file is called stale far sooner — see
  /// lib/transaction-alerts.ts. Kept as first-class columns (not tasks) so
  /// the alert query never depends on task titles matching a phrase.
  mortgageCommitmentDate DateTime?                     @map("mortgage_commitment_date") @db.Date
  inspectionDeadlineDate DateTime?                     @map("inspection_deadline_date") @db.Date
  /// When the earnest money / due-diligence fee is owed — usually a few
  /// business days after the contract date. A real column, not a task, for
  /// the same reason as the two above: it needs to be a date-template
  /// anchor and show on the key-dates calendar without depending on a task
  /// title.
  earnestMoneyDueDate    DateTime?                     @map("earnest_money_due_date") @db.Date
  /// What the tenant expects to charge for this file — the anchor the trust
  /// surface compares actual billing against. Auto-filled from the client's
  /// default fee (else the workspace default) when the file is created;
  /// editable per file. 0 = deliberately no charge; null = never set.
  expectedFeeCents       Int?                          @map("expected_fee_cents")
  notes                  String?
  customFields           Json?                         @map("custom_fields")
  /// Parties pulled from the contract (buyer, seller, attorneys, title, agents)
  /// as a permanent, locked panel — an ordered array of { role, value }. Kept
  /// out of customFields so they can't be casually deleted, and distinct from
  /// the CRM-linked `parties` relation (this is text, no Contact rows).
  contractParties        Json?                         @map("contract_parties")
  /// Per-transaction pro-AI unlock. A Free workspace spends one credit to turn
  /// this on for a single transaction; once on it stays on (contract
  /// extraction, AI classify, in-transaction dictation). Paid tiers are pro
  /// implicitly and never set this.
  proFeaturesEnabled     Boolean                       @default(false) @map("pro_features_enabled")
  proEnabledAt           DateTime?                     @map("pro_enabled_at")
  proEnabledBy           String?                       @map("pro_enabled_by")
  isSample               Boolean                       @default(false)
  parties                TransactionParty[]
  requiredDocuments      TransactionRequiredDocument[]
  tasks                  Task[]
  documents              Document[]
  extractions            ContractExtraction[]
  envelopes              SignatureEnvelope[]
  portalLinks            PortalLink[]
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  invoices               Invoice[]
  invoiceLines           InvoiceLine[]
  intakeSubmissions      IntakeSubmission[]
  compliance             TransactionCompliance[]
  vendorOrders           VendorOrder[]
  activity               TransactionActivity[]

  @@index([tenantId, status])
  @@map("transaction")
}

// --- Stage 04: client portals + credential vault ---

/// Shareable read-only portal access to one transaction. The random token IS
/// the capability — portal pages are unauthenticated by design (TCs text
/// these links to buyers/sellers).
///
/// ⚠️ Deliberately NOT covered by row-level security: the public portal route
/// must resolve a bare token with no tenant context. The table carries only
/// the token, display toggles, and foreign keys; all transaction data is then
/// fetched through withTenant() using the link's own tenant id.
/// Who a portal link serves. CLIENT = buyer/seller simplified view of one
/// transaction; AGENT = the managed-agent portal, scoped to a Client record
/// and covering all of that client's transactions.
enum PortalAudience {
  CLIENT
  AGENT
}

model PortalLink {
  id               String         @id @default(uuid())
  tenantId         String         @map("tenant_id")
  tenant           Organization   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  audience         PortalAudience @default(CLIENT)
  transactionId    String?
  transaction      Transaction?   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  clientId         String?        @map("client_id")
  client           Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId        String?        @map("contact_id")
  contact          Contact?       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  token            String         @unique
  label            String
  showTasks        Boolean        @default(true) @map("show_tasks")
  showDocuments    Boolean        @default(false) @map("show_documents")
  showParties      Boolean        @default(true) @map("show_parties")
  /// Opt-in: let this client order the workspace's connected vendors from the
  /// portal, and see those orders' status and appointments. Off by default.
  showVendorOrders Boolean        @default(false) @map("show_vendor_orders")
  revokedAt        DateTime?      @map("revoked_at")
  lastAccessedAt   DateTime?      @map("last_accessed_at")
  emailedActivity  TransactionActivity[]
  createdAt        DateTime       @default(now())

  @@index([tenantId])
  @@index([transactionId])
  @@map("portal_link")
}

/**
 * Public API keys. Like portal_link, this table deliberately has NO RLS
 * policy: the key hash IS the capability, and the API must look it up
 * before any tenant context exists. Only the SHA-256 hash is stored.
 */
model ApiKey {
  id         String       @id @default(uuid())
  tenantId   String       @map("tenant_id")
  tenant     Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  prefix     String
  hash       String       @unique
  createdAt  DateTime     @default(now())
  lastUsedAt DateTime?    @map("last_used_at")
  revokedAt  DateTime?    @map("revoked_at")

  @@index([tenantId])
  @@map("api_key")
}

/// Global platform configuration, editable from /admin — a single row (there's
/// exactly one Freehold), self-created on first read. No tenant, no RLS: this
/// is operator-only, the same root-table shape as Vendor and ApiKey.
///
/// The founderCall* fields back the homepage voice demo's "call the developer"
/// feature: a kill switch, the cooldown between calls, and the last-call
/// timestamp that cooldown is measured against. founderLastCallAt is claimed
/// with a single conditional UPDATE (see platform-settings.ts) so two visitors
/// racing for the same slot can't both win it.
model PlatformSetting {
  id                         String    @id @default("singleton")
  founderCallsAvailable      Boolean   @default(false) @map("founder_calls_available")
  founderCallCooldownMinutes Int       @default(15) @map("founder_call_cooldown_minutes")
  founderCallSellingPoints   String?   @map("founder_call_selling_points")
  founderLastCallAt          DateTime? @map("founder_last_call_at")
  /// STT/TTS provider+model routed through LiveKit's own hosted inference
  /// (billed per-minute through LiveKit, no vendor key needed) — e.g.
  /// "deepgram/nova-3", "elevenlabs/eleven_turbo_v2_5". Read by the agent on
  /// every session via the same /api/voice/data brief it already fetches, so
  /// a change here takes effect on the very next call, no redeploy. The LLM
  /// stays a fixed direct Anthropic call (Claude isn't in LiveKit's
  /// inference catalog) — not editable here on purpose.
  voiceSttModel              String    @default("deepgram/nova-3") @map("voice_stt_model")
  voiceTtsModel              String    @default("elevenlabs/eleven_turbo_v2_5") @map("voice_tts_model")
  /// Model for the Handbook's "Today at a glance" summary. Deliberately not
  /// the extraction model: extraction reads a contract nobody has checked and
  /// its mistakes land on the file, while this restates work already held and
  /// writes nothing.
  ///
  /// Sonnet rather than Haiku, decided by comparing both on real data. The
  /// gap wasn't prose quality: Sonnet noticed that a file full of slipping
  /// dates was exactly the situation a client's "phone call if a date moves"
  /// note was written for, and said so. Haiku restated the same facts without
  /// connecting them. Applying a note to today's circumstances is the whole
  /// point of the feature, and it costs about half a cent a briefing.
  handbookModel              String    @default("claude-sonnet-5") @map("handbook_model")
  /// Extended thinking for that summary. Off by default — the task is
  /// restating supplied facts, not reasoning about them.
  handbookThinking           Boolean   @default(false) @map("handbook_thinking")
  /// Overrides the bundled house style for the summary's prose. Null = the
  /// default in lib/handbook/style.ts, which ships in the repo so a
  /// self-hosted install always has one.
  handbookStyleGuide         String?   @map("handbook_style_guide")
  /// Cross-tenant guidance shown above the per-state list on
  /// /admin/states and on the tenant-facing Operating states helper —
  /// the general rule (unlicensed TCs as broker-supervised admin only;
  /// several states require a license for independent contract TC work)
  /// that applies before any state-specific note.
  tcLicenseGeneralRule       String?   @map("tc_license_general_rule")
  /// The Freehold Cloud pitch shown on self-hosted installs — monthly on the
  /// bell, and as a banner in workspace Settings. Null or blank = the bundled
  /// default in lib/cloud-prompt.ts, which ships in the repo so an install
  /// that has never had an operator still has something to say.
  cloudPromptText            String?   @map("cloud_prompt_text")
  /// Whether to show that prompt at all. Freehold is source-available and
  /// self-hosting is a supported choice, so an operator can remove the upsell
  /// from their install outright rather than only reword it.
  cloudPromptEnabled         Boolean   @default(true) @map("cloud_prompt_enabled")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  @@map("platform_setting")
}

model WebhookEndpoint {
  id        String       @id @default(uuid())
  tenantId  String       @map("tenant_id")
  tenant    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url       String
  secret    String
  events    String[]
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())

  @@index([tenantId])
  @@map("webhook_endpoint")
}

enum InvoiceStatus {
  /// Being assembled (by hand or by scheduled billing); has no number hold on
  /// the client's attention yet — not sent, not owed, not counted outstanding.
  DRAFT
  SENT
  PAID
  VOID
}

/**
 * Client invoicing: the tenant bills their client through Stripe.
 */
/// A tenant billing their client. Payment-method-agnostic by design: clients
/// pay by check, Zelle, wire, or out of closing proceeds, so Freehold's job is
/// the document, the record, and the follow-up — never the payment rail. No
/// processor is involved; "paid" is whatever the tenant says it is.
model Invoice {
  id             String              @id @default(uuid())
  tenantId       String              @map("tenant_id")
  tenant         Organization        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  transactionId  String?
  transaction    Transaction?        @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  /// Per-tenant sequence, rendered as INV-0001.
  number         Int
  /// Where this invoice actually lives: "freehold" (we are the record) or
  /// "erpnext" (created in the tenant's ERP; status mirrored from there).
  provider       String              @default("freehold")
  /// The Sales Invoice name in their ERPNext, e.g. ACC-SINV-2026-00007.
  externalId     String?             @map("external_id")
  description    String
  /// Denormalized total: always sum(lines.amountCents), recomputed by the one
  /// writer in lib/actions whenever lines change. Kept as a column so list
  /// queries, reports, and the ERPNext mirror never join lines for a total.
  amountCents    Int                 @map("amount_cents")
  /// How it's to be paid — "Due at closing", "Net 30", or free text.
  paymentTerms   String?             @map("payment_terms")
  dueDate        DateTime?           @map("due_date") @db.Date
  /// SENT means outstanding; issuing and emailing are separate facts.
  status         InvoiceStatus       @default(SENT)
  /// When the invoice email actually went out.
  sentAt         DateTime?           @map("sent_at")
  /// How it was settled — "check #1042 at closing".
  paidNote       String?             @map("paid_note")
  /// The nag: an open task that closes only when the invoice is resolved.
  followUpTaskId String?             @map("follow_up_task_id")
  followUpTask   Task?               @relation(fields: [followUpTaskId], references: [id], onDelete: SetNull)
  lines          InvoiceLine[]
  payments       InvoicePayment[]
  /// Client-credit entries applied against this invoice (kind "applied").
  creditEntries  ClientCreditEntry[]
  emailLogs      InvoiceEmailLog[]
  createdAt      DateTime            @default(now())
  paidAt         DateTime?           @map("paid_at")

  @@unique([tenantId, number])
  @@index([tenantId])
  @@map("invoice")
}

/// Every time an invoice was actually emailed — not just the last one.
/// Invoice.sentAt only ever holds the latest timestamp, which can't answer
/// "did we already send this to the closing attorney" once a second send
/// (to a different recipient) overwrites it. Kept even after more sends
/// happen, so the row under each invoice reads as real history, not a
/// single fact that silently changes underneath a bookmark.
model InvoiceEmailLog {
  id         String       @id @default(uuid())
  tenantId   String       @map("tenant_id")
  tenant     Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId  String       @map("invoice_id")
  invoice    Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  to         String
  sentByName String       @map("sent_by_name")
  createdAt  DateTime     @default(now())

  @@index([tenantId, invoiceId, createdAt])
  @@map("invoice_email_log")
}

/// One charge on an invoice: the base fee, an up-charge for extra work, a
/// late fee, a deposit toward a file, a discount (negative). Consolidated
/// weekly/monthly invoices carry one line per file, so transactionId lives
/// here as well as on the invoice — the invoice-level link means "this whole
/// invoice is about that file"; the line-level link says which file each
/// charge belongs to, which is what per-file revenue reporting reads.
model InvoiceLine {
  id            String       @id @default(uuid())
  tenantId      String       @map("tenant_id")
  tenant        Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId     String       @map("invoice_id")
  invoice       Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  transactionId String?      @map("transaction_id")
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  /// "service" | "upcharge" | "late_fee" | "deposit" | "adjustment" — a plain
  /// string (like EmailTemplate.category) so new kinds never need a migration.
  kind          String       @default("service")
  description   String
  /// Signed: discounts and credits on an invoice are negative lines.
  amountCents   Int          @map("amount_cents")
  sortOrder     Int          @default(0) @map("sort_order")
  createdAt     DateTime     @default(now())

  @@index([tenantId, invoiceId])
  @@index([tenantId, transactionId])
  @@map("invoice_line")
}

/// Money held on a client's account rather than against a specific invoice —
/// retainers and pre-payments from long-standing clients. Append-only:
/// balance = sum(amountCents), corrections are new entries, never edits.
/// Applying credit to an invoice writes an "applied" entry here (negative)
/// and a paired InvoicePayment (source "credit") in the same transaction, so
/// both sides of the movement are on the books.
model ClientCreditEntry {
  id             String          @id @default(uuid())
  tenantId       String          @map("tenant_id")
  tenant         Organization    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId       String          @map("client_id")
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Signed: deposits positive; "applied" / "refund" negative.
  amountCents    Int             @map("amount_cents")
  /// "deposit" | "applied" | "refund" | "adjustment".
  kind           String
  method         String?
  reference      String?
  note           String?
  /// For "applied" entries: the invoice the credit went to.
  invoiceId      String?         @map("invoice_id")
  invoice        Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payment        InvoicePayment?
  /// Denormalized (auth-table boundary — same reasoning as TransactionActivity).
  recordedByName String?         @map("recorded_by_name")
  receivedAt     DateTime        @default(now()) @map("received_at")
  createdAt      DateTime        @default(now())

  @@index([tenantId, clientId])
  @@map("client_credit_entry")
}

/// The incoming-money ledger for an invoice. Append-only: a bounced check is
/// a reversal entry (negative amount pointing at the original), never an
/// edit or delete — the books always show what happened, in order. Partial
/// payments are just entries smaller than the balance. ERPNext-provider
/// invoices don't use this ledger; their ERP is the record and Freehold only
/// mirrors the status.
model InvoicePayment {
  id             String             @id @default(uuid())
  tenantId       String             @map("tenant_id")
  tenant         Organization       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId      String             @map("invoice_id")
  invoice        Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// Signed: payments positive, reversals negative.
  amountCents    Int                @map("amount_cents")
  /// "Check", "Wire", "Zelle", "Closing proceeds", … free text.
  method         String?
  /// Check number, wire memo — whatever identifies it at the bank.
  reference      String?
  note           String?
  /// "direct" | "credit" (paid from the client's on-account balance).
  source         String             @default("direct")
  creditEntryId  String?            @unique @map("credit_entry_id")
  creditEntry    ClientCreditEntry? @relation(fields: [creditEntryId], references: [id], onDelete: SetNull)
  /// A reversal points at the entry it reverses.
  reversesId     String?            @map("reverses_id")
  reverses       InvoicePayment?    @relation("PaymentReversal", fields: [reversesId], references: [id], onDelete: SetNull)
  reversedBy     InvoicePayment[]   @relation("PaymentReversal")
  recordedByName String?            @map("recorded_by_name")
  /// When the money actually arrived (editable), vs createdAt (when recorded).
  receivedAt     DateTime           @default(now()) @map("received_at")
  createdAt      DateTime           @default(now())

  @@index([tenantId, invoiceId])
  @@map("invoice_payment")
}

enum VaultAction {
  CREATED
  UPDATED
  REVEALED
  DELETED
}

/// Envelope-encrypted third-party credential (MLS, lender portals, e-sign accounts)
/// stored on a client's behalf. The secret never exists in plaintext at rest:
/// AES-256-GCM under a per-credential data key, itself wrapped by
/// VAULT_MASTER_KEY (see packages/vault). Reveals are audited — Freehold
/// stores and audits credentials; it never logs into anything automatically.
model VaultCredential {
  id         String           @id @default(uuid())
  tenantId   String           @map("tenant_id")
  tenant     Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId   String?
  client     Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  contactId  String?          @map("contact_id")
  contact    Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  system     String
  username   String
  url        String?
  notes      String?
  ciphertext String
  iv         String
  tag        String
  wrappedKey String           @map("wrapped_key")
  wrapIv     String           @map("wrap_iv")
  wrapTag    String           @map("wrap_tag")
  keyVersion Int              @default(1) @map("key_version")
  accessLogs VaultAccessLog[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([tenantId])
  @@map("vault_credential")
}

/// "This file is being worked" — one row per meaningful action a user takes
/// on a transaction (task completed, document uploaded, email sent, dates
/// changed). Deliberately separate from AuditLog: that table is the low-volume
/// compliance record of sensitive events and is read unfiltered by the
/// Settings audit view, so routine work would drown it. This one is
/// high-volume, transaction-scoped, and indexed for the hot "when was this
/// last touched, by whom" lookup that drives every staleness alert.
///
/// actorName is denormalized on purpose: `user` is a Better Auth table
/// outside tenant RLS, so a briefing or dashboard row must never need to join
/// across that boundary just to print who did something.
model TransactionActivity {
  id            String       @id @default(uuid())
  tenantId      String       @map("tenant_id")
  tenant        Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId String       @map("transaction_id")
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  actorId       String?      @map("actor_id")
  actorName     String       @map("actor_name")
  /// Stable machine key (task.completed, document.uploaded, …) for grouping.
  action        String
  /// Human sentence shown in the UI, the briefing email, and the PDF.
  summary       String
  /// Set on "email.sent" rows that carried exactly one attachment, so a
  /// document's row can show who it was last emailed to without scraping
  /// free-text summaries. SetNull rather than cascade: the document is gone,
  /// but the fact that it was once emailed to someone is still worth keeping.
  documentId    String?      @map("document_id")
  document      Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  /// Same idea for "portal.emailed" rows, so a link's row can show its own
  /// last-sent-to instead of only appearing in the general activity feed.
  portalLinkId  String?      @map("portal_link_id")
  portalLink    PortalLink?  @relation(fields: [portalLinkId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([tenantId, transactionId, createdAt])
  @@index([documentId])
  @@index([portalLinkId])
  @@map("transaction_activity")
}

model AuditLog {
  id          String       @id @default(uuid())
  tenantId    String       @map("tenant_id")
  tenant      Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId     String?      @map("actor_id")
  actorEmail  String?      @map("actor_email")
  action      String
  subjectType String?      @map("subject_type")
  subjectId   String?      @map("subject_id")
  summary     String
  createdAt   DateTime     @default(now())

  @@index([tenantId, createdAt])
  @@map("audit_log")
}

model VaultAccessLog {
  id           String           @id @default(uuid())
  tenantId     String           @map("tenant_id")
  tenant       Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  credentialId String?
  credential   VaultCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  userId       String
  action       VaultAction
  detail       String?
  createdAt    DateTime         @default(now())

  @@index([tenantId, createdAt])
  @@map("vault_access_log")
}

model TransactionParty {
  id            String       @id @default(uuid())
  tenantId      String       @map("tenant_id")
  tenant        Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  contactId     String
  contact       Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  role          PartyRole
  createdAt     DateTime     @default(now())

  @@unique([transactionId, contactId, role])
  @@index([tenantId])
  @@map("transaction_party")
}

model Task {
  id               String        @id @default(uuid())
  tenantId         String        @map("tenant_id")
  tenant           Organization  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId    String?
  transaction      Transaction?  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  title            String
  notes            String?
  dueDate          DateTime?     @map("due_date") @db.Date
  status           TaskStatus    @default(OPEN)
  priority         TaskPriority  @default(NORMAL)
  kind             TaskKind      @default(TODO)
  /// A milestone reads as a bigger deal on the calendar/timeline views —
  /// "closed & funded", not "update MLS status".
  milestone        Boolean       @default(false)
  /// Off hides a dated task from the calendar without deleting it — a
  /// reminder-only entry that would otherwise clutter the month view.
  onCalendar       Boolean       @default(true) @map("on_calendar")
  /// The formal seat this task was assigned to, independent of whether that
  /// seat is currently filled (see AssigneeRole). AGENT tasks never get an
  /// `assigneeId` — there's no User to point at — this is what the row
  /// label reads instead.
  assigneeRole     AssigneeRole? @map("assignee_role")
  /// Provenance for domino recomputation: tasks instantiated from an action
  /// plan keep their anchor + offset so a confirmed date change re-dates them.
  anchor           DateAnchor?
  offsetDays       Int?          @map("offset_days")
  /// Dated off another task's completion instead of a transaction date
  /// (anchor = DEPENDENCY). Self-referencing so a chain of thank-you/invoice
  /// tasks can each depend on the one before it.
  dependsOnTaskId  String?       @map("depends_on_task_id")
  dependsOnTask    Task?         @relation("TaskDependency", fields: [dependsOnTaskId], references: [id], onDelete: SetNull)
  dependents       Task[]        @relation("TaskDependency")
  /// Manually re-dated tasks opt out of recomputation.
  dueDateEdited    Boolean       @default(false) @map("due_date_edited")
  /// Set when this task exists to get a date amendment executed ("closeDate"/"contractDate").
  proposedFor      String?       @map("proposed_for")
  /// Carried from the action-plan template task: default email template.
  emailTemplateId  String?       @map("email_template_id")
  autoSendEmail    Boolean       @default(false) @map("auto_send_email")
  completedAt      DateTime?     @map("completed_at")
  contactId        String?       @map("contact_id")
  contact          Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  /// Per-audience portal visibility, toggled from the transaction screen.
  visibleToAgent   Boolean       @default(true) @map("visible_to_agent")
  visibleToClient  Boolean       @default(true) @map("visible_to_client")
  assigneeId       String?
  assignee         User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  sortOrder        Int           @default(0) @map("sort_order")
  isSample         Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  invoiceFollowUps Invoice[]

  @@index([tenantId, status, dueDate])
  @@map("task")
}

/// Reusable checklist template ("Texas buy-side closing, 30 tasks").
model ActionPlan {
  id          String               @id @default(uuid())
  tenantId    String               @map("tenant_id")
  tenant      Organization         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groupId     String?              @map("group_id")
  group       TemplateGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  name        String
  description String?
  isSample    Boolean              @default(false)
  tasks       ActionPlanTask[]
  documents   ActionPlanDocument[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([tenantId])
  @@index([tenantId, groupId])
  @@map("action_plan")
}

/// A document a plan expects on the file — the checklist template. Applying the
/// plan seeds one TransactionRequiredDocument per row alongside the tasks.
model ActionPlanDocument {
  id           String       @id @default(uuid())
  tenantId     String       @map("tenant_id")
  tenant       Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actionPlanId String       @map("action_plan_id")
  actionPlan   ActionPlan   @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  label        String
  sortOrder    Int          @default(0) @map("sort_order")

  @@index([tenantId])
  @@map("action_plan_document")
}

model ActionPlanTask {
  id                   String              @id @default(uuid())
  tenantId             String              @map("tenant_id")
  tenant               Organization        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actionPlanId         String
  actionPlan           ActionPlan          @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  title                String
  notes                String?
  kind                 TaskKind            @default(TODO)
  anchor               DateAnchor          @default(CLOSE_DATE)
  offsetDays           Int                 @default(0) @map("offset_days")
  /// Dated off another entry in the same plan finishing, instead of a
  /// transaction date (anchor = DEPENDENCY).
  dependsOnId          String?             @map("depends_on_id")
  dependsOn            ActionPlanTask?     @relation("ActionPlanTaskDependency", fields: [dependsOnId], references: [id], onDelete: SetNull)
  dependents           ActionPlanTask[]    @relation("ActionPlanTaskDependency")
  /// Which side(s) of a transaction this entry applies to. Empty = every
  /// side — applying the plan never filters on an entry nobody scoped.
  sides                TransactionSide[]   @default([])
  assigneeRole         AssigneeRole?       @map("assignee_role")
  milestone            Boolean             @default(false)
  onCalendar           Boolean             @default(true) @map("on_calendar")
  visibleToAgent       Boolean             @default(true) @map("visible_to_agent")
  visibleToClient      Boolean             @default(true) @map("visible_to_client")
  /// Default email template: instantiated tasks open compose with it ready.
  emailTemplateId      String?             @map("email_template_id")
  /// Auto-send the template to the client when the task is completed.
  autoSendEmail        Boolean             @default(false) @map("auto_send_email")
  attachmentTemplateId String?             @map("attachment_template_id")
  attachmentTemplate   AttachmentTemplate? @relation(fields: [attachmentTemplateId], references: [id], onDelete: SetNull)
  dateTemplateId       String?             @map("date_template_id")
  dateTemplate         DateTemplate?       @relation(fields: [dateTemplateId], references: [id], onDelete: SetNull)
  docTemplateId        String?             @map("doc_template_id")
  docTemplate          DocTemplate?        @relation(fields: [docTemplateId], references: [id], onDelete: SetNull)
  priority             TaskPriority        @default(NORMAL)
  /// Days before the due date to remind the assignee; null disables the reminder.
  reminderDays         Int?                @map("reminder_days")
  sortOrder            Int                 @default(0) @map("sort_order")

  @@index([tenantId])
  @@index([tenantId, actionPlanId])
  @@map("action_plan_task")
}

/// Groups within one Templates-hub tab ("Marketing", "TC Version - Buyer
/// Side"). Scoped by `kind` to the tab it belongs to — a group never spans
/// tabs, matching the hub's own navigation.
model TemplateGroup {
  id                  String               @id @default(uuid())
  tenantId            String               @map("tenant_id")
  tenant              Organization         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind                TemplateGroupKind
  name                String
  sortOrder           Int                  @default(0) @map("sort_order")
  createdAt           DateTime             @default(now())
  actionPlans         ActionPlan[]
  emailTemplates      EmailTemplate[]
  docTemplates        DocTemplate[]
  attachmentTemplates AttachmentTemplate[]
  dateTemplates       DateTemplate[]

  @@index([tenantId, kind])
  @@map("template_group")
}

/// A named, reusable list of documents a transaction should carry — the
/// standalone version of what ActionPlanDocument seeds inline. Applying one
/// (directly, or via a task template entry) seeds TransactionRequiredDocument
/// rows the same way.
model AttachmentTemplate {
  id          String                   @id @default(uuid())
  tenantId    String                   @map("tenant_id")
  tenant      Organization             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groupId     String?                  @map("group_id")
  group       TemplateGroup?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  name        String
  description String?
  isSample    Boolean                  @default(false)
  items       AttachmentTemplateItem[]
  planTasks   ActionPlanTask[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([tenantId])
  @@index([tenantId, groupId])
  @@map("attachment_template")
}

model AttachmentTemplateItem {
  id                   String             @id @default(uuid())
  tenantId             String             @map("tenant_id")
  tenant               Organization       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attachmentTemplateId String             @map("attachment_template_id")
  attachmentTemplate   AttachmentTemplate @relation(fields: [attachmentTemplateId], references: [id], onDelete: Cascade)
  label                String
  /// Optional items still ride along on the checklist but never block or nag.
  required             Boolean            @default(true)
  /// Carries forward to the transaction's checklist slot when the template is
  /// applied — auto-reminders fire on a cadence until the slot is satisfied.
  remindEnabled        Boolean            @default(false) @map("remind_enabled")
  sortOrder            Int                @default(0) @map("sort_order")

  @@index([tenantId])
  @@map("attachment_template_item")
}

/// A named set of key dates ("Contract dates") with a suggested calculator
/// per date — applying one to a transaction proposes computed values the TC
/// confirms or overrides, rather than writing them directly.
model DateTemplate {
  id          String             @id @default(uuid())
  tenantId    String             @map("tenant_id")
  tenant      Organization       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groupId     String?            @map("group_id")
  group       TemplateGroup?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  name        String
  description String?
  isSample    Boolean            @default(false)
  items       DateTemplateItem[]
  planTasks   ActionPlanTask[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([tenantId])
  @@index([tenantId, groupId])
  @@map("date_template")
}

model DateTemplateItem {
  id             String       @id @default(uuid())
  tenantId       String       @map("tenant_id")
  tenant         Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dateTemplateId String       @map("date_template_id")
  dateTemplate   DateTemplate @relation(fields: [dateTemplateId], references: [id], onDelete: Cascade)
  /// Which Transaction date column this proposes a value for
  /// ("contractDate", "earnestMoneyDueDate", ...) — matched against the
  /// transaction's own field names, not a free label.
  dateKey        String       @map("date_key")
  label          String
  /// What the suggestion is computed from; null = entered manually with no
  /// suggestion.
  anchor         DateAnchor?
  offsetDays     Int?         @map("offset_days")
  /// Which calculator resolves the offset — see lib/date-calculators.ts.
  /// Null with a non-null anchor = plain calendar-day addition.
  calculator     String?
  sortOrder      Int          @default(0) @map("sort_order")

  @@index([tenantId])
  @@map("date_template_item")
}

/// A named set of documents a transaction must carry to pass compliance
/// (standard compliance checklist). Distinct from ActionPlan, which produces
/// dated *tasks*; this defines required *documents*. Assigned per Client, so
/// every file for that client inherits the same rules.
model ComplianceChecklist {
  id             String                  @id @default(uuid())
  tenantId       String                  @map("tenant_id")
  tenant         Organization            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  /// How many levels of reviewer sign-off each document needs (1 = a single
  /// reviewer approves; 2+ = it climbs the ladder).
  approvalLevels Int                     @default(1) @map("approval_levels")
  isSample       Boolean                 @default(false)
  items          ComplianceItem[]
  clients        Client[]
  instances      TransactionCompliance[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([tenantId])
  @@map("compliance_checklist")
}

/// Overall state of one compliance round on a transaction.
enum ComplianceStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
}

/// State of a single required document within a compliance round.
enum ComplianceSlotStatus {
  MISSING
  ATTACHED
  SUBMITTED
  APPROVED
  RETURNED
}

/// A checklist instantiated onto one transaction — a snapshot taken when it was
/// applied, so later edits to the template never rewrite a file already under
/// review. A transaction can carry several rounds; the newest is current, which
/// is how a file gets a fresh checklist version part-way through.
model TransactionCompliance {
  id             String               @id @default(uuid())
  tenantId       String               @map("tenant_id")
  tenant         Organization         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId  String               @map("transaction_id")
  transaction    Transaction          @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  /// Source template; null if the checklist was later deleted.
  checklistId    String?              @map("checklist_id")
  checklist      ComplianceChecklist? @relation(fields: [checklistId], references: [id], onDelete: SetNull)
  /// Snapshot of the checklist name at instantiation.
  checklistName  String               @map("checklist_name")
  /// Snapshot of the checklist's approval-levels setting at instantiation.
  approvalLevels Int                  @default(1) @map("approval_levels")
  version        Int                  @default(1)
  isCurrent      Boolean              @default(true) @map("is_current")
  status         ComplianceStatus     @default(DRAFT)
  submittedAt    DateTime?            @map("submitted_at")
  submittedById  String?              @map("submitted_by_id")
  reviewedAt     DateTime?            @map("reviewed_at")
  reviewedById   String?              @map("reviewed_by_id")
  slots          ComplianceSlot[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([tenantId])
  @@index([transactionId])
  @@map("transaction_compliance")
}

/// One required document within a compliance round: which file satisfies it and
/// where it stands in review.
model ComplianceSlot {
  id           String                @id @default(uuid())
  tenantId     String                @map("tenant_id")
  tenant       Organization          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  complianceId String                @map("compliance_id")
  compliance   TransactionCompliance @relation(fields: [complianceId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  required     Boolean               @default(true)
  sortOrder    Int                   @default(0) @map("sort_order")
  /// The document satisfying this slot; cleared if that document is deleted.
  documentId   String?               @map("document_id")
  document     Document?             @relation(fields: [documentId], references: [id], onDelete: SetNull)
  status       ComplianceSlotStatus  @default(MISSING)
  /// Highest review level that has signed off so far. APPROVED only once it
  /// reaches the round's approvalLevels; reset by a return or a file swap.
  approvedTier Int                   @default(0) @map("approved_tier")
  /// Why a reviewer sent it back.
  reviewNote   String?               @map("review_note")
  reviewedAt   DateTime?             @map("reviewed_at")
  reviewedById String?               @map("reviewed_by_id")
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([tenantId])
  @@index([complianceId])
  @@map("compliance_slot")
}

/// Lifecycle of one workspace covering files for another.
enum EngagementStatus {
  REQUESTED
  ACTIVE
  DECLINED
  ENDED
}

/// One workspace contracting another to cover files — vacation, overflow, a
/// specialty they don't handle. Found through the directory.
///
/// The vendor's chosen person joins the hiring workspace as a `guest` Member:
/// a real, revocable membership that sees only the transactions they are
/// assigned to. Nothing is copied between workspaces and no data is synced —
/// the file never leaves the workspace that owns it.
model Engagement {
  id             String           @id @default(uuid())
  /// The workspace that needs the coverage and owns the files.
  tenantId       String           @map("tenant_id")
  tenant         Organization     @relation("EngagementHirer", fields: [tenantId], references: [id], onDelete: Cascade)
  /// The workspace providing it.
  vendorTenantId String           @map("vendor_tenant_id")
  vendorTenant   Organization     @relation("EngagementVendor", fields: [vendorTenantId], references: [id], onDelete: Cascade)
  status         EngagementStatus @default(REQUESTED)
  /// What the hiring workspace is asking for.
  note           String?
  /// The vendor user given guest access, chosen when they accept.
  guestUserId    String?          @map("guest_user_id")
  guestUser      User?            @relation(fields: [guestUserId], references: [id], onDelete: SetNull)
  requestedById  String?          @map("requested_by_id")
  respondedAt    DateTime?        @map("responded_at")
  endedAt        DateTime?        @map("ended_at")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([tenantId])
  @@index([vendorTenantId])
  @@map("engagement")
}

/// Where a user's pay request stands. Freehold tracks what is owed and
/// produces the statement; the money itself moves however the business
/// already pays people.
enum PaymentRequestStatus {
  REQUESTED
  PAID
}

/// A user asking to be paid for work already assigned to them. The tenant
/// sets a fee per assignment; the user submits the ones that are due (company
/// policy decides whether that's at order time or at closing — Freehold
/// doesn't impose either). The itemized request is the statement.
model PaymentRequest {
  id          String               @id @default(uuid())
  tenantId    String               @map("tenant_id")
  tenant      Organization         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String               @map("user_id")
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      PaymentRequestStatus @default(REQUESTED)
  /// What the requester wants the payer to know.
  note        String?
  requestedAt DateTime             @default(now()) @map("requested_at")
  paidAt      DateTime?            @map("paid_at")
  paidById    String?              @map("paid_by_id")
  /// How it was settled — "check #1042", "ACH 7/22".
  paidNote    String?              @map("paid_note")
  items       PaymentRequestItem[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([tenantId])
  @@index([tenantId, userId])
  @@map("payment_request")
}

/// One transaction on a pay request. Address and fee are snapshotted so a
/// statement still reads correctly after the assignment is removed or its fee
/// changes. The unique assignee_id is what stops the same work being billed
/// twice — enforced by the database, not by a check that could be raced.
model PaymentRequestItem {
  id            String               @id @default(uuid())
  tenantId      String               @map("tenant_id")
  tenant        Organization         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestId     String               @map("request_id")
  request       PaymentRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  assigneeId    String?              @unique @map("assignee_id")
  assignee      TransactionAssignee? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  /// Snapshot, for linking back when the assignment still exists.
  transactionId String?              @map("transaction_id")
  address       String
  feeCents      Int                  @map("fee_cents")
  createdAt     DateTime             @default(now())

  @@index([tenantId])
  @@index([requestId])
  @@map("payment_request_item")
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

/// A trouble ticket filed from inside the dashboard — the sidebar widget on
/// every tenant page (not the portal sites) captures the page it was opened
/// from, so an operator knows what the person was looking at without asking.
model SupportTicket {
  id        String               @id @default(uuid())
  tenantId  String               @map("tenant_id")
  tenant    Organization         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String               @map("user_id")
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Auto-derived from the body (first ~60 chars) — the form is one textarea,
  /// on purpose, so filing a ticket is never more than "type and send".
  subject   String
  body      String
  /// Raw pathname the widget was opened from, e.g. /dashboard/transactions/abc123.
  pagePath  String?              @map("page_path")
  status    TicketStatus         @default(OPEN)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  replies   SupportTicketReply[]
  slackLink SlackTicketLink?

  @@index([tenantId, status])
  @@map("support_ticket")
}

/// One message in a ticket's thread — from the tenant who filed it, another
/// member of their workspace, or the operator. Operator replies aren't tied to
/// a User row in the tenant (an operator isn't necessarily a Member of every
/// workspace they support), so the author is recorded as plain text.
model SupportTicketReply {
  id           String        @id @default(uuid())
  tenantId     String        @map("tenant_id")
  tenant       Organization  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketId     String        @map("ticket_id")
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  body         String
  fromOperator Boolean       @default(false) @map("from_operator")
  authorEmail  String        @map("author_email")
  createdAt    DateTime      @default(now())

  @@index([tenantId, ticketId])
  @@map("support_ticket_reply")
}

/// Links a ticket to the Slack thread its alert was posted into, so a
/// threaded reply in Slack can find its way back to the right ticket without
/// any tenant context — the inbound Slack webhook has none, only a channel +
/// thread timestamp. No RLS: a bare lookup by (slackChannel, slackThreadTs)
/// resolves the tenant, then every downstream read/write goes through
/// withTenant, the same "resolve the capability first" discipline
/// vendor_order_link and portal_link already use. Optional — a ticket only
/// gets one when SLACK_BOT_TOKEN + SLACK_ADMIN_CHANNEL are configured.
model SlackTicketLink {
  id            String        @id @default(uuid())
  tenantId      String        @map("tenant_id")
  ticketId      String        @unique @map("ticket_id")
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  slackChannel  String        @map("slack_channel")
  slackThreadTs String        @map("slack_thread_ts")
  createdAt     DateTime      @default(now())

  @@unique([slackChannel, slackThreadTs])
  @@map("slack_ticket_link")
}

/// Which of the three closing-process shapes a state's transactions follow —
/// coarse enough to be useful for defaults/copy, with the real nuance kept in
/// StateReference.closingModelDetail.
enum StateClosingModel {
  TITLE_ESCROW
  ATTORNEY
  PARTIAL_ATTORNEY
}

/// Platform-wide reference notes for one US state — closing process, dominant
/// MLS systems, TC licensing norms, and local jargon/forms. Cross-tenant by
/// design (every workspace operating in Texas benefits from the same Texas
/// notes), so no tenantId and no RLS — the same root-table shape as Vendor
/// and PlatformSetting. Editable only from /admin/states; read by every
/// tenant wherever a transaction or Operating-states entry names this state.
///
/// Deliberately informational, not enforcement: TenantState.licenseRequired
/// (self-declared per workspace) remains the only thing that actually gates
/// a file — see lib/licensing.ts. This is a hint shown alongside that
/// checkbox, not a value that sets it.
model StateReference {
  /// Two-letter USPS code, uppercase — "TX", "CA".
  code               String            @id
  name               String
  closingModel       StateClosingModel @map("closing_model")
  /// The specific shape within that model, e.g. "Strict Attorney State —
  /// attorney conducts closing, handles escrow, and performs title search."
  closingModelDetail String            @map("closing_model_detail")
  /// Named regional MLS systems operating in this state.
  dominantMls        String            @map("dominant_mls")
  /// Plain-language note on when an unlicensed TC vs. a licensed one is
  /// needed here. Not legal advice — a starting point for the workspace's
  /// own Operating-states decision.
  licenseSummary     String            @map("license_summary")
  /// State-specific forms, disclosures, and terms of art a TC working this
  /// state will run into.
  jargon             String
  /// Paul's confirmed-accurate flag — data arrives as a best-effort baseline
  /// and gets marked verified as each state is checked.
  verified           Boolean           @default(false)
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@map("state_reference")
}

/// A state the workspace operates in, and whether it requires a licensed
/// coordinator on every file. Freehold ships no built-in list of which states
/// require licensing — that's a legal judgment each business makes for itself.
/// Also the coverage list a tenant advertises in the vendor directory.
model TenantState {
  id              String       @id @default(uuid())
  tenantId        String       @map("tenant_id")
  tenant          Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Two-letter state code, uppercased.
  state           String
  licenseRequired Boolean      @default(false) @map("license_required")
  createdAt       DateTime     @default(now())

  @@unique([tenantId, state])
  @@index([tenantId])
  @@map("tenant_state")
}

/// A workspace user working a transaction. Any number per file, each with a
/// free-text role ("Lead TC", "Support") and — later — the fee the tenant
/// pays them for it. Replaced the old fixed tc1/tc2 slots.
model TransactionAssignee {
  id            String              @id @default(uuid())
  tenantId      String              @map("tenant_id")
  tenant        Organization        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId String              @map("transaction_id")
  transaction   Transaction         @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  userId        String              @map("user_id")
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleLabel     String?             @map("role_label")
  /// The formal seat this person fills on the file, if any — what a task
  /// template's AssigneeRole resolves against. Most assignees (support staff
  /// cc'd on a file, outside coverage) hold no slot at all; only the one or
  /// two people doing the actual coordinating are TC1/TC2.
  slot          AssigneeSlot?
  /// What the tenant pays this user for this file, in cents. Admin-set; the
  /// user submits it through a PaymentRequest when it's due. Exactly one of
  /// feeCents / feePercentBp is set (the action clears the other).
  feeCents      Int?                @map("fee_cents")
  /// Percentage payout in basis points (7000 = 70%) of the file's fee
  /// revenue: "earned" reads against billed, "payable" against collected,
  /// and a pay request freezes the collected figure of the day. Basis
  /// points, not a float — money math stays integral.
  feePercentBp  Int?                @map("fee_percent_bp")
  /// Set once this assignment has been put on a pay request.
  paymentItem   PaymentRequestItem?
  createdAt     DateTime            @default(now())

  @@unique([transactionId, userId])
  /// At most one person per seat per file. Postgres treats multiple NULLs as
  /// distinct, so this only constrains the rows that actually claim a slot.
  @@unique([transactionId, slot])
  @@index([tenantId])
  @@index([tenantId, userId])
  @@map("transaction_assignee")
}

/// A professional license a workspace user holds — some states require
/// licensed transaction coordinators. One row per state (a user licensed in
/// several states has several rows), stored per tenant: each workspace keeps
/// its own records for its own people. Always "license" in code and UI —
/// "credential" is the Vault's word for stored passwords.
model UserLicense {
  id              String       @id @default(uuid())
  tenantId        String       @map("tenant_id")
  tenant          Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId          String       @map("user_id")
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Two-letter state code, uppercased.
  state           String
  licenseNumber   String?      @map("license_number")
  /// What kind of license — "Salesperson", "Broker", "TC certification".
  label           String?
  /// Blank = no expiry on record. An expired license never satisfies a
  /// licensed-state check.
  expiresAt       DateTime?    @map("expires_at") @db.Date
  /// Uploaded copy of the license, via the storage abstraction (same fields
  /// as Document: inline bytes for DB, key for S3/tenant buckets).
  filename        String?
  contentType     String?      @map("content_type")
  sizeBytes       Int?         @map("size_bytes")
  data            Bytes?
  storageKey      String?      @map("storage_key")
  storageProvider String?      @map("storage_provider")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([tenantId])
  @@index([tenantId, userId])
  @@map("user_license")
}

/// One required document on a compliance checklist.
model ComplianceItem {
  id          String              @id @default(uuid())
  tenantId    String              @map("tenant_id")
  tenant      Organization        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  checklistId String              @map("checklist_id")
  checklist   ComplianceChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// Optional items are tracked but never block a file from passing.
  required    Boolean             @default(true)
  sortOrder   Int                 @default(0) @map("sort_order")
  createdAt   DateTime            @default(now())

  @@index([tenantId])
  @@index([checklistId])
  @@map("compliance_item")
}

// --- Stage 02: documents + AI contract extraction ---

enum ExtractionStatus {
  RUNNING
  READY
  APPLIED
  FAILED
}

enum FieldConfidence {
  HIGH
  MEDIUM
  LOW
}

enum FieldTarget {
  TRANSACTION_FIELD
  TASK
  CUSTOM_FIELD
  PARTY
}

enum FieldValueType {
  TEXT
  DATE
  MONEY
}

/// Uploaded or generated file attached to a transaction. Bytes live either in
/// object storage (`storageKey`, when STORAGE_ENDPOINT is configured) or
/// inline in Postgres (`data`, the zero-config default). Exactly one of the
/// two is set. Capped at upload time (10 MB).
model Document {
  id              String                        @id @default(uuid())
  tenantId        String                        @map("tenant_id")
  tenant          Organization                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId   String
  transaction     Transaction                   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  filename        String
  contentType     String                        @map("content_type")
  sizeBytes       Int                           @map("size_bytes")
  data            Bytes?
  storageKey      String?                       @map("storage_key")
  /// Which driver holds the bytes: DB | S3 (platform) | TENANT_S3. Null on rows
  /// predating per-tenant storage — reads infer from data/storageKey then.
  storageProvider String?                       @map("storage_provider")
  visibleToAgent  Boolean                       @default(true) @map("visible_to_agent")
  visibleToClient Boolean                       @default(true) @map("visible_to_client")
  /// Versioning: replacing a file keeps the old one as a prior version. The new
  /// row is current (isCurrent), version+1, and replacesId points at the file it
  /// superseded. Lists show only current rows; the chain is the version history.
  version         Int                           @default(1)
  isCurrent       Boolean                       @default(true) @map("is_current")
  replacesId      String?                       @map("replaces_id")
  /// Set when the file came from a vendor — an inbound email attachment on an
  /// order (Stage 4) or a vendor upload (Stage 5). Kept internal by default
  /// (visibleToClient false); only the TC can promote it to the client.
  sourceOrderId   String?                       @map("source_order_id")
  sourceOrder     VendorOrder?                  @relation("OrderDocuments", fields: [sourceOrderId], references: [id], onDelete: SetNull)
  extractions     ContractExtraction[]
  envelopes       SignatureEnvelope[]
  complianceSlots ComplianceSlot[]
  requiredSlots   TransactionRequiredDocument[]
  emailedActivity TransactionActivity[]
  createdAt       DateTime                      @default(now())

  @@index([tenantId])
  @@index([transactionId])
  @@index([replacesId])
  @@index([sourceOrderId])
  @@map("document")
}

/// A slot on a transaction's required-documents checklist: an expected document
/// (seeded from an applied plan, or added by hand) that is satisfied when a
/// Document is linked to it. documentId null = still missing. Deleting the
/// linked document just reopens the slot (SetNull), never the checklist item.
model TransactionRequiredDocument {
  id            String       @id @default(uuid())
  tenantId      String       @map("tenant_id")
  tenant        Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId String       @map("transaction_id")
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  label         String
  documentId    String?      @map("document_id")
  document      Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  sortOrder     Int          @default(0) @map("sort_order")
  createdAt     DateTime     @default(now())

  @@index([tenantId])
  @@index([transactionId])
  @@map("transaction_required_document")
}

/// One AI extraction run over a document. Nothing an extraction finds touches
/// the transaction until a human applies it field-by-field.
model ContractExtraction {
  id            String            @id @default(uuid())
  tenantId      String            @map("tenant_id")
  tenant        Organization      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentId    String
  document      Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction       @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  status        ExtractionStatus  @default(RUNNING)
  model         String
  error         String?
  /// The signature check: whether the PDF is executed, and who still owes a
  /// signature. Not an ExtractionField because it isn't a value applied to
  /// the transaction — it qualifies every field that is. Null on extractions
  /// that ran before the check existed, which the UI reads as "unverified"
  /// rather than "signed".
  execution     Json?
  fields        ExtractionField[]
  createdAt     DateTime          @default(now())

  @@index([tenantId])
  @@index([transactionId])
  @@map("contract_extraction")
}

// --- Stage 03: document templates + e-signature envelopes ---

enum EsignProvider {
  MANUAL
  DOCUMENSO
  DOCUSIGN
}

enum EnvelopeStatus {
  DRAFT
  SENT
  COMPLETED
  DECLINED
  ERROR
}

/// Reusable merge-field document template. Body is plain text with
/// {{merge.fields}}; rendering produces a PDF attached to a transaction.
/// Reusable outbound email templates with merge fields, selectable from
/// any transaction's compose (and from task rows). Distinct from the two
/// automated lifecycle templates on the organization row.
model EmailTemplate {
  id               String         @id @default(uuid())
  tenantId         String         @map("tenant_id")
  tenant           Organization   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groupId          String?        @map("group_id")
  group            TemplateGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  name             String
  subject          String
  body             String
  /// STATUS | INTRO | PORTAL | MILESTONE | LISTING | POST_CLOSE | OTHER
  category         String         @default("OTHER")
  /// Prefilled To/Cc when composing from this template — merge codes allowed
  /// (e.g. "{{buyer_emails}}"). Null = the compose screen starts blank.
  toDefault        String?        @map("to_default")
  ccDefault        String?        @map("cc_default")
  /// Comma-separated keywords matched against task titles to suggest this
  /// template when emailing from a task (e.g. "inspection" or "earnest,emd").
  taskMatch        String?        @map("task_match")
  /// Comma-separated keywords: transaction documents whose filename matches
  /// get pre-checked as attachments when this template is selected.
  attachMatch      String?        @map("attach_match")
  /// Shown to the sender at compose time, never in the email itself — "check
  /// the fees before sending", "attach the executed contract".
  composeNote      String?        @map("compose_note")
  /// Named attachment slots this template expects, comma-separated (e.g.
  /// "Executed Contract, Third-Party Financing Addendum") — shown as chips
  /// on the compose screen so the sender remembers what to attach even
  /// before `attachMatch` finds a matching document.
  filePlaceholders String?        @map("file_placeholders")
  /// Times this template has been used to send an email.
  usageCount       Int            @default(0) @map("usage_count")
  isSample         Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([tenantId])
  @@index([tenantId, groupId])
  @@map("email_template")
}

/// A named "Your transaction coordinator" contact card — the structured
/// signature block that fills the tc/agent/other-side cards every branded
/// email carries (see lib/email-template.ts → contactCell). A workspace
/// keeps a small library rather than one fixed signature: a brokerage with
/// a shared support line wants a different card than an individual
/// coordinator's own name and cell number, and a TC composing on someone
/// else's behalf needs to pick the right one rather than always getting
/// their own.
model EmailSignature {
  id          String       @id @default(uuid())
  tenantId    String       @map("tenant_id")
  tenant      Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Label shown only in the picker — "Formal", "Jordan's cell" — never in
  /// the email itself.
  name        String
  displayName String       @map("display_name")
  /// Role/company line under the name, e.g. "Transaction Coordinator, Acme TC".
  title       String?
  company     String?
  email       String?
  phone       String?
  /// Used whenever nothing more specific was picked: composing without
  /// choosing one, and every automated system email (intro, post-close,
  /// review request), which has no sender to ask.
  isDefault   Boolean      @default(false) @map("is_default")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([tenantId])
  @@map("email_signature")
}

/// Operator analytics: every Checkout session we start, completed or not.
/// Platform-level table (no RLS) — read only from the /admin panel.
model CheckoutAttempt {
  id          String    @id // Stripe checkout session id
  tenantId    String    @map("tenant_id")
  email       String
  tier        String
  createdAt   DateTime  @default(now())
  completedAt DateTime? @map("completed_at")
  expiredAt   DateTime? @map("expired_at")
  recoveryUrl String?   @map("recovery_url")

  @@index([createdAt])
  @@map("checkout_attempt")
}

/// Redeemable complimentary-plan code. Platform-level (no RLS): operators mint
/// codes in /admin, tenants redeem them on the billing page for a full plan with
/// no Stripe checkout or charge. Redemption sets org.compTier + compExpiresAt.
model CompCode {
  id             String    @id @default(uuid())
  code           String    @unique
  /// The plan this code grants (PRO or BUSINESS).
  tier           PlanTier
  /// How long the comp lasts once redeemed, in months; null = no expiry.
  durationMonths Int?      @map("duration_months")
  /// Redemption deadline for the code itself; null = never expires.
  expiresAt      DateTime? @map("expires_at")
  maxRedemptions Int       @default(1) @map("max_redemptions")
  timesRedeemed  Int       @default(0) @map("times_redeemed")
  note           String?
  createdAt      DateTime  @default(now())

  @@map("comp_code")
}

// --- AI credits: prepaid pro-AI unlocks for the Free tier ---

/// Reason a workspace's AI-credit balance changed. Audit only — the balance of
/// record lives on organization.aiCredits.
enum CreditLedgerReason {
  PURCHASE
  COUPON
  SPEND
  REFUND
  ADMIN
}

/// Append-only audit of AI-credit movements. Platform table (no RLS): operators
/// review it in /admin, tenants see their own via explicit tenantId filters;
/// rows are written only by server actions that stamp the authenticated tenant.
model CreditLedger {
  id            String             @id @default(uuid())
  tenantId      String             @map("tenant_id")
  /// Positive = granted/purchased, negative = spent.
  delta         Int
  reason        CreditLedgerReason
  /// Balance immediately after this movement, for reconciliation.
  balanceAfter  Int                @map("balance_after")
  /// The transaction a SPEND unlocked, when applicable.
  transactionId String?            @map("transaction_id")
  note          String?
  createdAt     DateTime           @default(now())

  @@index([tenantId, createdAt])
  @@map("credit_ledger")
}

/// Per-call AI token usage, so operators can see how much each plan/tenant
/// consumes and move heavy tenants to cheaper models. Platform table (no RLS):
/// admin aggregates cross-tenant; rows written by server-side AI calls that
/// stamp the tenant. Best-effort — a logging failure never blocks the AI call.
model AiUsageEvent {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  /// "extract" | "classify" | "dictation" | ...
  feature       String
  model         String
  inputTokens   Int      @default(0) @map("input_tokens")
  outputTokens  Int      @default(0) @map("output_tokens")
  transactionId String?  @map("transaction_id")
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([createdAt])
  @@map("ai_usage_event")
}

/// Redeemable code granting free AI credits. Platform table (no RLS), same
/// shape as CompCode: operators mint in /admin, tenants redeem on billing.
model CreditCoupon {
  id             String                   @id @default(uuid())
  code           String                   @unique
  /// Credits granted per redemption.
  credits        Int
  expiresAt      DateTime?                @map("expires_at")
  maxRedemptions Int                      @default(1) @map("max_redemptions")
  timesRedeemed  Int                      @default(0) @map("times_redeemed")
  note           String?
  createdAt      DateTime                 @default(now())
  redemptions    CreditCouponRedemption[]

  @@map("credit_coupon")
}

/// One row per (coupon, tenant) so a workspace can't redeem the same code
/// twice. Platform table (no RLS); written by the tenant redeem action.
model CreditCouponRedemption {
  id        String       @id @default(uuid())
  couponId  String       @map("coupon_id")
  coupon    CreditCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  tenantId  String       @map("tenant_id")
  createdAt DateTime     @default(now())

  @@unique([couponId, tenantId])
  @@map("credit_coupon_redemption")
}

/// Scheduled/queued outgoing email. NO RLS on purpose: the hourly cron
/// flushes due rows across tenants (CRON_SECRET-guarded route); rows are
/// created only by tenant-scoped actions that stamp tenantId themselves.
model EmailOutbox {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  transactionId   String?   @map("transaction_id")
  toAddr          String    @map("to_addr")
  subject         String
  body            String
  sendAt          DateTime  @map("send_at")
  sentAt          DateTime? @map("sent_at")
  canceledAt      DateTime? @map("canceled_at")
  attempts        Int       @default(0)
  lastError       String?   @map("last_error")
  createdAt       DateTime  @default(now())
  /// Who it goes out as, when that's a coordinator's own mailbox.
  sendAsUserId    String?   @map("send_as_user_id")
  /// Set when Nylas holds the schedule itself rather than our cron. Those
  /// rows exist only so the coordinator can see and cancel the send — the
  /// flush deliberately skips them, or the mail would go out twice.
  /// The grant is pinned alongside the id because cancelling addresses the
  /// grant that scheduled it, and a reconnect can replace a user's grant.
  nylasScheduleId String?   @map("nylas_schedule_id")
  nylasGrantId    String?   @map("nylas_grant_id")
  /// Set when Resend holds the schedule itself — the shared-address
  /// equivalent of nylasScheduleId above, and skipped by the flush for the
  /// same reason. No grant to pin alongside it: cancelling only needs the
  /// message id and the workspace's own API key.
  resendEmailId   String?   @map("resend_email_id")

  @@index([sendAt, sentAt])
  @@map("email_outbox")
}

model DocTemplate {
  id          String           @id @default(uuid())
  tenantId    String           @map("tenant_id")
  tenant      Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groupId     String?          @map("group_id")
  group       TemplateGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  name        String
  description String?
  body        String
  isSample    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  planTasks   ActionPlanTask[]

  @@index([tenantId])
  @@index([tenantId, groupId])
  @@map("doc_template")
}

/// One signature request for a document, through whichever provider the
/// client (or tenant default) uses. Provider adapters live in
/// packages/integrations; MANUAL tracks signatures collected outside any
/// e-sign service (wet ink, provider portals we don't yet integrate).
model SignatureEnvelope {
  id            String         @id @default(uuid())
  tenantId      String         @map("tenant_id")
  tenant        Organization   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentId    String
  document      Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  provider      EsignProvider
  externalId    String?        @map("external_id")
  status        EnvelopeStatus @default(DRAFT)
  signers       Json
  error         String?
  sentAt        DateTime?      @map("sent_at")
  completedAt   DateTime?      @map("completed_at")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tenantId])
  @@index([transactionId])
  @@map("signature_envelope")
}

/// A single extracted value with its provenance: page number, verbatim quote,
/// and the model's confidence. `target` says where applying it lands —
/// a transaction column, a dated task, or a custom field.
model ExtractionField {
  id           String             @id @default(uuid())
  tenantId     String             @map("tenant_id")
  tenant       Organization       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  extractionId String
  extraction   ContractExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  key          String
  label        String
  value        String
  valueType    FieldValueType     @default(TEXT) @map("value_type")
  page         Int?
  quote        String?
  confidence   FieldConfidence    @default(MEDIUM)
  target       FieldTarget        @default(CUSTOM_FIELD)
  applied      Boolean            @default(false)
  sortOrder    Int                @default(0) @map("sort_order")

  @@index([tenantId])
  @@index([extractionId])
  @@map("extraction_field")
}

// --- The Handbook: what a team knows, written down ---

/**
 * What a Handbook note is attached to.
 * MEMBER is the one that isn't like the others: a note about a teammate
 * ("needs to improve phone communication") is a management record, readable
 * and writable only by owners and admins, and it never reaches a summary
 * written for the person it describes. lib/handbook.ts enforces that; this
 * enum only records the shape.
 */
enum HandbookSubject {
  CLIENT
  CONTACT
  MEMBER
  TRANSACTION
}

/**
 * The working-relationship grade on a client or contact.
 * The familiar A–F school scale, which omits E. Its whole purpose is to
 * outlive the memory of whoever set it — a client graded F two years ago,
 * with a note saying why, stops a new coordinator accepting work that the
 * business already decided it didn't want.
 */
enum HandbookGrade {
  A
  B
  C
  D
  F
}

/**
 * One thing worth knowing, written by a coordinator.
 * The examples that shaped this: "wants a phone call if there are contract
 * date issues"; "installs signs in Plymouth County only"; "broker's office
 * reviews the document before final payment"; "on holiday April 2027". They
 * are not structured data and shouldn't be — the value is that a person can
 * type the thing they'd otherwise have to remember to say out loud.
 * Deliberately many-per-subject and freely deletable, so the record can be
 * corrected as easily as it was made.
 */
model HandbookNote {
  id            String          @id @default(uuid())
  tenantId      String          @map("tenant_id")
  tenant        Organization    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subjectType   HandbookSubject @map("subject_type")
  /// The Client / Contact / Member / Transaction id. Not a foreign key: one
  /// column serves four different tables, and a note surviving a moment
  /// longer than a deleted subject is harmless — nothing reads an orphan,
  /// and every read is already scoped to rows the caller can see.
  subjectId     String          @map("subject_id")
  body          String
  /// Who wrote it, for the "— Priya, March" byline. Null once that person's
  /// membership is gone; the note itself is the workspace's, not theirs.
  authorId      String?         @map("author_id")
  authorName    String?         @map("author_name")
  /// Optional expiry for a fact with a shelf life ("on holiday April 2027").
  /// Past this, the note drops out of summaries and pooled recaps but stays
  /// in the list marked expired, so it can be read and deleted deliberately
  /// rather than vanishing.
  relevantUntil DateTime?       @map("relevant_until") @db.Date
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([tenantId, subjectType, subjectId])
  @@map("handbook_note")
}
