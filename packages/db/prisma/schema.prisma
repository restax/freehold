// Freehold schema — Stage 00.
//
// Auth tables (user, session, account, verification, organization, member,
// invitation) follow Better Auth's expected shape (organization plugin enabled).
// Domain convention: an Organization IS a Freehold tenant — the paying customer
// (broker, title company, or solo TC business). Domain tables carry tenant_id
// and are protected by Postgres row-level security (see the init migration and
// `withTenant` in src/tenant.ts).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Better Auth core ---

model User {
  id               String        @id
  name             String
  email            String        @unique
  emailVerified    Boolean       @default(false)
  image            String?
  /// Profile photo bytes, stored inline (photos are small and user-global, so
  /// they never route to a tenant's bucket). Served by /api/users/[id]/avatar;
  /// `image` holds that path so anything reading the auth user renders it.
  avatarData       Bytes?        @map("avatar_data")
  avatarType       String?       @map("avatar_type")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  twoFactorEnabled Boolean?      @map("two_factor_enabled")
  twoFactors       TwoFactor[]
  sessions         Session[]
  accounts         Account[]
  members          Member[]
  invitations      Invitation[]
  ownedContacts    Contact[]     @relation("ContactOwner")
  assignedTasks    Task[]        @relation("TaskAssignee")
  licenses         UserLicense[]
  transactionAssignments TransactionAssignee[]
  paymentRequests  PaymentRequest[]
  guestEngagements Engagement[]
  supportTickets   SupportTicket[]

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

/// better-auth twoFactor plugin storage (TOTP secret + hashed backup codes).
model TwoFactor {
  id                      String    @id
  userId                  String    @map("user_id")
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret                  String
  backupCodes             String    @map("backup_codes")
  verified                Boolean   @default(false)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until")

  @@index([userId])
  @@map("two_factor")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// --- Better Auth organization plugin (Organization = Freehold tenant) ---

/// Cloud plan tier. Self-hosted installs stay on FREE semantics-wise but are
/// never limited — limits are enforced only when FREEHOLD_CLOUD=1.
enum PlanTier {
  FREE
  PRO
  BUSINESS
}

model Organization {
  id                      String                  @id
  name                    String
  slug                    String                  @unique
  logo                    String?
  metadata                String?
  planTier                PlanTier                @default(FREE) @map("plan_tier")
  seatLimit               Int                     @default(2) @map("seat_limit")
  aiExtractionsUsed       Int                     @default(0) @map("ai_extractions_used")
  /// Voice-search sessions started this billing month. Unlike the lifetime
  /// extraction credits, voice recurs, so the window rolls: once
  /// voiceQuotaResetAt is in the past the counter starts over.
  voiceSessionsUsed       Int                     @default(0) @map("voice_sessions_used")
  voiceQuotaResetAt       DateTime?               @map("voice_quota_reset_at")
  /// Admin setting: when true, members only see contacts they own.
  restrictContactsToOwner Boolean                 @default(false) @map("restrict_contacts_to_owner")
  /// Per-tenant Follow Up Boss connection: {enc:{...}, importedAt?, importedCount?}.
  /// API key encrypted with VAULT_MASTER_KEY.
  fubConfig               Json?                   @map("fub_config")
  /// Per-tenant Twenty CRM connection: {url, enc:{...}, importedAt?, importedCount?}.
  twentyConfig            Json?                   @map("twenty_config")
  /// Tenant wording for transaction sides: {buy, sell} — e.g. sell side vs list side.
  sideLabels              Json?                   @map("side_labels")
  /// Tenant overrides for automated email templates: {intro:{subject,body}, postClose:{subject,body}}.
  emailTemplates          Json?                   @map("email_templates")
  /// Workspace email signature + global footer: {signature, footer} —
  /// appended to every outgoing branded email.
  emailSettings           Json?                   @map("email_settings")
  /// Tenant mini-site at <slug>.<root>: {published, tagline, about, phone, email, services, showRegistration}.
  siteConfig              Json?                   @map("site_config")
  /// Per-tenant Documenso connection: {url, enc:{ciphertext,iv,tag,wrappedKey,wrapIv,wrapTag,keyVersion}}.
  /// Token encrypted with VAULT_MASTER_KEY; null = use server-wide env default.
  documensoConfig         Json?                   @map("documenso_config")
  /// Per-tenant document storage: {provider:"S3", endpoint, region, bucket,
  /// accessKeyEnc:{...}, secretKeyEnc:{...}}. Keys encrypted with VAULT_MASTER_KEY.
  /// New documents route here; null = platform default (env S3) or Postgres bytes.
  storageConfig           Json?                   @map("storage_config")
  stripeCustomerId        String?                 @map("stripe_customer_id")
  stripeSubscriptionId    String?                 @map("stripe_subscription_id")
  /// Last-known Stripe subscription status (active, trialing, past_due, unpaid, canceled).
  /// Mirrored from webhooks for operator visibility; null = never had a paid sub.
  subscriptionStatus      String?                 @map("subscription_status")
  /// Set when the workspace is locked for a failed renewal. Data is preserved;
  /// the dashboard is gated until payment is updated. Cleared when Stripe reports paid again.
  billingSuspendedAt      DateTime?               @map("billing_suspended_at")
  /// Complimentary (comped) plan grant, independent of Stripe. When set (and not
  /// past compExpiresAt), it overrides planTier — a full plan with no checkout/charge.
  compTier                PlanTier?               @map("comp_tier")
  /// When the comp ends; null = no expiry (until an operator revokes it).
  compExpiresAt           DateTime?               @map("comp_expires_at")
  createdAt               DateTime                @default(now())
  members                 Member[]
  invitations             Invitation[]
  clients                 Client[]
  contacts                Contact[]
  transactions            Transaction[]
  parties                 TransactionParty[]
  tasks                   Task[]
  actionPlans             ActionPlan[]
  actionPlanTasks         ActionPlanTask[]
  complianceChecklists    ComplianceChecklist[]
  complianceItems         ComplianceItem[]
  transactionCompliances  TransactionCompliance[]
  complianceSlots         ComplianceSlot[]
  userLicenses            UserLicense[]
  transactionAssignees    TransactionAssignee[]
  states                  TenantState[]
  paymentRequests         PaymentRequest[]
  paymentRequestItems     PaymentRequestItem[]
  engagementsHired        Engagement[]            @relation("EngagementHirer")
  engagementsProvided     Engagement[]            @relation("EngagementVendor")
  supportTickets          SupportTicket[]
  supportTicketReplies    SupportTicketReply[]
  /// What happens when a file sits in a license-required state with nobody
  /// licensed assigned: "warn" (save it, flag it everywhere) or "block"
  /// (refuse the write). Deliberately a tenant choice — TCs routinely open a
  /// file before deciding who runs it.
  licenseEnforcement      String                  @default("warn") @map("license_enforcement")
  /// Opt-in vendor-directory listing, published to other workspaces and to the
  /// public syndication feed: {listed, blurb, contactEmail, specializations[],
  /// software[], availability, pricingModel, yearsExperience, remote}. States
  /// covered come from TenantState. Null or listed:false = not listed anywhere.
  directoryConfig         Json?                   @map("directory_config")
  /// Per-tenant ERPNext connection: {url, itemCode, keyEnc:{...},
  /// secretEnc:{...}}. API key + secret encrypted with VAULT_MASTER_KEY.
  /// Null = client invoices are kept in Freehold only.
  erpnextConfig           Json?                   @map("erpnext_config")
  documents               Document[]
  extractions             ContractExtraction[]
  extractionFields        ExtractionField[]
  templates               DocTemplate[]
  envelopes               SignatureEnvelope[]
  portalLinks             PortalLink[]
  vaultCredentials        VaultCredential[]
  vaultAccessLogs         VaultAccessLog[]
  auditLogs               AuditLog[]
  contactNotes            ContactNote[]
  clientNotes             ClientNote[]
  clientAgents            ClientAgent[]
  emailTemplatesLib       EmailTemplate[]
  intakeSubmissions       IntakeSubmission[]
  emails                  Email[]
  apiKeys                 ApiKey[]
  invoices                Invoice[]
  webhookEndpoints        WebhookEndpoint[]

  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  /// Compliance review authority, assigned from the Team page. null = default
  /// by role (owner/admin hold top authority, member submits only); 0 =
  /// submitter only even for an admin; 1..N = approves at levels up to N.
  complianceTier Int?         @map("compliance_tier")
  /// Capability token for this person's subscribe-once personal calendar feed
  /// in this workspace (a user in two tenants gets a separate feed per one,
  /// same as everything else here — roles and assignments don't cross tenants).
  /// Generated lazily on first request for the link; null until then.
  calendarToken  String?      @unique @map("calendar_token")
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invitation")
}

// --- Freehold domain (row-level security enforced; see init migration) ---

enum ClientType {
  AGENT
  BROKERAGE
  TITLE
  LENDER
  OTHER
}

/// The tenant's customer — the agent, brokerage, title company, or lender they
/// serve. Transactions, vault credentials, portal branding, and invoicing all
/// attach here in later stages.
model Client {
  id                    String               @id @default(uuid())
  tenantId              String               @map("tenant_id")
  tenant                Organization         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type                  ClientType           @default(AGENT)
  name                  String
  email                 String?
  phone                 String?
  notes                 String?
  /// Per-client e-signature provider; null = tenant default (FREEHOLD_ESIGN_DEFAULT env, else MANUAL).
  esignProvider         EsignProvider?       @map("esign_provider")
  /// Per-client automated-email switches: {intro?: boolean, postClose?: boolean}; missing = on.
  emailPrefs            Json?                @map("email_prefs")
  /// This agent's own SkySlope API credentials, so their transactions can be
  /// read on their behalf: {accessKeyEnc:{...}, secretEnc:{...}, label?,
  /// connectedAt, verifiedAt?}. Envelope-encrypted with VAULT_MASTER_KEY.
  /// One per client because SkySlope issues AccessKey/Secret per user, not
  /// per brokerage. Null = not connected.
  skyslopeConfig        Json?                @map("skyslope_config")
  /// Compliance: every transaction for this client follows the assigned
  /// checklist. Switch complianceEnabled off to exempt the client entirely
  /// (leaving no checklist assigned is also inert).
  complianceEnabled     Boolean              @default(true) @map("compliance_enabled")
  complianceChecklistId String?              @map("compliance_checklist_id")
  complianceChecklist   ComplianceChecklist? @relation(fields: [complianceChecklistId], references: [id], onDelete: SetNull)
  isSample              Boolean              @default(false)
  transactions          Transaction[]
  credentials           VaultCredential[]
  portalLinks           PortalLink[]
  clientNotes           ClientNote[]
  agents                ClientAgent[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  invoices              Invoice[]

  @@index([tenantId])
  @@map("client")
}

enum TransactionStatus {
  LISTING
  UNDER_CONTRACT
  PENDING
  CLOSED
  CANCELLED
}

enum TransactionSide {
  BUY_SIDE
  SELL_SIDE
  DUAL
}

enum PartyRole {
  BUYER
  SELLER
  BUYER_AGENT
  LISTING_AGENT
  LENDER
  TITLE_COMPANY
  INSPECTOR
  APPRAISER
  ATTORNEY
  OTHER
}

enum TaskStatus {
  OPEN
  DONE
  SKIPPED
}

enum DateAnchor {
  CONTRACT_DATE
  CLOSE_DATE
}

enum TaskPriority {
  NORMAL
  HIGH
  CRITICAL
}

/// CRM record — buyers, sellers, agents, lenders, vendors. Category is free
/// text on purpose (competitors allow custom categories).
/// Dual-person CRM record: one entry holds two related people (a couple, a
/// client + assistant) so mailings and document merges address both at once.
/// `name` stays the denormalized display name ("Jordan & Casey Bell") used by
/// pickers and party lists; structured person fields live alongside it, and
/// the secondary person + overflow phones/emails live in JSON.
/// A buyer or seller intake form submitted through a client portal.
/// Uploaded files become Document rows on the transaction; `data` holds the
/// answered fields keyed by field id.
model IntakeSubmission {
  id            String       @id @default(uuid())
  tenantId      String       @map("tenant_id")
  tenant        Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId String       @map("transaction_id")
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  portalLinkId  String?      @map("portal_link_id")
  /// BUY_SIDE | SELL_SIDE
  side          String
  data          Json
  documentIds   String[]     @default([]) @map("document_ids")
  createdAt     DateTime     @default(now())

  @@index([tenantId, transactionId])
  @@map("intake_submission")
}

/// Which agents (contacts) work under a managed client (team/brokerage).
/// Portal access is granted per agent from the client page; agents without
/// a portal simply have no portal_link row.
model ClientAgent {
  id        String       @id @default(uuid())
  tenantId  String       @map("tenant_id")
  tenant    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId  String       @map("client_id")
  client    Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId String       @map("contact_id")
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([clientId, contactId])
  @@index([tenantId])
  @@map("client_agent")
}

model Contact {
  id             String             @id @default(uuid())
  tenantId       String             @map("tenant_id")
  tenant         Organization       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId        String?
  owner          User?              @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  name           String
  email          String?
  phone          String?
  category       String             @default("Other")
  rating         Int?
  touchDate      DateTime?          @map("touch_date") @db.Date
  notes          String?
  // --- dual-person CRM fields ---
  personTitle    String?            @map("person_title")
  firstName      String?            @map("first_name")
  middleName     String?            @map("middle_name")
  lastName       String?            @map("last_name")
  jobTitle       String?            @map("job_title")
  company        String?
  website        String?
  workPhone      String?            @map("work_phone")
  fax            String?
  /// Secondary person (spouse/assistant): {title,first,middle,last,jobTitle,cell,workPhone,email}
  secondary      Json?
  /// Overflow contact points: {phones: string[], emails: string[]}
  extraContacts  Json?              @map("extra_contacts")
  categories     String[]           @default([])
  /// Relationship grade A-D; drives the auto-prospecting cadence.
  grade          String?
  /// When this contact is next due in the prospecting queue.
  nextTouchAt    DateTime?          @map("next_touch_at") @db.Date
  homeAddress    Json?              @map("home_address")
  workAddress    Json?              @map("work_address")
  referredById   String?            @map("referred_by_id")
  referredBy     Contact?           @relation("ContactReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals      Contact[]          @relation("ContactReferrals")
  referralSource String?            @map("referral_source")
  referralDate   DateTime?          @map("referral_date") @db.Date
  /// BUYER | SELLER | NONE
  leadType       String?            @map("lead_type")
  /// Buyer: {cultivating,location,range,income}; Seller: {cultivating,address,listPrice,netProceeds}
  leadDetails    Json?              @map("lead_details")
  /// {birthday:{m,d,y?}, birthdayAlt, weddingAnniversary, purchaseAnniversary}
  touchDates     Json?              @map("touch_dates")
  photoUrl       String?            @map("photo_url")
  /// {facebook, instagram, linkedin, x, youtube, other}
  socialLinks    Json?              @map("social_links")
  isSample       Boolean            @default(false)
  parties        TransactionParty[]
  contactNotes   ContactNote[]
  emails         Email[]
  tasks          Task[]
  credentials    VaultCredential[]
  agentOf        ClientAgent[]
  portalLinks    PortalLink[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([tenantId, category])
  @@index([tenantId, nextTouchAt])
  @@map("contact")
}

/// Transactional email with reply capture. Outbound goes through Resend from
/// the tenant's identity on the shared mail domain; each message carries a
/// per-thread reply token, and inbound replies post back via webhook and
/// attach here. This IS the mailbox — storage is rows + document attachments.
enum EmailDirection {
  OUTBOUND
  INBOUND
}

/// Reply-token → tenant mapping for the inbound webhook. Deliberately has NO
/// row-level security (same reasoning as portal_link): the webhook arrives
/// with no tenant context and the unguessable token IS the capability; the
/// email bodies themselves stay in the RLS-protected email table.
model EmailThread {
  token         String   @id
  tenantId      String   @map("tenant_id")
  transactionId String?  @map("transaction_id")
  contactId     String?  @map("contact_id")
  providerId    String?  @map("provider_id")
  createdAt     DateTime @default(now())

  @@index([providerId])
  @@map("email_thread")
}

model Email {
  id            String         @id @default(uuid())
  tenantId      String         @map("tenant_id")
  tenant        Organization   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId String?
  transaction   Transaction?   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  contactId     String?        @map("contact_id")
  contact       Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  direction     EmailDirection
  fromAddr      String         @map("from_addr")
  toAddr        String         @map("to_addr")
  subject       String
  bodyText      String         @map("body_text")
  /// Reply capture token; inbound mail to reply+<token>@ matches the thread.
  replyToken    String?        @map("reply_token")
  providerId    String?        @map("provider_id")
  status        String         @default("SENT")
  createdAt     DateTime       @default(now())

  @@index([tenantId, transactionId, createdAt])
  @@index([replyToken])
  @@map("email")
}

/// Notes a TC keeps about a client (the backend client page).
model ClientNote {
  id        String       @id @default(uuid())
  tenantId  String       @map("tenant_id")
  tenant    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId  String       @map("client_id")
  client    Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId  String?      @map("author_id")
  body      String
  createdAt DateTime     @default(now())

  @@index([tenantId, clientId, createdAt])
  @@map("client_note")
}

/// Timestamped CRM notes on a contact (the Notes tab + quick-add).
model ContactNote {
  id        String       @id @default(uuid())
  tenantId  String       @map("tenant_id")
  tenant    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId String       @map("contact_id")
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  authorId  String?      @map("author_id")
  body      String
  createdAt DateTime     @default(now())

  @@index([tenantId, contactId, createdAt])
  @@map("contact_note")
}

/// The central object: one closing. Belongs to a tenant, optionally to the
/// client (agent/brokerage) the tenant serves it for.
model Transaction {
  id                String                  @id @default(uuid())
  tenantId          String                  @map("tenant_id")
  tenant            Organization            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId          String?
  client            Client?                 @relation(fields: [clientId], references: [id], onDelete: SetNull)
  status            TransactionStatus       @default(UNDER_CONTRACT)
  side              TransactionSide         @default(BUY_SIDE)
  propertyAddress   String                  @map("property_address")
  city              String?
  state             String?
  zip               String?
  purchasePrice     Int?                    @map("purchase_price")
  listPrice         Int?                    @map("list_price")
  listDate          DateTime?               @map("list_date") @db.Date
  onMarketDate      DateTime?               @map("on_market_date") @db.Date
  expireDate        DateTime?               @map("expire_date") @db.Date
  mlsId             String?                 @map("mls_id")
  /// The co-agent is a Client (managed agent); workspace users are assigned
  /// through TransactionAssignee rows.
  coAgentClientId   String?                 @map("co_agent_client_id")
  assignees         TransactionAssignee[]
  /// Commission breakdown: {listPct, buyPct, note} — gross computes from price.
  payout            Json?
  emails            Email[]
  /// Contract-governed date changes awaiting an executed amendment:
  /// {closeDate?: "YYYY-MM-DD", contractDate?: "YYYY-MM-DD"}
  proposedDates     Json?                   @map("proposed_dates")
  contractDate      DateTime?               @map("contract_date") @db.Date
  closeDate         DateTime?               @map("close_date") @db.Date
  notes             String?
  customFields      Json?                   @map("custom_fields")
  isSample          Boolean                 @default(false)
  parties           TransactionParty[]
  tasks             Task[]
  documents         Document[]
  extractions       ContractExtraction[]
  envelopes         SignatureEnvelope[]
  portalLinks       PortalLink[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  invoices          Invoice[]
  intakeSubmissions IntakeSubmission[]
  compliance        TransactionCompliance[]

  @@index([tenantId, status])
  @@map("transaction")
}

// --- Stage 04: client portals + credential vault ---

/// Shareable read-only portal access to one transaction. The random token IS
/// the capability — portal pages are unauthenticated by design (TCs text
/// these links to buyers/sellers).
///
/// ⚠️ Deliberately NOT covered by row-level security: the public portal route
/// must resolve a bare token with no tenant context. The table carries only
/// the token, display toggles, and foreign keys; all transaction data is then
/// fetched through withTenant() using the link's own tenant id.
/// Who a portal link serves. CLIENT = buyer/seller simplified view of one
/// transaction; AGENT = the managed-agent portal, scoped to a Client record
/// and covering all of that client's transactions.
enum PortalAudience {
  CLIENT
  AGENT
}

model PortalLink {
  id             String         @id @default(uuid())
  tenantId       String         @map("tenant_id")
  tenant         Organization   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  audience       PortalAudience @default(CLIENT)
  transactionId  String?
  transaction    Transaction?   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  clientId       String?        @map("client_id")
  client         Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId      String?        @map("contact_id")
  contact        Contact?       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  token          String         @unique
  label          String
  showTasks      Boolean        @default(true) @map("show_tasks")
  showDocuments  Boolean        @default(false) @map("show_documents")
  showParties    Boolean        @default(true) @map("show_parties")
  showIntake     Boolean        @default(true) @map("show_intake")
  revokedAt      DateTime?      @map("revoked_at")
  lastAccessedAt DateTime?      @map("last_accessed_at")
  createdAt      DateTime       @default(now())

  @@index([tenantId])
  @@index([transactionId])
  @@map("portal_link")
}

/**
 * Public API keys. Like portal_link, this table deliberately has NO RLS
 * policy: the key hash IS the capability, and the API must look it up
 * before any tenant context exists. Only the SHA-256 hash is stored.
 */
model ApiKey {
  id         String       @id @default(uuid())
  tenantId   String       @map("tenant_id")
  tenant     Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  prefix     String
  hash       String       @unique
  createdAt  DateTime     @default(now())
  lastUsedAt DateTime?    @map("last_used_at")
  revokedAt  DateTime?    @map("revoked_at")

  @@index([tenantId])
  @@map("api_key")
}

model WebhookEndpoint {
  id        String       @id @default(uuid())
  tenantId  String       @map("tenant_id")
  tenant    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url       String
  secret    String
  events    String[]
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())

  @@index([tenantId])
  @@map("webhook_endpoint")
}

enum InvoiceStatus {
  SENT
  PAID
  VOID
}

/**
 * Client invoicing: the tenant bills their client through Stripe.
 */
/// A tenant billing their client. Payment-method-agnostic by design: clients
/// pay by check, Zelle, wire, or out of closing proceeds, so Freehold's job is
/// the document, the record, and the follow-up — never the payment rail. No
/// processor is involved; "paid" is whatever the tenant says it is.
model Invoice {
  id            String        @id @default(uuid())
  tenantId      String        @map("tenant_id")
  tenant        Organization  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId      String?
  client        Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  transactionId String?
  transaction   Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  /// Per-tenant sequence, rendered as INV-0001.
  number        Int
  /// Where this invoice actually lives: "freehold" (we are the record) or
  /// "erpnext" (created in the tenant's ERP; status mirrored from there).
  provider      String        @default("freehold")
  /// The Sales Invoice name in their ERPNext, e.g. ACC-SINV-2026-00007.
  externalId    String?       @map("external_id")
  description   String
  amountCents   Int           @map("amount_cents")
  /// How it's to be paid — "Due at closing", "Net 30", or free text.
  paymentTerms  String?       @map("payment_terms")
  dueDate       DateTime?     @map("due_date") @db.Date
  /// SENT means outstanding; issuing and emailing are separate facts.
  status        InvoiceStatus @default(SENT)
  /// When the invoice email actually went out.
  sentAt        DateTime?     @map("sent_at")
  /// How it was settled — "check #1042 at closing".
  paidNote      String?       @map("paid_note")
  /// The nag: an open task that closes only when the invoice is resolved.
  followUpTaskId String?      @map("follow_up_task_id")
  followUpTask   Task?        @relation(fields: [followUpTaskId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  paidAt        DateTime?     @map("paid_at")

  @@unique([tenantId, number])
  @@index([tenantId])
  @@map("invoice")
}

enum VaultAction {
  CREATED
  UPDATED
  REVEALED
  DELETED
}

/// Envelope-encrypted third-party credential (MLS, lender portals, e-sign accounts)
/// stored on a client's behalf. The secret never exists in plaintext at rest:
/// AES-256-GCM under a per-credential data key, itself wrapped by
/// VAULT_MASTER_KEY (see packages/vault). Reveals are audited — Freehold
/// stores and audits credentials; it never logs into anything automatically.
model VaultCredential {
  id         String           @id @default(uuid())
  tenantId   String           @map("tenant_id")
  tenant     Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId   String?
  client     Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  contactId  String?          @map("contact_id")
  contact    Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  system     String
  username   String
  url        String?
  notes      String?
  ciphertext String
  iv         String
  tag        String
  wrappedKey String           @map("wrapped_key")
  wrapIv     String           @map("wrap_iv")
  wrapTag    String           @map("wrap_tag")
  keyVersion Int              @default(1) @map("key_version")
  accessLogs VaultAccessLog[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([tenantId])
  @@map("vault_credential")
}

model AuditLog {
  id          String       @id @default(uuid())
  tenantId    String       @map("tenant_id")
  tenant      Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId     String?      @map("actor_id")
  actorEmail  String?      @map("actor_email")
  action      String
  subjectType String?      @map("subject_type")
  subjectId   String?      @map("subject_id")
  summary     String
  createdAt   DateTime     @default(now())

  @@index([tenantId, createdAt])
  @@map("audit_log")
}

model VaultAccessLog {
  id           String           @id @default(uuid())
  tenantId     String           @map("tenant_id")
  tenant       Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  credentialId String?
  credential   VaultCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  userId       String
  action       VaultAction
  detail       String?
  createdAt    DateTime         @default(now())

  @@index([tenantId, createdAt])
  @@map("vault_access_log")
}

model TransactionParty {
  id            String       @id @default(uuid())
  tenantId      String       @map("tenant_id")
  tenant        Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  contactId     String
  contact       Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  role          PartyRole
  createdAt     DateTime     @default(now())

  @@unique([transactionId, contactId, role])
  @@index([tenantId])
  @@map("transaction_party")
}

model Task {
  id              String       @id @default(uuid())
  tenantId        String       @map("tenant_id")
  tenant          Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId   String?
  transaction     Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  title           String
  notes           String?
  dueDate         DateTime?    @map("due_date") @db.Date
  status          TaskStatus   @default(OPEN)
  priority        TaskPriority @default(NORMAL)
  /// Provenance for domino recomputation: tasks instantiated from an action
  /// plan keep their anchor + offset so a confirmed date change re-dates them.
  anchor          DateAnchor?
  offsetDays      Int?         @map("offset_days")
  /// Manually re-dated tasks opt out of recomputation.
  dueDateEdited   Boolean      @default(false) @map("due_date_edited")
  /// Set when this task exists to get a date amendment executed ("closeDate"/"contractDate").
  proposedFor     String?      @map("proposed_for")
  /// Carried from the action-plan template task: default email template.
  emailTemplateId String?      @map("email_template_id")
  autoSendEmail   Boolean      @default(false) @map("auto_send_email")
  completedAt     DateTime?    @map("completed_at")
  contactId       String?      @map("contact_id")
  contact         Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  /// Per-audience portal visibility, toggled from the transaction screen.
  visibleToAgent  Boolean      @default(true) @map("visible_to_agent")
  visibleToClient Boolean      @default(true) @map("visible_to_client")
  assigneeId      String?
  assignee        User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  sortOrder       Int          @default(0) @map("sort_order")
  isSample        Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  invoiceFollowUps Invoice[]

  @@index([tenantId, status, dueDate])
  @@map("task")
}

/// Reusable checklist template ("Texas buy-side closing, 30 tasks").
model ActionPlan {
  id          String           @id @default(uuid())
  tenantId    String           @map("tenant_id")
  tenant      Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isSample    Boolean          @default(false)
  tasks       ActionPlanTask[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([tenantId])
  @@map("action_plan")
}

model ActionPlanTask {
  id              String       @id @default(uuid())
  tenantId        String       @map("tenant_id")
  tenant          Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actionPlanId    String
  actionPlan      ActionPlan   @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  title           String
  anchor          DateAnchor   @default(CLOSE_DATE)
  offsetDays      Int          @default(0) @map("offset_days")
  assigneeRole    String?      @map("assignee_role")
  /// Default email template: instantiated tasks open compose with it ready.
  emailTemplateId String?      @map("email_template_id")
  /// Auto-send the template to the client when the task is completed.
  autoSendEmail   Boolean      @default(false) @map("auto_send_email")
  sortOrder       Int          @default(0) @map("sort_order")

  @@index([tenantId])
  @@map("action_plan_task")
}

/// A named set of documents a transaction must carry to pass compliance
/// (standard compliance checklist). Distinct from ActionPlan, which produces
/// dated *tasks*; this defines required *documents*. Assigned per Client, so
/// every file for that client inherits the same rules.
model ComplianceChecklist {
  id          String                  @id @default(uuid())
  tenantId    String                  @map("tenant_id")
  tenant      Organization            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// How many levels of reviewer sign-off each document needs (1 = a single
  /// reviewer approves; 2+ = it climbs the ladder).
  approvalLevels Int                  @default(1) @map("approval_levels")
  isSample    Boolean                 @default(false)
  items       ComplianceItem[]
  clients     Client[]
  instances   TransactionCompliance[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([tenantId])
  @@map("compliance_checklist")
}

/// Overall state of one compliance round on a transaction.
enum ComplianceStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
}

/// State of a single required document within a compliance round.
enum ComplianceSlotStatus {
  MISSING
  ATTACHED
  SUBMITTED
  APPROVED
  RETURNED
}

/// A checklist instantiated onto one transaction — a snapshot taken when it was
/// applied, so later edits to the template never rewrite a file already under
/// review. A transaction can carry several rounds; the newest is current, which
/// is how a file gets a fresh checklist version part-way through.
model TransactionCompliance {
  id            String               @id @default(uuid())
  tenantId      String               @map("tenant_id")
  tenant        Organization         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId String               @map("transaction_id")
  transaction   Transaction          @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  /// Source template; null if the checklist was later deleted.
  checklistId   String?              @map("checklist_id")
  checklist     ComplianceChecklist? @relation(fields: [checklistId], references: [id], onDelete: SetNull)
  /// Snapshot of the checklist name at instantiation.
  checklistName String               @map("checklist_name")
  /// Snapshot of the checklist's approval-levels setting at instantiation.
  approvalLevels Int                 @default(1) @map("approval_levels")
  version       Int                  @default(1)
  isCurrent     Boolean              @default(true) @map("is_current")
  status        ComplianceStatus     @default(DRAFT)
  submittedAt   DateTime?            @map("submitted_at")
  submittedById String?              @map("submitted_by_id")
  reviewedAt    DateTime?            @map("reviewed_at")
  reviewedById  String?              @map("reviewed_by_id")
  slots         ComplianceSlot[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([tenantId])
  @@index([transactionId])
  @@map("transaction_compliance")
}

/// One required document within a compliance round: which file satisfies it and
/// where it stands in review.
model ComplianceSlot {
  id           String                @id @default(uuid())
  tenantId     String                @map("tenant_id")
  tenant       Organization          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  complianceId String                @map("compliance_id")
  compliance   TransactionCompliance @relation(fields: [complianceId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  required     Boolean               @default(true)
  sortOrder    Int                   @default(0) @map("sort_order")
  /// The document satisfying this slot; cleared if that document is deleted.
  documentId   String?               @map("document_id")
  document     Document?             @relation(fields: [documentId], references: [id], onDelete: SetNull)
  status       ComplianceSlotStatus  @default(MISSING)
  /// Highest review level that has signed off so far. APPROVED only once it
  /// reaches the round's approvalLevels; reset by a return or a file swap.
  approvedTier Int                   @default(0) @map("approved_tier")
  /// Why a reviewer sent it back.
  reviewNote   String?               @map("review_note")
  reviewedAt   DateTime?             @map("reviewed_at")
  reviewedById String?               @map("reviewed_by_id")
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([tenantId])
  @@index([complianceId])
  @@map("compliance_slot")
}

/// Lifecycle of one workspace covering files for another.
enum EngagementStatus {
  REQUESTED
  ACTIVE
  DECLINED
  ENDED
}

/// One workspace contracting another to cover files — vacation, overflow, a
/// specialty they don't handle. Found through the directory.
///
/// The vendor's chosen person joins the hiring workspace as a `guest` Member:
/// a real, revocable membership that sees only the transactions they are
/// assigned to. Nothing is copied between workspaces and no data is synced —
/// the file never leaves the workspace that owns it.
model Engagement {
  id             String           @id @default(uuid())
  /// The workspace that needs the coverage and owns the files.
  tenantId       String           @map("tenant_id")
  tenant         Organization     @relation("EngagementHirer", fields: [tenantId], references: [id], onDelete: Cascade)
  /// The workspace providing it.
  vendorTenantId String           @map("vendor_tenant_id")
  vendorTenant   Organization     @relation("EngagementVendor", fields: [vendorTenantId], references: [id], onDelete: Cascade)
  status         EngagementStatus @default(REQUESTED)
  /// What the hiring workspace is asking for.
  note           String?
  /// The vendor user given guest access, chosen when they accept.
  guestUserId    String?          @map("guest_user_id")
  guestUser      User?            @relation(fields: [guestUserId], references: [id], onDelete: SetNull)
  requestedById  String?          @map("requested_by_id")
  respondedAt    DateTime?        @map("responded_at")
  endedAt        DateTime?        @map("ended_at")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([tenantId])
  @@index([vendorTenantId])
  @@map("engagement")
}

/// Where a user's pay request stands. Freehold tracks what is owed and
/// produces the statement; the money itself moves however the business
/// already pays people.
enum PaymentRequestStatus {
  REQUESTED
  PAID
}

/// A user asking to be paid for work already assigned to them. The tenant
/// sets a fee per assignment; the user submits the ones that are due (company
/// policy decides whether that's at order time or at closing — Freehold
/// doesn't impose either). The itemized request is the statement.
model PaymentRequest {
  id          String               @id @default(uuid())
  tenantId    String               @map("tenant_id")
  tenant      Organization         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String               @map("user_id")
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      PaymentRequestStatus @default(REQUESTED)
  /// What the requester wants the payer to know.
  note        String?
  requestedAt DateTime             @default(now()) @map("requested_at")
  paidAt      DateTime?            @map("paid_at")
  paidById    String?              @map("paid_by_id")
  /// How it was settled — "check #1042", "ACH 7/22".
  paidNote    String?              @map("paid_note")
  items       PaymentRequestItem[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([tenantId])
  @@index([tenantId, userId])
  @@map("payment_request")
}

/// One transaction on a pay request. Address and fee are snapshotted so a
/// statement still reads correctly after the assignment is removed or its fee
/// changes. The unique assignee_id is what stops the same work being billed
/// twice — enforced by the database, not by a check that could be raced.
model PaymentRequestItem {
  id            String               @id @default(uuid())
  tenantId      String               @map("tenant_id")
  tenant        Organization         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestId     String               @map("request_id")
  request       PaymentRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  assigneeId    String?              @unique @map("assignee_id")
  assignee      TransactionAssignee? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  /// Snapshot, for linking back when the assignment still exists.
  transactionId String?              @map("transaction_id")
  address       String
  feeCents      Int                  @map("fee_cents")
  createdAt     DateTime             @default(now())

  @@index([tenantId])
  @@index([requestId])
  @@map("payment_request_item")
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

/// A trouble ticket filed from inside the dashboard — the sidebar widget on
/// every tenant page (not the portal sites) captures the page it was opened
/// from, so an operator knows what the person was looking at without asking.
model SupportTicket {
  id        String               @id @default(uuid())
  tenantId  String               @map("tenant_id")
  tenant    Organization         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String               @map("user_id")
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Auto-derived from the body (first ~60 chars) — the form is one textarea,
  /// on purpose, so filing a ticket is never more than "type and send".
  subject   String
  body      String
  /// Raw pathname the widget was opened from, e.g. /dashboard/transactions/abc123.
  pagePath  String?              @map("page_path")
  status    TicketStatus         @default(OPEN)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  replies   SupportTicketReply[]

  @@index([tenantId, status])
  @@map("support_ticket")
}

/// One message in a ticket's thread — from the tenant who filed it, another
/// member of their workspace, or the operator. Operator replies aren't tied to
/// a User row in the tenant (an operator isn't necessarily a Member of every
/// workspace they support), so the author is recorded as plain text.
model SupportTicketReply {
  id           String        @id @default(uuid())
  tenantId     String        @map("tenant_id")
  tenant       Organization  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketId     String        @map("ticket_id")
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  body         String
  fromOperator Boolean       @default(false) @map("from_operator")
  authorEmail  String        @map("author_email")
  createdAt    DateTime      @default(now())

  @@index([tenantId, ticketId])
  @@map("support_ticket_reply")
}

/// A state the workspace operates in, and whether it requires a licensed
/// coordinator on every file. Freehold ships no built-in list of which states
/// require licensing — that's a legal judgment each business makes for itself.
/// Also the coverage list a tenant advertises in the vendor directory.
model TenantState {
  id              String       @id @default(uuid())
  tenantId        String       @map("tenant_id")
  tenant          Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Two-letter state code, uppercased.
  state           String
  licenseRequired Boolean      @default(false) @map("license_required")
  createdAt       DateTime     @default(now())

  @@unique([tenantId, state])
  @@index([tenantId])
  @@map("tenant_state")
}

/// A workspace user working a transaction. Any number per file, each with a
/// free-text role ("Lead TC", "Support") and — later — the fee the tenant
/// pays them for it. Replaced the old fixed tc1/tc2 slots.
model TransactionAssignee {
  id            String       @id @default(uuid())
  tenantId      String       @map("tenant_id")
  tenant        Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId String       @map("transaction_id")
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  userId        String       @map("user_id")
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleLabel     String?      @map("role_label")
  /// What the tenant pays this user for this file, in cents. Admin-set; the
  /// user submits it through a PaymentRequest when it's due.
  feeCents      Int?         @map("fee_cents")
  /// Set once this assignment has been put on a pay request.
  paymentItem   PaymentRequestItem?
  createdAt     DateTime     @default(now())

  @@unique([transactionId, userId])
  @@index([tenantId])
  @@index([tenantId, userId])
  @@map("transaction_assignee")
}

/// A professional license a workspace user holds — some states require
/// licensed transaction coordinators. One row per state (a user licensed in
/// several states has several rows), stored per tenant: each workspace keeps
/// its own records for its own people. Always "license" in code and UI —
/// "credential" is the Vault's word for stored passwords.
model UserLicense {
  id              String       @id @default(uuid())
  tenantId        String       @map("tenant_id")
  tenant          Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId          String       @map("user_id")
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Two-letter state code, uppercased.
  state           String
  licenseNumber   String?      @map("license_number")
  /// What kind of license — "Salesperson", "Broker", "TC certification".
  label           String?
  /// Blank = no expiry on record. An expired license never satisfies a
  /// licensed-state check.
  expiresAt       DateTime?    @map("expires_at") @db.Date
  /// Uploaded copy of the license, via the storage abstraction (same fields
  /// as Document: inline bytes for DB, key for S3/tenant buckets).
  filename        String?
  contentType     String?      @map("content_type")
  sizeBytes       Int?         @map("size_bytes")
  data            Bytes?
  storageKey      String?      @map("storage_key")
  storageProvider String?      @map("storage_provider")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([tenantId])
  @@index([tenantId, userId])
  @@map("user_license")
}

/// One required document on a compliance checklist.
model ComplianceItem {
  id          String              @id @default(uuid())
  tenantId    String              @map("tenant_id")
  tenant      Organization        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  checklistId String              @map("checklist_id")
  checklist   ComplianceChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// Optional items are tracked but never block a file from passing.
  required    Boolean             @default(true)
  sortOrder   Int                 @default(0) @map("sort_order")
  createdAt   DateTime            @default(now())

  @@index([tenantId])
  @@index([checklistId])
  @@map("compliance_item")
}

// --- Stage 02: documents + AI contract extraction ---

enum ExtractionStatus {
  RUNNING
  READY
  APPLIED
  FAILED
}

enum FieldConfidence {
  HIGH
  MEDIUM
  LOW
}

enum FieldTarget {
  TRANSACTION_FIELD
  TASK
  CUSTOM_FIELD
}

enum FieldValueType {
  TEXT
  DATE
  MONEY
}

/// Uploaded or generated file attached to a transaction. Bytes live either in
/// object storage (`storageKey`, when STORAGE_ENDPOINT is configured) or
/// inline in Postgres (`data`, the zero-config default). Exactly one of the
/// two is set. Capped at upload time (10 MB).
model Document {
  id              String               @id @default(uuid())
  tenantId        String               @map("tenant_id")
  tenant          Organization         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId   String
  transaction     Transaction          @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  filename        String
  contentType     String               @map("content_type")
  sizeBytes       Int                  @map("size_bytes")
  data            Bytes?
  storageKey      String?              @map("storage_key")
  /// Which driver holds the bytes: DB | S3 (platform) | TENANT_S3. Null on rows
  /// predating per-tenant storage — reads infer from data/storageKey then.
  storageProvider String?              @map("storage_provider")
  visibleToAgent  Boolean              @default(true) @map("visible_to_agent")
  visibleToClient Boolean              @default(true) @map("visible_to_client")
  /// Versioning: replacing a file keeps the old one as a prior version. The new
  /// row is current (isCurrent), version+1, and replacesId points at the file it
  /// superseded. Lists show only current rows; the chain is the version history.
  version         Int                  @default(1)
  isCurrent       Boolean              @default(true) @map("is_current")
  replacesId      String?              @map("replaces_id")
  extractions     ContractExtraction[]
  envelopes       SignatureEnvelope[]
  complianceSlots ComplianceSlot[]
  createdAt       DateTime             @default(now())

  @@index([tenantId])
  @@index([transactionId])
  @@index([replacesId])
  @@map("document")
}

/// One AI extraction run over a document. Nothing an extraction finds touches
/// the transaction until a human applies it field-by-field.
model ContractExtraction {
  id            String            @id @default(uuid())
  tenantId      String            @map("tenant_id")
  tenant        Organization      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentId    String
  document      Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction       @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  status        ExtractionStatus  @default(RUNNING)
  model         String
  error         String?
  fields        ExtractionField[]
  createdAt     DateTime          @default(now())

  @@index([tenantId])
  @@index([transactionId])
  @@map("contract_extraction")
}

// --- Stage 03: document templates + e-signature envelopes ---

enum EsignProvider {
  MANUAL
  DOCUMENSO
  DOCUSIGN
}

enum EnvelopeStatus {
  DRAFT
  SENT
  COMPLETED
  DECLINED
  ERROR
}

/// Reusable merge-field document template. Body is plain text with
/// {{merge.fields}}; rendering produces a PDF attached to a transaction.
/// Reusable outbound email templates with merge fields, selectable from
/// any transaction's compose (and from task rows). Distinct from the two
/// automated lifecycle templates on the organization row.
model EmailTemplate {
  id          String       @id @default(uuid())
  tenantId    String       @map("tenant_id")
  tenant      Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  subject     String
  body        String
  /// STATUS | INTRO | PORTAL | MILESTONE | LISTING | POST_CLOSE | OTHER
  category    String       @default("OTHER")
  /// Comma-separated keywords matched against task titles to suggest this
  /// template when emailing from a task (e.g. "inspection" or "earnest,emd").
  taskMatch   String?      @map("task_match")
  /// Comma-separated keywords: transaction documents whose filename matches
  /// get pre-checked as attachments when this template is selected.
  attachMatch String?      @map("attach_match")
  /// Times this template has been used to send an email.
  usageCount  Int          @default(0) @map("usage_count")
  isSample    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([tenantId])
  @@map("email_template")
}

/// Operator analytics: every Checkout session we start, completed or not.
/// Platform-level table (no RLS) — read only from the /admin panel.
model CheckoutAttempt {
  id          String    @id // Stripe checkout session id
  tenantId    String    @map("tenant_id")
  email       String
  tier        String
  createdAt   DateTime  @default(now())
  completedAt DateTime? @map("completed_at")
  expiredAt   DateTime? @map("expired_at")
  recoveryUrl String?   @map("recovery_url")

  @@index([createdAt])
  @@map("checkout_attempt")
}

/// Redeemable complimentary-plan code. Platform-level (no RLS): operators mint
/// codes in /admin, tenants redeem them on the billing page for a full plan with
/// no Stripe checkout or charge. Redemption sets org.compTier + compExpiresAt.
model CompCode {
  id             String    @id @default(uuid())
  code           String    @unique
  /// The plan this code grants (PRO or BUSINESS).
  tier           PlanTier
  /// How long the comp lasts once redeemed, in months; null = no expiry.
  durationMonths Int?      @map("duration_months")
  /// Redemption deadline for the code itself; null = never expires.
  expiresAt      DateTime? @map("expires_at")
  maxRedemptions Int       @default(1) @map("max_redemptions")
  timesRedeemed  Int       @default(0) @map("times_redeemed")
  note           String?
  createdAt      DateTime  @default(now())

  @@map("comp_code")
}

/// Scheduled/queued outgoing email. NO RLS on purpose: the hourly cron
/// flushes due rows across tenants (CRON_SECRET-guarded route); rows are
/// created only by tenant-scoped actions that stamp tenantId themselves.
model EmailOutbox {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  transactionId String?   @map("transaction_id")
  toAddr        String    @map("to_addr")
  subject       String
  body          String
  sendAt        DateTime  @map("send_at")
  sentAt        DateTime? @map("sent_at")
  canceledAt    DateTime? @map("canceled_at")
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now())

  @@index([sendAt, sentAt])
  @@map("email_outbox")
}

model DocTemplate {
  id          String       @id @default(uuid())
  tenantId    String       @map("tenant_id")
  tenant      Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  body        String
  isSample    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([tenantId])
  @@map("doc_template")
}

/// One signature request for a document, through whichever provider the
/// client (or tenant default) uses. Provider adapters live in
/// packages/integrations; MANUAL tracks signatures collected outside any
/// e-sign service (wet ink, provider portals we don't yet integrate).
model SignatureEnvelope {
  id            String         @id @default(uuid())
  tenantId      String         @map("tenant_id")
  tenant        Organization   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentId    String
  document      Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  provider      EsignProvider
  externalId    String?        @map("external_id")
  status        EnvelopeStatus @default(DRAFT)
  signers       Json
  error         String?
  sentAt        DateTime?      @map("sent_at")
  completedAt   DateTime?      @map("completed_at")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tenantId])
  @@index([transactionId])
  @@map("signature_envelope")
}

/// A single extracted value with its provenance: page number, verbatim quote,
/// and the model's confidence. `target` says where applying it lands —
/// a transaction column, a dated task, or a custom field.
model ExtractionField {
  id           String             @id @default(uuid())
  tenantId     String             @map("tenant_id")
  tenant       Organization       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  extractionId String
  extraction   ContractExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  key          String
  label        String
  value        String
  valueType    FieldValueType     @default(TEXT) @map("value_type")
  page         Int?
  quote        String?
  confidence   FieldConfidence    @default(MEDIUM)
  target       FieldTarget        @default(CUSTOM_FIELD)
  applied      Boolean            @default(false)
  sortOrder    Int                @default(0) @map("sort_order")

  @@index([tenantId])
  @@index([extractionId])
  @@map("extraction_field")
}
