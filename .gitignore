# dependencies
node_modules/
.pnpm-store/

# build output
.next/
dist/
build/
.turbo/

# Generated by Next.js, and rewritten by whichever of dev/build ran last
# (`.next/dev/types` vs `.next/types`), so it churned in every commit.
# Safe to ignore because the part the type-check actually needs — the
# references that allow `import … from "*.jpg"` — is committed separately in
# apps/web/types/next.d.ts. Don't delete that file expecting this one to
# cover for it; on a fresh clone this one doesn't exist yet.
apps/web/next-env.d.ts

# env
.env
.env.local
.env.*.local

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editor / os
.DS_Store
.vscode/
.idea/

# testing
coverage/

# Claude Code local tooling (skills, settings, launch config) — dev-only, not product code
.claude/

# Local-only agent instructions, skills, and internal project notes.
# Never re-track these — purged from history on 2026-08-04 because they were
# tracked before this repo went public. CLAUDE.md in particular carries
# internal architecture, infra, and business detail that doesn't belong in a
# public repo. Removed with git-filter-repo + force-push on main and preview;
# see the backup bundle in "TC Website Backups/" if any of this ever needs
# recovering.
CLAUDE.md
.agents/
skills/
skills-lock.json

# ee/ is deliberately excluded from this public repo — see ee/README.md.
# It is a real pnpm workspace member ("ee" in pnpm-workspace.yaml) and stays
# on disk for local Freehold Cloud billing development; it is just never
# versioned in git here. Purged from history alongside the paths above.
ee/

# typescript incremental
*.tsbuildinfo

# dev-only Documenso signing cert
db/documenso/cert.p12

# Vercel
.vercel

# DocuSign RSA key drop-file (converted into .env, then deleted)
docusign_private.key

# personal credential stashes never belong in the repo
.site2FA
*.backup-codes*

# launch post drafts — local-only, not for the public repo
docs/launch/

# internal build plan + to-do list — local-only, not for the public repo
docs/PLAN.md
docs/plan.html
docs/TODO.md

# Python (voice agent)
.venv/
__pycache__/
*.pyc
services/voice-agent/secrets.env
