{
  "name": "freehold",
  "private": true,
  "version": "0.0.0",
  "license": "Elastic-2.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @freehold/db generate",
    "db:migrate": "pnpm --filter @freehold/db migrate:dev",
    "db:deploy": "pnpm --filter @freehold/db migrate:deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "pg": "^8.22.0",
    "turbo": "^2.10.5",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23",
      "sharp": ">=0.35.0",
      "fast-uri@>=3.0.0 <4.0.0": ">=3.1.5 <4.0.0",
      "fast-uri@>=4.0.0": ">=4.1.2",
      "find-my-way": ">=9.7.0"
    }
  }
}
