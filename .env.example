# Copy to .env and fill in for local development.
# Self-hosted Freehold is unlimited and needs no license key — providers are
# bring-your-own. Leave a provider blank and its feature is simply disabled.

# --- Database / queue ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/freehold
REDIS_URL=redis://localhost:6379

# --- Auth (required) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the web app (used for auth callbacks)
BETTER_AUTH_URL=http://localhost:3000

# --- OAuth sign-in (optional; leave blank to use email/password only) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Object storage (any S3-compatible endpoint; Stage 03) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=freehold-documents
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- AI (contract extraction, drafting) — bring your own Anthropic key ---
ANTHROPIC_API_KEY=

# --- Email (any SMTP provider) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# --- SMS (optional; bring your own Twilio or Vonage account) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
VONAGE_API_KEY=
VONAGE_API_SECRET=

# --- Credential vault (self-host master key; generate with: openssl rand -base64 32) ---
VAULT_MASTER_KEY=

# --- Payments (tenant→client invoicing via Stripe Connect) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Telemetry ---
# Set to "1" to disable the anonymized install ping (disclosed in README)
FREEHOLD_TELEMETRY_DISABLED=
