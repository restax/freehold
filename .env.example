# Copy to .env and fill in for local development.
# Self-hosted Freehold is unlimited and needs no license key — providers are
# bring-your-own. Leave a provider blank and its feature is simply disabled.

# --- Database / queue ---
# The app must connect as a NON-superuser role — Postgres row-level security
# (Freehold's tenant isolation) is silently bypassed for superusers.
# Migrations use the owner connection (MIGRATE_DATABASE_URL).
DATABASE_URL=postgresql://freehold_app:freehold_app@localhost:5432/freehold
MIGRATE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/freehold
REDIS_URL=redis://localhost:6379
# Managed-Postgres deploys only (e.g. Vercel + a marketplace Postgres): the
# pooled owner connection string, plus the freehold_app role's own password —
# the app swaps to that non-owner role at runtime. Leave both blank for a
# normal DATABASE_URL setup (Docker Compose, self-host).
STORAGE_DATABASE_URL=
FREEHOLD_APP_DB_PASSWORD=

# --- Auth (required) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the web app (used for auth callbacks)
BETTER_AUTH_URL=http://localhost:3000

# --- OAuth sign-in (optional; leave blank to use email/password only) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Object storage (any S3-compatible endpoint: MinIO, SeaweedFS, S3, R2) ---
# Leave blank to store document bytes in Postgres (zero-config default).
# The docker-compose bundle wires these to its bundled MinIO automatically.
STORAGE_ENDPOINT=
STORAGE_BUCKET=freehold-documents
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1

# --- E-signature ---
# Tenant default provider when a client has no preference: MANUAL | DOCUMENSO | DOCUSIGN
FREEHOLD_ESIGN_DEFAULT=MANUAL
# Documenso (self-hosted or cloud) — enables the DOCUMENSO provider when set
DOCUMENSO_URL=
DOCUMENSO_API_TOKEN=
# DocuSign (JWT grant) — enables the DOCUSIGN provider when all are set
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi
DOCUSIGN_OAUTH_BASE=https://account-d.docusign.com
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_PRIVATE_KEY=

# --- AI (contract extraction, drafting, chat) — bring your own Anthropic key ---
ANTHROPIC_API_KEY=
# Model overrides (optional; both default to claude-opus-4-8)
FREEHOLD_AI_MODEL=
FREEHOLD_CHAT_MODEL=

# --- Voice dictation on email compose (optional; bring your own Deepgram key) ---
DEEPGRAM_API_KEY=

# --- Email (Resend — https://resend.com; a free tier works for self-hosting) ---
# Leave all three blank to disable branded email sending + reply capture.
RESEND_API_KEY=
# The domain your workspace emails send from and the domain replies thread
# back through (can be the same domain, on different subdomains): both need
# an MX/SPF/DKIM record configured in Resend before sending will work.
EMAIL_FROM_DOMAIN=
EMAIL_REPLY_DOMAIN=
# Signing secret for Resend's inbound-email webhook (reply capture)
RESEND_WEBHOOK_SECRET=

# --- SMS (optional; bring your own Twilio or Vonage account) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
VONAGE_API_KEY=
VONAGE_API_SECRET=

# --- Credential vault (self-host master key; generate with: openssl rand -base64 32) ---
VAULT_MASTER_KEY=

# --- Payments (tenant→client invoicing via Stripe Connect) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Scheduled jobs (cron-guarded routes: demo reset, scheduled/quiet-hours email outbox) ---
# Bearer secret your cron caller sends; leave blank and these routes 401.
CRON_SECRET=

# --- Live demo workspace (optional; leave blank to disable entirely) ---
# Password for the shared read-only demo account. Setting this is what turns
# the demo on — self-hosters should leave it blank.
DEMO_USER_PASSWORD=

# --- Operator admin panel at /admin (optional; leave blank = panel 404s) ---
# Comma-separated emails allowed to view the cross-tenant operator panel.
PLATFORM_ADMIN_EMAILS=

# --- Operator alerts to Slack (optional) ---
SLACK_ADMIN_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_ADMIN_CHANNEL=

# --- Product analytics (optional) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Telemetry ---
# Set to "1" to disable the anonymized install ping (disclosed in README)
FREEHOLD_TELEMETRY_DISABLED=

# --- Freehold Cloud (ee/) ---
# Set to 1 only on the hosted cloud deployment; self-hosted installs are never limited.
FREEHOLD_CLOUD=
# Stripe billing (cloud only): secret key, webhook signing secret, per-seat monthly price ids
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
# Central hub feed for the dashboard news panel (optional)
FREEHOLD_HUB_URL=

# --- Coordinator directory (optional) ---
# Pull public listings into /dashboard/directory alongside Freehold workspaces.
# Unset = Freehold-enabled workspaces only. See docs/directory-api.md.
FINDTCPROS_FEED_URL=
FINDTCPROS_FEED_TOKEN=
# Require a bearer token on the outbound feed at /api/directory/feed.
# Unset = public read (it only ever contains listings workspaces opted into).
FREEHOLD_DIRECTORY_FEED_TOKEN=

# --- SkySlope (optional) ---
# Partner credentials identifying this Freehold install to SkySlope. Issued per
# licensee after an order form is signed — a self-hosted install needs its own
# pair. Without these, agent keys can be stored but not used.
SKYSLOPE_CLIENT_ID=
SKYSLOPE_CLIENT_SECRET=

# Voice search (optional) — talk to Claude about your data.
# Needs the agent worker in services/voice-agent running; see its README.
# LiveKit hosts the realtime audio session (livekit.io — free tier is plenty).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# ElevenLabs speaks the answers. DEEPGRAM_API_KEY above does the listening.
ELEVENLABS_API_KEY=
# Optional: which voice, and which Claude model the agent thinks with.
ELEVENLABS_VOICE_ID=
FREEHOLD_VOICE_MODEL=
